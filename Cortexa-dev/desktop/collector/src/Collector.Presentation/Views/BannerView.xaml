<UserControl x:Class="Collector.Presentation.Views.BannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Collector.Presentation.Behaviors"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:res="clr-namespace:Collector.Presentation.Resources"
             xmlns:vm="clr-namespace:Collector.Presentation.ViewModels"
             Focusable="False"
             IsTabStop="False">
    <UserControl.Resources>
        <Style x:Key="Banner.Surface" TargetType="Border">
            <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
            <Setter Property="Padding" Value="{StaticResource Thickness.BannerPadding}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Info.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Info}" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:BannerSeverity.Error}">
                    <Setter Property="Background" Value="{DynamicResource Brush.Danger.Surface}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                    <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:BannerSeverity.Warning}">
                    <Setter Property="Background" Value="{DynamicResource Brush.Warning.Surface}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:BannerSeverity.Success}">
                    <Setter Property="Background" Value="{DynamicResource Brush.Success.Surface}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Banner.Glyph" TargetType="TextBlock" BasedOn="{StaticResource Text.Glyph}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Info}" />
            <Setter Property="Margin" Value="{StaticResource Thickness.InlineGapLarge}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:BannerSeverity.Error}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:BannerSeverity.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:BannerSeverity.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Root"
            Style="{StaticResource Banner.Surface}"
            AutomationProperties.Name="{Binding AutomationName}"
            Focusable="True"
            KeyboardNavigation.IsTabStop="False"
            b:FocusRouter.Key="Banner"
            FocusVisualStyle="{x:Null}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource Banner.Glyph}" Text="{Binding Glyph}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource Text.Body}"
                           Text="{Binding Message}"
                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <Button Grid.Column="2"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{Binding ActionText, TargetNullValue={x:Static sys:String.Empty}}"
                    b:FocusRouter.Key="BannerAction"
                    Command="{Binding ActionCommand}"
                    Content="{Binding ActionText}"
                    Style="{StaticResource Button.Link}"
                    Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
            <Button Grid.Column="3"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{x:Static res:SignInStrings.DismissName}"
                    Command="{Binding DismissCommand}"
                    Content="{x:Static res:Glyphs.Close}"
                    Style="{StaticResource Button.Icon}"
                    Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Border>
</UserControl>
