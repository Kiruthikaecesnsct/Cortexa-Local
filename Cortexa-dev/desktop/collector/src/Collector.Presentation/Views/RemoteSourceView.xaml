<UserControl x:Class="Collector.Presentation.Views.RemoteSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Collector.Presentation.Behaviors"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:res="clr-namespace:Collector.Presentation.Resources"
             xmlns:vm="clr-namespace:Collector.Presentation.ViewModels"
             Focusable="False"
             IsTabStop="False">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadRepositoriesCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="Repository.Glyph" TargetType="TextBlock" BasedOn="{StaticResource Text.Glyph}">
            <Setter Property="Text" Value="{x:Static res:Glyphs.Repository}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPrivate}" Value="True">
                    <Setter Property="Text" Value="{x:Static res:Glyphs.Lock}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Repository.List" TargetType="ListBox" BasedOn="{StaticResource List.Master}">
            <Setter Property="AlternationCount" Value="10000" />
            <Setter Property="MaxHeight" Value="{StaticResource Size.RepoListMaxHeight}" />
        </Style>

        <Style x:Key="Repository.Surface" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        </Style>

        <Style x:Key="Repository.ListState" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="{StaticResource Thickness.CardPadding}" />
        </Style>

        <Style x:Key="Connection.Badge" TargetType="Border" BasedOn="{StaticResource Tag.Surface}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Info.Surface}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Info.Border}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Info}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Success.Surface}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success.Border}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Connection.Disconnect" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Connection.Sections" TargetType="UniformGrid">
            <Setter Property="Margin" Value="{StaticResource Thickness.GridBleed.Section}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Connection.Connect" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Content" Value="{x:Static res:RemoteSourceStrings.ConnectAndFind}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                    <Setter Property="Content" Value="{x:Static res:RemoteSourceStrings.StatusConnecting}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Reveal.Token" TargetType="ToggleButton" BasedOn="{StaticResource Button.Reveal}">
            <Setter Property="AutomationProperties.Name" Value="{x:Static res:RemoteSourceStrings.ShowTokenName}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="AutomationProperties.Name" Value="{x:Static res:RemoteSourceStrings.HideTokenName}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Reveal.Passphrase" TargetType="ToggleButton" BasedOn="{StaticResource Button.Reveal}">
            <Setter Property="AutomationProperties.Name" Value="{x:Static res:RemoteSourceStrings.ShowPassphraseName}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="AutomationProperties.Name" Value="{x:Static res:RemoteSourceStrings.HidePassphraseName}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Stepper.ItemButton" TargetType="Button" BasedOn="{StaticResource Stepper.Item}">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="AutomationProperties.Name">
                <Setter.Value>
                    <MultiBinding StringFormat="{}{0}, {1}">
                        <Binding Path="Title" />
                        <Binding Source="{x:Static res:RemoteSourceStrings.StepUpcomingState}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="AutomationProperties.Name">
                        <Setter.Value>
                            <MultiBinding StringFormat="{}{0}, {1}">
                                <Binding Path="Title" />
                                <Binding Source="{x:Static res:RemoteSourceStrings.StepCurrentState}" />
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter Property="IsEnabled" Value="True" />
                    <Setter Property="AutomationProperties.Name">
                        <Setter.Value>
                            <MultiBinding StringFormat="{}{0}, {1}">
                                <Binding Path="Title" />
                                <Binding Source="{x:Static res:RemoteSourceStrings.StepDoneState}" />
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDone}" Value="True" />
                        <Condition Binding="{Binding Number}" Value="2" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Command" Value="{Binding DataContext.ChangeRepositoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDone}" Value="True" />
                        <Condition Binding="{Binding Number}" Value="3" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Command" Value="{Binding DataContext.ChangeBranchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDone}" Value="True" />
                        <Condition Binding="{Binding Number}" Value="4" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Command" Value="{Binding DataContext.ChangeFilesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDone}" Value="True" />
                        <Condition Binding="{Binding Number}" Value="1" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsEnabled" Value="False" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Stepper.ConnectorLink" TargetType="Border" BasedOn="{StaticResource Stepper.Connector}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Number}" Value="5">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Repo.VisibilityBadge" TargetType="Border" BasedOn="{StaticResource Tag.Surface}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPrivate}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Warning.Surface}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning.Border}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Repo.Description" TargetType="TextBlock" BasedOn="{StaticResource Text.Helper}">
            <Setter Property="MinHeight" Value="{StaticResource Size.RepoDescription}" />
            <Setter Property="MaxHeight" Value="{StaticResource Size.RepoDescription}" />
            <Setter Property="Margin" Value="{StaticResource Thickness.StackGap}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.PageSubtitle}" />
            <Setter Property="Text" Value="{Binding Description}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasDescription}" Value="False">
                    <Setter Property="Text" Value="{x:Static res:RemoteSourceStrings.NoDescription}" />
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Repo.Meta" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="{StaticResource Thickness.InlineGapLarge}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="Repo.CardTemplate" DataType="{x:Type vm:RemoteRepositoryRowViewModel}">
            <Button AutomationProperties.HelpText="{Binding Description, TargetNullValue={x:Static sys:String.Empty}}"
                    AutomationProperties.Name="{Binding AutomationName}"
                    Click="OnRepositoryClick"
                    Style="{StaticResource RepoCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="{StaticResource Thickness.InlineGap}"
                                   Style="{StaticResource Text.Glyph}"
                                   Text="{x:Static res:Glyphs.Lock}"
                                   Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Column="1"
                                   Margin="{StaticResource Thickness.InlineGap}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Label}"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <Border Grid.Column="2"
                                Margin="{StaticResource Thickness.InlineGap}"
                                Style="{StaticResource Repo.VisibilityBadge}">
                            <TextBlock Style="{StaticResource Tag.Label}" Text="{Binding VisibilityText}" />
                        </Border>
                        <TextBlock Grid.Column="3" Style="{StaticResource Text.Glyph}" Text="{x:Static res:Glyphs.ChevronRight}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Style="{StaticResource Repo.Description}" />
                    <WrapPanel Grid.Row="2" VerticalAlignment="Bottom">
                        <StackPanel Margin="{StaticResource Thickness.InlineGapLarge}" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="{StaticResource Thickness.InlineGap}"
                                       Style="{StaticResource Text.Glyph}"
                                       Text="{x:Static res:Glyphs.Branch}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding DefaultBranch}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Repo.Meta}"
                                   Visibility="{Binding DataContext.IsAzure, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="{x:Static res:RemoteSourceStrings.ProjectPrefix}" /><Run Text="{Binding Repository.Project, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Repo.Meta}"
                                   Text="{Binding UpdatedText}"
                                   Visibility="{Binding ShowUpdatedBeforeSize, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource Repo.Meta}" Text="{Binding SizeText}" />
                        <TextBlock Style="{StaticResource Repo.Meta}"
                                   Text="{Binding UpdatedText}"
                                   Visibility="{Binding ShowUpdatedAfterSize, Converter={StaticResource BoolToVisibility}}" />
                        <Border Style="{StaticResource Tag.Surface.Danger}"
                                Visibility="{Binding IsTooBig, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Tag.Glyph}" Text="{x:Static res:Glyphs.Warning}" />
                                <TextBlock Style="{StaticResource Tag.Label}" Text="{Binding OverLimitTag}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="Branch.RowTemplate" DataType="{x:Type vm:BranchOptionViewModel}">
            <Button AutomationProperties.Name="{Binding AutomationName}"
                    Click="OnBranchClick"
                    Style="{StaticResource BranchRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Margin="{StaticResource Thickness.InlineGapLarge}"
                               Foreground="{DynamicResource Brush.Text.Link}"
                               Style="{StaticResource Text.Glyph}"
                               Text="{x:Static res:Glyphs.Branch}" />
                    <TextBlock Grid.Column="1"
                               Margin="{StaticResource Thickness.InlineGapLarge}"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="{StaticResource FontSize.MonoBody}"
                               Style="{StaticResource Text.Label}"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                        <Border Margin="{StaticResource Thickness.InlineGap}"
                                Style="{StaticResource Tag.Surface.Accent}"
                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Tag.Label}" Text="{x:Static res:RemoteSourceStrings.DefaultBadge}" />
                        </Border>
                        <Border Margin="{StaticResource Thickness.InlineGap}"
                                Style="{StaticResource Tag.Surface.Info}"
                                Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Tag.Glyph}" Text="{x:Static res:Glyphs.Lock}" />
                                <TextBlock Style="{StaticResource Tag.Label}" Text="{x:Static res:RemoteSourceStrings.ProtectedBadge}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="4"
                               Margin="{StaticResource Thickness.InlineGapLarge}"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="{StaticResource FontSize.MonoSmall}"
                               Style="{StaticResource Text.Caption}"
                               Text="{Binding ShortSha}"
                               Visibility="{Binding ShortSha, Converter={StaticResource NotEmptyToVisibility}}" />
                    <TextBlock Grid.Column="5" Style="{StaticResource Text.Glyph}" Text="{x:Static res:Glyphs.ChevronRight}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RemoteRepositoryRowViewModel}">
            <StackPanel>
                <Border Style="{StaticResource Divider}"
                        Visibility="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource NotZeroToVisibility}}" />
                <Grid MinHeight="{StaticResource Size.RowMin}" Margin="{StaticResource Thickness.RowPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Margin="{StaticResource Thickness.InlineGapLarge}"
                               Style="{StaticResource Repository.Glyph}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Label}"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap">
                            <Run Text="{Binding FullName, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run FontFamily="{StaticResource Font.Icon}" Text="{x:Static res:Glyphs.Branch}" />
                            <Run Text="{Binding DefaultBranch, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding SizeText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                        <Border Style="{StaticResource Tag.Surface}"
                                Visibility="{Binding HasUpstreamTag, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Tag.Label}" Text="{Binding UpstreamTag}" />
                        </Border>
                        <Border Style="{StaticResource Tag.Surface.Warning}"
                                Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Tag.Glyph}" Text="{x:Static res:Glyphs.Lock}" />
                                <TextBlock Style="{StaticResource Tag.Label}" Text="{x:Static res:RemoteSourceStrings.PrivateTag}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tag.Surface.Danger}"
                                Visibility="{Binding IsTooBig, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Tag.Glyph}" Text="{x:Static res:Glyphs.Warning}" />
                                <TextBlock Style="{StaticResource Tag.Label}" Text="{Binding OverLimitTag}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Segment.Visibility">
            <RadioButton Content="{Binding Label}"
                         GroupName="RepositoryVisibility"
                         IsChecked="{Binding IsSelected}"
                         Style="{StaticResource SegmentedToggle}" />
        </DataTemplate>

        <DataTemplate x:Key="Segment.Sort">
            <RadioButton Content="{Binding Label}"
                         GroupName="RepositorySort"
                         IsChecked="{Binding IsSelected}"
                         Style="{StaticResource SegmentedToggle}" />
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Border Margin="{StaticResource Thickness.StackGap}"
                Style="{StaticResource Card}"
                Visibility="{Binding ShowForm, Converter={StaticResource BoolToVisibility}}">
            <StackPanel IsEnabled="{Binding AreControlsEnabled}">
                <Grid Margin="{StaticResource Thickness.StackGapMedium}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <ContentControl Margin="{StaticResource Thickness.InlineGapLarge}" Content="{x:Static res:Glyphs.Repository}" Style="{StaticResource IconTile}" />
                        <TextBlock AutomationProperties.HeadingLevel="Level2"
                                   Style="{StaticResource Text.Subtitle}"
                                   Text="{x:Static res:RemoteSourceStrings.ConnectionTitle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsTokenSource, Converter={StaticResource BoolToVisibility}}">
                        <Border Margin="{StaticResource Thickness.InlineGapLarge}"
                                AutomationProperties.LiveSetting="Polite"
                                AutomationProperties.Name="{Binding StatusText}"
                                Style="{StaticResource Connection.Badge}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Tag.Glyph}"
                                           Text="{x:Static res:Glyphs.CheckMark}"
                                           Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Style="{StaticResource Tag.Label}" Text="{Binding StatusText}" />
                            </StackPanel>
                        </Border>
                        <Button AutomationProperties.Name="{x:Static res:RemoteSourceStrings.DisconnectName}"
                                Command="{Binding DisconnectCommand}"
                                Content="{x:Static res:RemoteSourceStrings.Disconnect}"
                                Style="{StaticResource Connection.Disconnect}" />
                    </StackPanel>
                </Grid>

                <StackPanel Visibility="{Binding IsTokenSource, Converter={StaticResource BoolToVisibility}}">
                    <Border Margin="{StaticResource Thickness.StackGapMedium}" Style="{StaticResource Stepper.Bar}">
                        <ItemsControl AutomationProperties.Name="{x:Static res:RemoteSourceStrings.StepperName}"
                                      Focusable="False"
                                      IsTabStop="False"
                                      ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WizardStepItemViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource Stepper.ItemButton}" />
                                        <Border Grid.Column="1" Style="{StaticResource Stepper.ConnectorLink}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Margin="{StaticResource Thickness.StackGapMedium}"
                            AutomationProperties.Name="{Binding StepPrompt}"
                            Style="{StaticResource StepPrompt}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StepPrompt.Bar}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource StepPrompt.Overline}" Text="{x:Static res:RemoteSourceStrings.PromptOverline}" />
                                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding StepPrompt}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                <Button Margin="{StaticResource Thickness.LeadingGap}"
                                        AutomationProperties.Name="{x:Static res:RemoteSourceStrings.ChangeRepository}"
                                        Command="{Binding ChangeRepositoryCommand}"
                                        Content="{x:Static res:RemoteSourceStrings.ChangeRepository}"
                                        Style="{StaticResource Button.Secondary}"
                                        Visibility="{Binding ShowChangeRepository, Converter={StaticResource BoolToVisibility}}" />
                                <Button Margin="{StaticResource Thickness.LeadingGap}"
                                        AutomationProperties.Name="{x:Static res:RemoteSourceStrings.ChangeBranch}"
                                        Command="{Binding ChangeBranchCommand}"
                                        Content="{x:Static res:RemoteSourceStrings.ChangeBranch}"
                                        Style="{StaticResource Button.Secondary}"
                                        Visibility="{Binding ShowChangeBranch, Converter={StaticResource BoolToVisibility}}" />
                                <Button Margin="{StaticResource Thickness.LeadingGap}"
                                        AutomationProperties.Name="{x:Static res:RemoteSourceStrings.ChangeFilesName}"
                                        Command="{Binding ChangeFilesCommand}"
                                        Content="{x:Static res:RemoteSourceStrings.ChangeFiles}"
                                        Style="{StaticResource Button.Secondary}"
                                        Visibility="{Binding ShowChangeFiles, Converter={StaticResource BoolToVisibility}}"
                                        b:FocusRouter.Key="ChangeFiles" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Margin="{StaticResource Thickness.StackGapMedium}" Visibility="{Binding IsListLoading, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Margin="{StaticResource Thickness.StackGap}"
                                     AutomationProperties.Name="{x:Static res:RemoteSourceStrings.LoadingRepositories}"
                                     Style="{StaticResource Progress.Thin}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:RemoteSourceStrings.ConnectingMessage}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowConnectStep, Converter={StaticResource BoolToVisibility}}">
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource Columns.Sections}}"
                                     Style="{StaticResource Connection.Sections}">
                            <HeaderedContentControl AutomationProperties.Name="{x:Static res:RemoteSourceStrings.OrganizationSectionTitle}"
                                                    Header="{x:Static res:RemoteSourceStrings.OrganizationSectionTitle}"
                                                    Style="{StaticResource NumberedSectionCard}"
                                                    Tag="1"
                                                    b:FieldState.Helper="{Binding OrgUrlHint}">
                                <HeaderedContentControl Header="{x:Static res:RemoteSourceStrings.OrganizationUrlLabel}"
                                                        Style="{StaticResource FormField}"
                                                        b:FieldState.Error="{Binding OrgUrlError}"
                                                        b:FieldState.Helper="{Binding OrgUrlPlaceholder}">
                                    <TextBox x:Name="OrganizationUrl"
                                             AutomationProperties.HelpText="{Binding OrgUrlError, TargetNullValue={x:Static sys:String.Empty}}"
                                             AutomationProperties.Name="{x:Static res:RemoteSourceStrings.OrganizationUrlName}"
                                             GotKeyboardFocus="OnOrganizationGotFocus"
                                             Style="{StaticResource TextBox.Field}"
                                             Text="{Binding OrgUrl, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding OrgUrlPlaceholder}"
                                             b:FieldState.HasError="{Binding OrgUrlError, Converter={StaticResource NotEmptyToBool}}"
                                             b:FocusRouter.Key="RemoteOrganization">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding ConnectCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </HeaderedContentControl>
                            </HeaderedContentControl>

                            <HeaderedContentControl AutomationProperties.Name="{x:Static res:RemoteSourceStrings.TokenSectionTitle}"
                                                    Header="{x:Static res:RemoteSourceStrings.TokenSectionTitle}"
                                                    Style="{StaticResource NumberedSectionCard}"
                                                    Tag="2"
                                                    b:FieldState.Helper="{Binding TokenHint}">
                                <StackPanel>
                                    <HeaderedContentControl Header="{x:Static res:RemoteSourceStrings.TokenLabel}"
                                                            Style="{StaticResource FormField}"
                                                            b:FieldState.Error="{Binding TokenError}">
                                        <Grid Focusable="True"
                                              FocusVisualStyle="{x:Null}"
                                              GotKeyboardFocus="OnFieldHostGotFocus"
                                              KeyboardNavigation.IsTabStop="False">
                                            <PasswordBox x:Name="TokenPassword"
                                                         AutomationProperties.HelpText="{Binding TokenError, TargetNullValue={x:Static sys:String.Empty}}"
                                                         AutomationProperties.Name="{x:Static res:RemoteSourceStrings.TokenName}"
                                                         PasswordChanged="OnTokenPasswordChanged"
                                                         Style="{StaticResource PasswordBox.Field.Trail}"
                                                         ToolTip="{Binding TokenPlaceholder}"
                                                         Visibility="{Binding IsTokenVisible, Converter={StaticResource InverseBoolToVisibility}}"
                                                         b:FieldState.HasError="{Binding TokenError, Converter={StaticResource NotEmptyToBool}}"
                                                         b:FocusRouter.Key="RemoteToken">
                                                <PasswordBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding ConnectCommand}" />
                                                </PasswordBox.InputBindings>
                                            </PasswordBox>
                                            <TextBox x:Name="TokenText"
                                                     AutomationProperties.HelpText="{Binding TokenError, TargetNullValue={x:Static sys:String.Empty}}"
                                                     AutomationProperties.Name="{x:Static res:RemoteSourceStrings.TokenName}"
                                                     IsUndoEnabled="False"
                                                     Style="{StaticResource TextBox.Field.Trail}"
                                                     TextChanged="OnTokenTextChanged"
                                                     ToolTip="{Binding TokenPlaceholder}"
                                                     Visibility="{Binding IsTokenVisible, Converter={StaticResource BoolToVisibility}}"
                                                     b:FieldState.HasError="{Binding TokenError, Converter={StaticResource NotEmptyToBool}}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding ConnectCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <ToggleButton x:Name="TokenReveal"
                                                          Click="OnTokenRevealClick"
                                                          IsChecked="{Binding IsTokenVisible}"
                                                          Style="{StaticResource Reveal.Token}" />
                                        </Grid>
                                    </HeaderedContentControl>
                                    <Button HorizontalAlignment="Left"
                                            AutomationProperties.Name="{Binding TokenLinkText}"
                                            Command="{Binding OpenTokenPageCommand}"
                                            Style="{StaticResource Button.Link}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="{StaticResource Thickness.InlineGap}"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding TokenLinkText}" />
                                            <TextBlock Style="{StaticResource Text.Glyph}"
                                                       Foreground="{DynamicResource Brush.Text.Link}"
                                                       Text="{x:Static res:Glyphs.OpenInNewWindow}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </HeaderedContentControl>
                        </UniformGrid>
                        <Button Margin="{StaticResource Thickness.ActionTop}"
                                AutomationProperties.Name="{x:Static res:RemoteSourceStrings.ConnectAndFindName}"
                                Command="{Binding ConnectCommand}"
                                Style="{StaticResource Connection.Connect}" />
                    </StackPanel>

                    <StackPanel x:Name="RepositoryStep"
                                IsVisibleChanged="OnRepositoryStepVisibleChanged"
                                Visibility="{Binding ShowRepositoryStep, Converter={StaticResource BoolToVisibility}}">
                        <Grid Visibility="{Binding HasRepositories, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="{StaticResource Size.ComboMin}" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <HeaderedContentControl Grid.Column="0"
                                                    VerticalAlignment="Bottom"
                                                    Header="{x:Static res:RemoteSourceStrings.SearchLabel}"
                                                    Style="{StaticResource FormField}">
                                <Grid>
                                    <TextBox x:Name="RepositorySearch"
                                             Padding="{StaticResource Thickness.SearchPadding}"
                                             AutomationProperties.Name="{x:Static res:RemoteSourceStrings.SearchName}"
                                             Style="{StaticResource TextBox.Field}"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{x:Static res:RemoteSourceStrings.SearchPlaceholder}"
                                             b:FocusRouter.Key="RemoteSearch" />
                                    <TextBlock Margin="{StaticResource Thickness.SearchGlyph}"
                                               HorizontalAlignment="Right"
                                               IsHitTestVisible="False"
                                               Style="{StaticResource Text.Glyph}"
                                               Text="{x:Static res:Glyphs.Search}" />
                                </Grid>
                            </HeaderedContentControl>
                            <HeaderedContentControl Grid.Column="1"
                                                    Margin="{StaticResource Thickness.FieldAdjacent}"
                                                    VerticalAlignment="Bottom"
                                                    Header="{x:Static res:RemoteSourceStrings.ProjectLabel}"
                                                    Style="{StaticResource FormField}"
                                                    Visibility="{Binding ShowProjectFilter, Converter={StaticResource BoolToVisibility}}">
                                <ComboBox Width="{StaticResource Size.ProjectFilter}"
                                          AutomationProperties.Name="{x:Static res:RemoteSourceStrings.ProjectName}"
                                          ItemsSource="{Binding ProjectOptions}"
                                          SelectedItem="{Binding SelectedProjectOption}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ProjectOption}">
                                            <TextBlock Text="{Binding Label}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </HeaderedContentControl>
                            <StackPanel Grid.Column="1"
                                        Margin="{StaticResource Thickness.FieldAdjacent}"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding ShowVisibilityFilter, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Margin="{StaticResource Thickness.LabelPadding}"
                                           Style="{StaticResource Text.Label}"
                                           Text="{x:Static res:RemoteSourceStrings.VisibilityLabel}" />
                                <Border Style="{StaticResource SegmentedToggle.Track}">
                                    <ItemsControl AutomationProperties.Name="{x:Static res:RemoteSourceStrings.VisibilityLabel}"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  ItemTemplate="{StaticResource Segment.Visibility}"
                                                  ItemsSource="{Binding VisibilityOptions}"
                                                  KeyboardNavigation.DirectionalNavigation="Cycle"
                                                  KeyboardNavigation.TabNavigation="Once">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Margin="{StaticResource Thickness.FieldAdjacent}"
                                        VerticalAlignment="Bottom">
                                <TextBlock Margin="{StaticResource Thickness.LabelPadding}"
                                           Style="{StaticResource Text.Label}"
                                           Text="{x:Static res:RemoteSourceStrings.SortLabel}" />
                                <Border Style="{StaticResource SegmentedToggle.Track}">
                                    <ItemsControl AutomationProperties.Name="{x:Static res:RemoteSourceStrings.SortLabel}"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  ItemTemplate="{StaticResource Segment.Sort}"
                                                  ItemsSource="{Binding SortOptions}"
                                                  KeyboardNavigation.DirectionalNavigation="Cycle"
                                                  KeyboardNavigation.TabNavigation="Once">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="3"
                                    Margin="{StaticResource Thickness.FieldAdjacent}"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.Name="{x:Static res:RemoteSourceStrings.Reload}"
                                    Command="{Binding LoadRepositoriesCommand}"
                                    Content="{x:Static res:Glyphs.Refresh}"
                                    Style="{StaticResource Button.Icon}"
                                    ToolTip="{x:Static res:RemoteSourceStrings.Reload}" />
                        </Grid>

                        <TextBlock Margin="{StaticResource Thickness.StackGap}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Style="{StaticResource Text.Caption}"
                                   Text="{Binding ShowingText}"
                                   Visibility="{Binding HasRepositories, Converter={StaticResource BoolToVisibility}}" />

                        <Border Style="{StaticResource Repository.Surface}"
                                Visibility="{Binding ShowEmptyList, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Style="{StaticResource Repository.ListState}">
                                <ContentControl Content="{x:Static res:Glyphs.Repository}" Style="{StaticResource EmptyIcon.Small}" />
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource Text.Label}"
                                           Text="{x:Static res:RemoteSourceStrings.EmptyTitle}" />
                                <TextBlock Margin="{StaticResource Thickness.StackGap}"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource Text.Helper}"
                                           Text="{Binding EmptyText}"
                                           TextAlignment="Center" />
                                <Button HorizontalAlignment="Center"
                                        AutomationProperties.Name="{x:Static res:RemoteSourceStrings.ConnectAgain}"
                                        Command="{Binding DisconnectCommand}"
                                        Content="{x:Static res:RemoteSourceStrings.ConnectAgain}"
                                        Style="{StaticResource Button.Secondary}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Repository.Surface}"
                                Visibility="{Binding ShowNoMatch, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Style="{StaticResource Repository.ListState}">
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource Text.Helper}"
                                           AutomationProperties.LiveSetting="Polite"
                                           Text="{Binding NoMatchText}" />
                                <Button HorizontalAlignment="Center"
                                        AutomationProperties.Name="{Binding ClearActionName}"
                                        Command="{Binding ClearFiltersCommand}"
                                        Content="{Binding ClearActionLabel}"
                                        Style="{StaticResource Button.Link}" />
                            </StackPanel>
                        </Border>

                        <ItemsControl Margin="{StaticResource Thickness.GridBleed.Repo}"
                                      AutomationProperties.Name="{x:Static res:RemoteSourceStrings.RepositoriesName}"
                                      Focusable="False"
                                      IsTabStop="False"
                                      ItemTemplate="{StaticResource Repo.CardTemplate}"
                                      ItemsSource="{Binding Repositories}"
                                      KeyboardNavigation.DirectionalNavigation="Contained"
                                      KeyboardNavigation.TabNavigation="Once"
                                      Visibility="{Binding ShowRepositoryList, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Columns.RepoCards}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="BranchStep"
                                IsVisibleChanged="OnBranchStepVisibleChanged"
                                Visibility="{Binding ShowBranchStep, Converter={StaticResource BoolToVisibility}}">
                        <HeaderedContentControl Header="{x:Static res:RemoteSourceStrings.SearchBranchesLabel}" Style="{StaticResource FormField}">
                            <Grid>
                                <TextBox x:Name="BranchSearch"
                                         Padding="{StaticResource Thickness.SearchPadding}"
                                         AutomationProperties.Name="{x:Static res:RemoteSourceStrings.SearchBranchesLabel}"
                                         Style="{StaticResource TextBox.Field}"
                                         Text="{Binding BranchSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{x:Static res:RemoteSourceStrings.SearchBranchesPlaceholder}" />
                                <TextBlock Margin="{StaticResource Thickness.SearchGlyph}"
                                           HorizontalAlignment="Right"
                                           IsHitTestVisible="False"
                                           Style="{StaticResource Text.Glyph}"
                                           Text="{x:Static res:Glyphs.Search}" />
                            </Grid>
                        </HeaderedContentControl>
                        <StackPanel Margin="{StaticResource Thickness.StackGapMedium}" Visibility="{Binding IsLoadingBranches, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar Margin="{StaticResource Thickness.StackGap}"
                                         AutomationProperties.Name="{x:Static res:RemoteSourceStrings.LoadingBranches}"
                                         Style="{StaticResource Progress.Thin}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:RemoteSourceStrings.LoadingBranches}" />
                        </StackPanel>
                        <TextBlock Margin="{StaticResource Thickness.StackGapMedium}"
                                   Style="{StaticResource Text.Helper}"
                                   Text="{x:Static res:RemoteSourceStrings.NoBranchMatch}"
                                   Visibility="{Binding ShowNoBranchMatch, Converter={StaticResource BoolToVisibility}}" />
                        <ScrollViewer MaxHeight="{StaticResource Size.BranchListMaxHeight}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl AutomationProperties.Name="{x:Static res:RemoteSourceStrings.BranchesName}"
                                          Focusable="False"
                                          IsTabStop="False"
                                          ItemTemplate="{StaticResource Branch.RowTemplate}"
                                          ItemsSource="{Binding Branches}"
                                          KeyboardNavigation.DirectionalNavigation="Contained"
                                          KeyboardNavigation.TabNavigation="Once" />
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel x:Name="FilesStep"
                                IsVisibleChanged="OnFilesStepVisibleChanged"
                                PreviewKeyDown="OnFilesStepPreviewKeyDown"
                                Visibility="{Binding ShowFilesStep, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Margin="{StaticResource Thickness.StackGap}"
                                   AutomationProperties.HeadingLevel="Level2"
                                   Style="{StaticResource Text.Subtitle}"
                                   Text="{x:Static res:RemoteSourceStrings.ChooseFiles}" />
                        <Grid Margin="{StaticResource Thickness.StackGap}" IsEnabled="{Binding AreFileControlsEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="FileSearch"
                                         Padding="{StaticResource Thickness.SearchPadding}"
                                         AutomationProperties.Name="{x:Static res:RemoteSourceStrings.FileSearchName}"
                                         KeyDown="OnFileSearchKeyDown"
                                         Style="{StaticResource TextBox.Field}"
                                         Text="{Binding FileTree.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{x:Static res:RemoteSourceStrings.FileSearchPlaceholder}"
                                         b:FocusRouter.Key="FileSearch" />
                                <TextBlock Margin="{StaticResource Thickness.SearchGlyph}"
                                           HorizontalAlignment="Right"
                                           IsHitTestVisible="False"
                                           Style="{StaticResource Text.Glyph}"
                                           Text="{x:Static res:Glyphs.Search}" />
                            </Grid>
                            <Button Grid.Column="1"
                                    Margin="{StaticResource Thickness.LeadingGapSmall}"
                                    AutomationProperties.Name="{Binding FileTree.SelectAllName}"
                                    Command="{Binding FileTree.SelectAllCommand}"
                                    Content="{Binding FileTree.SelectAllLabel}"
                                    Style="{StaticResource Button.Ghost}" />
                            <Button Grid.Column="2"
                                    Margin="{StaticResource Thickness.LeadingGapSmall}"
                                    AutomationProperties.Name="{Binding FileTree.ClearName}"
                                    Command="{Binding FileTree.ClearCommand}"
                                    Content="{Binding FileTree.ClearLabel}"
                                    Style="{StaticResource Button.Ghost}" />
                            <Button Grid.Column="3"
                                    Margin="{StaticResource Thickness.LeadingGapSmall}"
                                    AutomationProperties.Name="{x:Static res:RemoteSourceStrings.OnlySupportedName}"
                                    Command="{Binding FileTree.OnlySupportedCommand}"
                                    Content="{x:Static res:RemoteSourceStrings.OnlySupported}"
                                    Style="{StaticResource Button.Ghost}" />
                        </Grid>

                        <Border Margin="{StaticResource Thickness.StackGap}"
                                AutomationProperties.LiveSetting="Polite"
                                AutomationProperties.Name="{Binding FileTree.TruncatedNotice}"
                                Style="{StaticResource InlineNotice.Warning}"
                                Visibility="{Binding FileTree.TruncatedNotice, Converter={StaticResource NotEmptyToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Top"
                                           Style="{StaticResource Tag.Glyph}"
                                           Text="{x:Static res:Glyphs.Warning}" />
                                <TextBlock Grid.Column="1"
                                           FontFamily="{StaticResource Font.Body}"
                                           FontSize="{StaticResource FontSize.Caption}"
                                           Text="{Binding FileTree.TruncatedNotice}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Grid Margin="{StaticResource Thickness.StackGap}"
                              Visibility="{Binding FileTree.HiddenExcludedNotice, Converter={StaticResource NotEmptyToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Margin="{StaticResource Thickness.InlineGap}"
                                       VerticalAlignment="Top"
                                       Style="{StaticResource Text.Glyph}"
                                       Text="{x:Static res:Glyphs.Info}" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource Text.Caption}"
                                       Text="{Binding FileTree.HiddenExcludedNotice}"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <Grid>
                            <ListBox x:Name="FileTreeList"
                                     AutomationProperties.Name="{x:Static res:RemoteSourceStrings.FileTreeName}"
                                     ItemsSource="{Binding FileTree.VisibleRows}"
                                     PreviewKeyDown="OnFileTreePreviewKeyDown"
                                     SelectedItem="{Binding FileTree.SelectedRow, Mode=TwoWay}"
                                     Style="{StaticResource FileTree.List}"
                                     b:FocusRouter.Key="FileTree" />
                            <StackPanel MaxWidth="{StaticResource Size.ComboPopupMax}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsLoadingTree, Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar Margin="{StaticResource Thickness.StackGap}"
                                             AutomationProperties.Name="{Binding LoadingTreeText}"
                                             Style="{StaticResource Progress.Thin}" />
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource Text.Caption}"
                                           Text="{Binding LoadingTreeText}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding FileTree.ShowEmpty, Converter={StaticResource BoolToVisibility}}">
                                <ContentControl Content="{x:Static res:Glyphs.Document}" Style="{StaticResource EmptyIcon.Small}" />
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource Text.Helper}"
                                           Text="{x:Static res:RemoteSourceStrings.EmptyTree}"
                                           TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding FileTree.ShowNoMatch, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource Text.Helper}"
                                           Text="{Binding FileTree.NoMatchText}"
                                           TextAlignment="Center" />
                                <Button HorizontalAlignment="Center"
                                        AutomationProperties.Name="{x:Static res:RemoteSourceStrings.ClearSearch}"
                                        Command="{Binding FileTree.ClearSearchCommand}"
                                        Content="{x:Static res:RemoteSourceStrings.ClearSearch}"
                                        Style="{StaticResource Button.Link}" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource FilesFooter}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock AutomationProperties.LiveSetting="Polite"
                                               Style="{StaticResource Text.Label}"
                                               Text="{Binding FileTree.SummaryText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="{StaticResource Thickness.HelperGap}"
                                               Text="{Binding FileTree.ProceedHint}"
                                               Visibility="{Binding FileTree.ProceedHint, Converter={StaticResource NotEmptyToVisibility}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Helper}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FileTree.IsOverLimit}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Text}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="{StaticResource Thickness.HelperGap}"
                                               Style="{StaticResource Text.Helper}"
                                               Text="{x:Static res:RemoteSourceStrings.UnknownSizeNote}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding FileTree.HasUnknownSize, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        MinWidth="{StaticResource Size.ActionMinWidth}"
                                        Margin="{StaticResource Thickness.LeadingGap}"
                                        VerticalAlignment="Center"
                                        AutomationProperties.HelpText="{Binding FileTree.ProceedHint}"
                                        AutomationProperties.Name="{x:Static res:RemoteSourceStrings.ProceedName}"
                                        Command="{Binding ProceedCommand}"
                                        Content="{x:Static res:RemoteSourceStrings.ProceedLabel}"
                                        Style="{StaticResource Button.Primary}"
                                        ToolTip="{Binding FileTree.ProceedHint}"
                                        ToolTipService.ShowOnDisabled="True"
                                        b:FocusRouter.Key="Proceed" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ProceedStep" Visibility="{Binding ShowProceedStep, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Margin="{StaticResource Thickness.StackGap}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="{StaticResource FontSize.MonoSmall}"
                                   Style="{StaticResource Text.Caption}"
                                   Text="{Binding CommitText}"
                                   Visibility="{Binding HasCommit, Converter={StaticResource BoolToVisibility}}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Label}" Text="{Binding ProceedSelectionText}" />
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Text="{Binding ProceedSkippedText}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasProceedSkipped, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Margin="{StaticResource Thickness.HelperGap}"
                                           Style="{StaticResource Text.Helper}"
                                           Text="{x:Static res:RemoteSourceStrings.UnknownSizeNote}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding FileTree.HasUnknownSize, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Margin="{StaticResource Thickness.LeadingGap}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Static res:RemoteSourceStrings.FetchAgain}"
                                    Command="{Binding FetchAgainCommand}"
                                    Content="{x:Static res:RemoteSourceStrings.FetchAgain}"
                                    Style="{StaticResource Button.Secondary}"
                                    b:FocusRouter.Key="FetchAgain" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding IsSsh, Converter={StaticResource BoolToVisibility}}">
                    <UniformGrid Margin="{StaticResource Thickness.GridBleed.Section}"
                                 Columns="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource Columns.SshSections}}">
                        <HeaderedContentControl AutomationProperties.Name="{x:Static res:RemoteSourceStrings.SshServerSectionTitle}"
                                                Header="{x:Static res:RemoteSourceStrings.SshServerSectionTitle}"
                                                Style="{StaticResource NumberedSectionCard}"
                                                Tag="1"
                                                b:FieldState.Helper="{x:Static res:RemoteSourceStrings.SshServerSectionHint}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <HeaderedContentControl Grid.Column="0"
                                                        Header="{x:Static res:RemoteSourceStrings.SshHostLabel}"
                                                        Style="{StaticResource FormField}"
                                                        Margin="{StaticResource Thickness.FieldGapSplit}"
                                                        b:FieldState.Error="{Binding SshHostError}">
                                    <TextBox AutomationProperties.HelpText="{Binding SshHostError, TargetNullValue={x:Static sys:String.Empty}}"
                                             AutomationProperties.Name="{x:Static res:RemoteSourceStrings.SshHostName}"
                                             Style="{StaticResource TextBox.Field}"
                                             Text="{Binding SshHost, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{x:Static res:RemoteSourceStrings.SshHostPlaceholder}"
                                             b:FieldState.HasError="{Binding SshHostError, Converter={StaticResource NotEmptyToBool}}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Grid.Column="1"
                                                        Header="{x:Static res:RemoteSourceStrings.SshPortLabel}"
                                                        Style="{StaticResource FormField}"
                                                        b:FieldState.Error="{Binding SshPortError}">
                                    <TextBox AutomationProperties.HelpText="{Binding SshPortError, TargetNullValue={x:Static sys:String.Empty}}"
                                             AutomationProperties.Name="{x:Static res:RemoteSourceStrings.SshPortName}"
                                             Style="{StaticResource TextBox.Field}"
                                             Text="{Binding SshPort, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{x:Static res:RemoteSourceStrings.SshPortPlaceholder}"
                                             b:FieldState.HasError="{Binding SshPortError, Converter={StaticResource NotEmptyToBool}}" />
                                </HeaderedContentControl>
                            </Grid>
                        </HeaderedContentControl>

                        <HeaderedContentControl AutomationProperties.Name="{x:Static res:RemoteSourceStrings.SshAuthSectionTitle}"
                                                Header="{x:Static res:RemoteSourceStrings.SshAuthSectionTitle}"
                                                Style="{StaticResource NumberedSectionCard}"
                                                Tag="2"
                                                b:FieldState.Helper="{x:Static res:RemoteSourceStrings.SshAuthSectionHint}">
                            <StackPanel>
                                <HeaderedContentControl Header="{x:Static res:RemoteSourceStrings.SshUsernameLabel}"
                                                        Style="{StaticResource FormField}"
                                                        b:FieldState.Error="{Binding SshUsernameError}">
                                    <TextBox AutomationProperties.HelpText="{Binding SshUsernameError, TargetNullValue={x:Static sys:String.Empty}}"
                                             AutomationProperties.Name="{x:Static res:RemoteSourceStrings.SshUsernameName}"
                                             Style="{StaticResource TextBox.Field}"
                                             Text="{Binding SshUsername, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{x:Static res:RemoteSourceStrings.SshUsernamePlaceholder}"
                                             b:FieldState.HasError="{Binding SshUsernameError, Converter={StaticResource NotEmptyToBool}}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="{x:Static res:RemoteSourceStrings.SshKeyFileLabel}"
                                                        Style="{StaticResource FormField}"
                                                        b:FieldState.Error="{Binding SshKeyFileError}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 AutomationProperties.HelpText="{Binding SshKeyFileError, TargetNullValue={x:Static sys:String.Empty}}"
                                                 AutomationProperties.Name="{x:Static res:RemoteSourceStrings.SshKeyFileName}"
                                                 IsReadOnly="True"
                                                 Style="{StaticResource TextBox.Field}"
                                                 Text="{Binding SshKeyFilePath, Mode=OneWay}"
                                                 ToolTip="{x:Static res:RemoteSourceStrings.SshKeyFilePlaceholder}"
                                                 b:FieldState.HasError="{Binding SshKeyFileError, Converter={StaticResource NotEmptyToBool}}" />
                                        <Button Grid.Column="1"
                                                Margin="{StaticResource Thickness.LeadingGap}"
                                                AutomationProperties.Name="{x:Static res:RemoteSourceStrings.SshBrowseKeyFileName}"
                                                Command="{Binding BrowseSshKeyFileCommand}"
                                                Content="{x:Static res:RemoteSourceStrings.SshBrowseKeyFile}"
                                                Style="{StaticResource Button.Secondary}" />
                                    </Grid>
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="{x:Static res:RemoteSourceStrings.SshPassphraseLabel}"
                                                        Style="{StaticResource FormField}"
                                                        b:FieldState.Helper="{x:Static res:RemoteSourceStrings.SshPassphraseHint}">
                                    <Grid Focusable="True"
                                          FocusVisualStyle="{x:Null}"
                                          GotKeyboardFocus="OnFieldHostGotFocus"
                                          KeyboardNavigation.IsTabStop="False">
                                        <PasswordBox x:Name="PassphrasePassword"
                                                     AutomationProperties.Name="{x:Static res:RemoteSourceStrings.SshPassphraseName}"
                                                     PasswordChanged="OnPassphrasePasswordChanged"
                                                     Style="{StaticResource PasswordBox.Field.Trail}"
                                                     Visibility="{Binding IsPassphraseVisible, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <TextBox x:Name="PassphraseText"
                                                 AutomationProperties.Name="{x:Static res:RemoteSourceStrings.SshPassphraseName}"
                                                 IsUndoEnabled="False"
                                                 Style="{StaticResource TextBox.Field.Trail}"
                                                 TextChanged="OnPassphraseTextChanged"
                                                 Visibility="{Binding IsPassphraseVisible, Converter={StaticResource BoolToVisibility}}" />
                                        <ToggleButton x:Name="PassphraseReveal"
                                                      Click="OnPassphraseRevealClick"
                                                      IsChecked="{Binding IsPassphraseVisible}"
                                                      Style="{StaticResource Reveal.Passphrase}" />
                                    </Grid>
                                </HeaderedContentControl>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl AutomationProperties.Name="{x:Static res:RemoteSourceStrings.SshFolderSectionTitle}"
                                                Header="{x:Static res:RemoteSourceStrings.SshFolderSectionTitle}"
                                                Style="{StaticResource NumberedSectionCard}"
                                                Tag="3"
                                                b:FieldState.Helper="{x:Static res:RemoteSourceStrings.SshFolderSectionHint}">
                            <HeaderedContentControl Header="{x:Static res:RemoteSourceStrings.SshFolderLabel}"
                                                    Style="{StaticResource FormField}"
                                                    b:FieldState.Error="{Binding SshFolderError}"
                                                    b:FieldState.Helper="{x:Static res:RemoteSourceStrings.SshFolderHint}">
                                <TextBox AutomationProperties.HelpText="{Binding SshFolderError, TargetNullValue={x:Static sys:String.Empty}}"
                                         AutomationProperties.Name="{x:Static res:RemoteSourceStrings.SshFolderName}"
                                         Style="{StaticResource TextBox.Url}"
                                         Text="{Binding SshFolder, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{x:Static res:RemoteSourceStrings.SshFolderPlaceholder}"
                                         b:FieldState.HasError="{Binding SshFolderError, Converter={StaticResource NotEmptyToBool}}" />
                            </HeaderedContentControl>
                        </HeaderedContentControl>
                    </UniformGrid>
                    <Button Margin="{StaticResource Thickness.ActionTop}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="{x:Static res:RemoteSourceStrings.SshConnectName}"
                            Command="{Binding SshConnectCommand}"
                            Content="{x:Static res:RemoteSourceStrings.SshConnect}"
                            Style="{StaticResource Button.Primary}" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsCortexa, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Visibility="{Binding IsListLoading, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Margin="{StaticResource Thickness.StackGap}"
                                     AutomationProperties.Name="{x:Static res:RemoteSourceStrings.LoadingRepositories}"
                                     Style="{StaticResource Progress.Thin}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:RemoteSourceStrings.LoadingRepositories}" />
                    </StackPanel>

                    <Border Style="{StaticResource Repository.Surface}"
                            Visibility="{Binding ShowEmptyList, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Style="{StaticResource Repository.ListState}">
                            <ContentControl Content="{x:Static res:Glyphs.Repository}" Style="{StaticResource EmptyIcon.Small}" />
                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource Text.Label}"
                                       Text="{x:Static res:RemoteSourceStrings.EmptyTitle}" />
                            <TextBlock Margin="{StaticResource Thickness.StackGap}"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource Text.Helper}"
                                       Text="{Binding EmptyText}"
                                       TextAlignment="Center" />
                            <Button HorizontalAlignment="Center"
                                    AutomationProperties.Name="{x:Static res:RemoteSourceStrings.Reload}"
                                    Command="{Binding LoadRepositoriesCommand}"
                                    Content="{x:Static res:RemoteSourceStrings.Reload}"
                                    Style="{StaticResource Button.Secondary}" />
                        </StackPanel>
                    </Border>

                    <Grid Visibility="{Binding HasRepositories, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <HeaderedContentControl Grid.Column="0"
                                                Header="{x:Static res:RemoteSourceStrings.SearchLabel}"
                                                Style="{StaticResource FormField}">
                            <Grid>
                                <TextBox AutomationProperties.Name="{x:Static res:RemoteSourceStrings.SearchName}"
                                         Padding="{StaticResource Thickness.SearchPadding}"
                                         Style="{StaticResource TextBox.Field}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{x:Static res:RemoteSourceStrings.SearchPlaceholder}" />
                                <TextBlock Margin="{StaticResource Thickness.SearchGlyph}"
                                           HorizontalAlignment="Right"
                                           IsHitTestVisible="False"
                                           Style="{StaticResource Text.Glyph}"
                                           Text="{x:Static res:Glyphs.Search}" />
                            </Grid>
                        </HeaderedContentControl>
                        <Button Grid.Column="1"
                                Margin="{StaticResource Thickness.FieldAdjacent}"
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="{x:Static res:RemoteSourceStrings.Reload}"
                                Command="{Binding LoadRepositoriesCommand}"
                                Content="{x:Static res:Glyphs.Refresh}"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="{x:Static res:RemoteSourceStrings.Reload}" />
                    </Grid>
                    <TextBlock Margin="{StaticResource Thickness.StackGap}"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource Text.Caption}"
                               Text="{Binding ShowingText}"
                               Visibility="{Binding HasRepositories, Converter={StaticResource BoolToVisibility}}" />

                    <Border Style="{StaticResource Repository.Surface}"
                            Visibility="{Binding ShowNoMatch, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Style="{StaticResource Repository.ListState}">
                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource Text.Helper}"
                                       Text="{Binding NoMatchText}" />
                            <Button HorizontalAlignment="Center"
                                    AutomationProperties.Name="{Binding ClearActionName}"
                                    Command="{Binding ClearFiltersCommand}"
                                    Content="{Binding ClearActionLabel}"
                                    Style="{StaticResource Button.Link}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Repository.Surface}"
                            Visibility="{Binding ShowRepositoryList, Converter={StaticResource BoolToVisibility}}">
                        <ListBox AutomationProperties.Name="{x:Static res:RemoteSourceStrings.RepositoriesName}"
                                 ItemsSource="{Binding Repositories}"
                                 SelectedItem="{Binding SelectedRepository}"
                                 Style="{StaticResource Repository.List}"
                                 b:FocusRouter.Key="RemoteRepositories" />
                    </Border>

                    <StackPanel Visibility="{Binding HasRepositories, Converter={StaticResource BoolToVisibility}}">
                        <HeaderedContentControl Header="{x:Static res:RemoteSourceStrings.BranchLabel}" Style="{StaticResource FormField}">
                            <StackPanel HorizontalAlignment="Left">
                                <Border MinHeight="{StaticResource Size.Control}"
                                        MinWidth="{StaticResource Size.ComboMin}"
                                        Padding="{StaticResource Thickness.ChipPadding}"
                                        Background="{DynamicResource Brush.Surface.Sunken}"
                                        Focusable="False"
                                        IsEnabled="{Binding ShowBranchField}"
                                        Style="{StaticResource Repository.Surface}">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock Margin="{StaticResource Thickness.InlineGap}"
                                                   Style="{StaticResource Text.Glyph}"
                                                   Text="{x:Static res:Glyphs.Branch}" />
                                        <TextBlock AutomationProperties.HelpText="{x:Static res:RemoteSourceStrings.CortexaBranchHelper}"
                                                   AutomationProperties.Name="{Binding CortexaBranchName}"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="{StaticResource FontSize.MonoBody}"
                                                   Style="{StaticResource Text.Label}"
                                                   Text="{Binding CortexaBranchText}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock MaxWidth="{StaticResource Size.ContentMaxWidth}"
                                           Margin="{StaticResource Thickness.HelperGap}"
                                           Style="{StaticResource Text.Helper}"
                                           Text="{x:Static res:RemoteSourceStrings.CortexaBranchHelper}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    MinHeight="{StaticResource Size.RowAction}"
                                    Margin="{StaticResource Thickness.InlineGapLarge}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.HelpText="{Binding FetchHelp}"
                                    AutomationProperties.Name="{x:Static res:RemoteSourceStrings.FetchName}"
                                    Command="{Binding FetchCommand}"
                                    Content="{x:Static res:RemoteSourceStrings.Fetch}"
                                    Style="{StaticResource Button.Primary}"
                                    ToolTip="{Binding FetchHelp}"
                                    ToolTipService.ShowOnDisabled="True" />
                            <TextBlock Grid.Column="1"
                                       MaxWidth="{StaticResource Size.ContentMaxWidth}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Text="{Binding FetchHelp}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Helper}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FetchHelpIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Text}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Margin="{StaticResource Thickness.StackGap}"
                Style="{StaticResource Card}"
                Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="{StaticResource Thickness.InlineGapLarge}"
                           Style="{StaticResource Text.Glyph}"
                           Text="{x:Static res:Glyphs.Repository}" />
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding Summary.AutomationName}">
                    <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Summary.Repository}" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="{Binding Summary.Detail}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Margin="{StaticResource Thickness.InlineGapLarge}"
                            AutomationProperties.Name="{x:Static res:RemoteSourceStrings.FetchAgain}"
                            Command="{Binding FetchAgainCommand}"
                            Content="{x:Static res:RemoteSourceStrings.FetchAgain}"
                            Style="{StaticResource Button.Secondary}" />
                    <Button AutomationProperties.Name="{x:Static res:RemoteSourceStrings.ChangeRepository}"
                            Command="{Binding ChangeRepositoryCommand}"
                            Content="{x:Static res:RemoteSourceStrings.ChangeRepository}"
                            Style="{StaticResource Button.Link}" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
