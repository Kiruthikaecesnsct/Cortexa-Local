<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:b="clr-namespace:Collector.Presentation.Behaviors"
                    xmlns:res="clr-namespace:Collector.Presentation.Resources">

    <FontFamily x:Key="Font.Body">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.BodyLarge">16</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">18</sys:Double>
    <sys:Double x:Key="FontSize.Title">24</sys:Double>
    <sys:Double x:Key="FontSize.Icon">16</sys:Double>
    <sys:Double x:Key="FontSize.IconSmall">12</sys:Double>

    <sys:Double x:Key="Space.XS">4</sys:Double>
    <sys:Double x:Key="Space.S">8</sys:Double>
    <sys:Double x:Key="Space.M">12</sys:Double>
    <sys:Double x:Key="Space.L">16</sys:Double>
    <sys:Double x:Key="Space.XL">24</sys:Double>
    <sys:Double x:Key="Space.XXL">32</sys:Double>

    <Thickness x:Key="Thickness.ContentPadding">32,24,32,32</Thickness>
    <Thickness x:Key="Thickness.ContentPaddingCompact">16,16,16,24</Thickness>
    <Thickness x:Key="Thickness.CardPadding">24</Thickness>
    <Thickness x:Key="Thickness.ControlPadding">12,8,12,8</Thickness>
    <Thickness x:Key="Thickness.ControlPaddingFocused">11,7,11,7</Thickness>
    <Thickness x:Key="Thickness.ButtonPadding">16,8,16,8</Thickness>
    <Thickness x:Key="Thickness.FieldGap">0,0,0,16</Thickness>
    <Thickness x:Key="Thickness.Border">1</Thickness>
    <Thickness x:Key="Thickness.FocusRing">2</Thickness>
    <Thickness x:Key="Thickness.FocusMargin">-2</Thickness>
    <Thickness x:Key="Thickness.None">0</Thickness>
    <Thickness x:Key="Thickness.NavItemPadding">24,0,12,0</Thickness>
    <Thickness x:Key="Thickness.ChipPadding">10,4,10,4</Thickness>
    <Thickness x:Key="Thickness.BannerPadding">16,12,12,12</Thickness>
    <Thickness x:Key="Thickness.RowPadding">0,12,0,12</Thickness>
    <Thickness x:Key="Thickness.TopBarPadding">24,0,24,0</Thickness>
    <Thickness x:Key="Thickness.StackGap">0,0,0,8</Thickness>
    <Thickness x:Key="Thickness.StackGapLarge">0,0,0,24</Thickness>
    <Thickness x:Key="Thickness.InlineGap">0,0,8,0</Thickness>
    <Thickness x:Key="Thickness.InlineGapLarge">0,0,12,0</Thickness>
    <Thickness x:Key="Thickness.LabelPadding">0,0,0,4</Thickness>
    <Thickness x:Key="Thickness.HelperGap">0,4,0,0</Thickness>
    <Thickness x:Key="Thickness.SectionTop">0,24,0,0</Thickness>
    <Thickness x:Key="Thickness.SignInTop">0,24,0,0</Thickness>
    <Thickness x:Key="Thickness.BottomBorder">0,0,0,1</Thickness>
    <Thickness x:Key="Thickness.HintPull">0,-8,0,16</Thickness>
    <Thickness x:Key="Thickness.Inset">24,0,24,0</Thickness>

    <sys:Double x:Key="Size.Control">40</sys:Double>
    <sys:Double x:Key="Size.NavItem">44</sys:Double>
    <sys:Double x:Key="Size.RowAction">44</sys:Double>
    <sys:Double x:Key="Size.RowMin">64</sys:Double>
    <sys:Double x:Key="Size.TopBar">56</sys:Double>
    <GridLength x:Key="GridLength.TopBar">56</GridLength>
    <sys:Double x:Key="Size.RailExpanded">232</sys:Double>
    <sys:Double x:Key="Size.RailCompact">64</sys:Double>
    <sys:Double x:Key="Size.SignInCardWidth">400</sys:Double>
    <sys:Double x:Key="Size.ContentMaxWidth">720</sys:Double>
    <sys:Double x:Key="Size.EmailMaxWidth">280</sys:Double>
    <sys:Double x:Key="Size.WindowMinWidth">880</sys:Double>
    <sys:Double x:Key="Size.WindowMinHeight">600</sys:Double>
    <sys:Double x:Key="Size.WindowDefaultWidth">1120</sys:Double>
    <sys:Double x:Key="Size.WindowDefaultHeight">720</sys:Double>
    <sys:Double x:Key="Size.Progress">2</sys:Double>
    <sys:Double x:Key="Size.IconVisual">32</sys:Double>
    <sys:Double x:Key="Size.IconHit">40</sys:Double>
    <sys:Double x:Key="Size.NavIndicator">3</sys:Double>
    <sys:Double x:Key="Size.Divider">1</sys:Double>
    <sys:Double x:Key="Size.ActionMinWidth">96</sys:Double>
    <sys:Double x:Key="Breakpoint.RailCompact">1040</sys:Double>

    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Radius.Card">14</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">999</CornerRadius>
    <CornerRadius x:Key="Radius.Focus">10</CornerRadius>

    <b:NotEmptyToBoolConverter x:Key="NotEmptyToBool" />
    <b:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
    <b:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    <b:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <b:NotZeroToVisibilityConverter x:Key="NotZeroToVisibility" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="FocusVisual.Default">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="{StaticResource Thickness.FocusMargin}"
                            BorderBrush="{DynamicResource Brush.Border.Focus}"
                            BorderThickness="{StaticResource Thickness.FocusRing}"
                            CornerRadius="{StaticResource Radius.Focus}"
                            IsHitTestVisible="False"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Helper" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Error" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    </Style>
    <Style x:Key="Text.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Icon}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Text.Glyph.Error" TargetType="TextBlock" BasedOn="{StaticResource Text.Glyph}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.IconSmall}" />
    </Style>
    <Style x:Key="Text.Glyph.Header" TargetType="TextBlock" BasedOn="{StaticResource Text.Glyph}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <Style x:Key="Label.Field" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.LabelPadding}" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <ControlTemplate x:Key="Button.Template" TargetType="Button">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.Control}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
        </Border>
    </ControlTemplate>

    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.ButtonPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource Button.Template}" />
    </Style>

    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Button.Edge}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Button.Edge}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Link" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.ControlPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Link}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Icon" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}" />
        <Setter Property="Width" Value="{StaticResource Size.IconHit}" />
        <Setter Property="Height" Value="{StaticResource Size.IconHit}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.IconSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Visual"
                                Width="{StaticResource Size.IconVisual}"
                                Height="{StaticResource Size.IconVisual}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Control}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Visual" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Field.Template" TargetType="Control">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.Control}"
                SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
        </Border>
    </ControlTemplate>

    <Style x:Key="Field.Base" TargetType="Control">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.ControlPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource Field.Template}" />
        <Style.Triggers>
            <Trigger Property="b:FieldState.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                <Setter Property="BorderThickness" Value="{StaticResource Thickness.FocusRing}" />
                <Setter Property="Padding" Value="{StaticResource Thickness.ControlPaddingFocused}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                <Setter Property="BorderThickness" Value="{StaticResource Thickness.FocusRing}" />
                <Setter Property="Padding" Value="{StaticResource Thickness.ControlPaddingFocused}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TextBox.Field" TargetType="TextBox" BasedOn="{StaticResource Field.Base}">
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <Style x:Key="TextBox.Url" TargetType="TextBox" BasedOn="{StaticResource TextBox.Field}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    </Style>

    <Style x:Key="PasswordBox.Field" TargetType="PasswordBox" BasedOn="{StaticResource Field.Base}">
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <Style x:Key="FormField" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="{StaticResource Thickness.FieldGap}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel>
                        <Label Content="{TemplateBinding Header}"
                               Target="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                               Style="{StaticResource Label.Field}" />
                        <ContentPresenter />
                        <TextBlock Margin="{StaticResource Thickness.HelperGap}"
                                   Style="{StaticResource Text.Helper}"
                                   Text="{Binding (b:FieldState.Helper), RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{Binding (b:FieldState.Helper), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NotEmptyToVisibility}}" />
                        <StackPanel Margin="{StaticResource Thickness.HelperGap}"
                                    Orientation="Horizontal"
                                    Visibility="{Binding (b:FieldState.Error), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NotEmptyToVisibility}}">
                            <TextBlock Margin="{StaticResource Thickness.InlineGap}"
                                       VerticalAlignment="Top"
                                       Style="{StaticResource Text.Glyph.Error}"
                                       Text="{x:Static res:Glyphs.Error}" />
                            <TextBlock Style="{StaticResource Text.Error}"
                                       Text="{Binding (b:FieldState.Error), RelativeSource={RelativeSource TemplatedParent}}" />
                        </StackPanel>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.CardPadding}" />
    </Style>

    <Style x:Key="Progress.Thin" TargetType="ProgressBar">
        <Setter Property="Height" Value="{StaticResource Size.Progress}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.None}" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource Size.Divider}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
    </Style>

    <Style x:Key="Nav.Glyph" TargetType="TextBlock" BasedOn="{StaticResource Text.Glyph}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
        <Setter Property="Margin" Value="{StaticResource Thickness.InlineGapLarge}" />
    </Style>
    <Style x:Key="Nav.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Nav.Lock" TargetType="TextBlock" BasedOn="{StaticResource Text.Glyph}">
        <Setter Property="Margin" Value="{StaticResource Thickness.InlineGap}" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>
    <Style x:Key="Nav.Indicator" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource Size.NavIndicator}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="NavRail.Item" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}" />
        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding HelpText}" />
        <Setter Property="b:CommandBehaviors.ActivateCommand" Value="{Binding ActivateCommand}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="Root" Height="{StaticResource Size.NavItem}" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Highlight" />
                        <Border x:Name="Indicator" Style="{StaticResource Nav.Indicator}" />
                        <StackPanel Margin="{StaticResource Thickness.NavItemPadding}"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBlock x:Name="GlyphText" Style="{StaticResource Nav.Glyph}" Text="{Binding Glyph}" />
                            <TextBlock x:Name="Label"
                                       Style="{StaticResource Nav.Label}"
                                       Text="{Binding Title}"
                                       Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock x:Name="LockGlyph" Style="{StaticResource Nav.Lock}" Text="{x:Static res:Glyphs.Lock}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ShowLock}" Value="True" />
                                <Condition Binding="{Binding ShowLabel}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="LockGlyph" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text.Link}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="GlyphText" Property="Foreground" Value="{DynamicResource Brush.Text.Link}" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter TargetName="GlyphText" Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavRail" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.None}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavRail.Item}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
