<UserControl x:Class="Collector.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Collector.Presentation.Behaviors"
             xmlns:res="clr-namespace:Collector.Presentation.Resources"
             b:FocusRouter.IsHost="True"
             Focusable="False"
             IsTabStop="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource GridLength.SectionNav}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Margin="{StaticResource Thickness.InlineGapXL}"
                Padding="{StaticResource Thickness.SectionNavPadding}"
                VerticalAlignment="Top"
                Style="{StaticResource Card}">
            <ListBox AutomationProperties.Name="{x:Static res:SettingsStrings.SectionListName}"
                     ItemsSource="{Binding Sections}"
                     SelectedItem="{Binding SelectedSection}"
                     Style="{StaticResource SectionNav}" />
        </Border>

        <ContentControl Grid.Column="1"
                        AutomationProperties.Name="{Binding SelectedSection.Title}"
                        Content="{Binding SelectedSection.Content}"
                        Focusable="False"
                        IsTabStop="False" />
    </Grid>
</UserControl>
