{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "*.css",
      "*.js",
      "*.svg",
      "*.png",
      "*.ico",
      "*.woff",
      "*.woff2",
      "*.ttf",
      "*.eot"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "X-XSS-Protection": "1; mode=block",
    "Content-Security-Policy": "default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; frame-ancestors 'none'"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
