{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "Uri": "",
    "CosmosUriSecretName": "job-orchestrator-cosmos-uri",
    "JwtSigningKeySecretName": "jwt-signing-key",
    "BlobAccountUrlSecretName": "cortexa-blob-account-url"
  },
  "Cosmos": {
    "Uri": "",
    "Database": "cortexa-pipeline",
    "BatchesContainer": "batches",
    "DocumentsContainer": "documents",
    "ChunksContainer": "chunks",
    "ProvenanceMapsContainer": "provenance_maps",
    "VerdictsContainer": "verdicts",
    "HarvestingContainer": "reports",
    "SeedingContainer": "reports",
    "CandidatesContainer": "candidates",
    "EvidenceBundlesContainer": "evidence_bundles",
    "ConfigContainer": "config",
    "SagaDeleteDeadlineSeconds": 15
  },
  "Blob": {
    "AccountUrl": "",
    "RawContainer": "raw-files",
    "ViewableContainer": "viewable-docs"
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "cortexa-identity-dev",
    "Audience": "cortexa-dev"
  },
  "Messaging": {
    "Backend": "servicebus"
  },
  "RabbitMq": {
    "Uri": "",
    "ClientName": "job-orchestrator",
    "PrefetchCount": 1,
    "MaxScanMessages": 500
  },
  "ServiceBus": {
    "NamespaceFqdn": "",
    "SubscriptionName": "orchestrator",
    "MaxDeliveryCount": 5,
    "UseSessions": true,
    "MaxConcurrentSessions": 8,
    "CandidateSessionDrainBudgetSeconds": 8,
    "SessionAcceptTimeoutSeconds": 2,
    "TopicNames": {
      "batch.created": "batch-created",
      "ingestion.requested": "ingestion-requested",
      "ingestion.completed": "ingestion-completed",
      "extraction.requested": "extraction-requested",
      "extraction.completed": "extraction-completed",
      "extraction.failed": "extraction-failed",
      "evidence.requested": "evidence-requested",
      "evidence.completed": "evidence-completed",
      "evidence.failed": "evidence-failed",
      "scoring.requested": "scoring-requested",
      "scoring.completed": "scoring-completed",
      "scoring.failed": "scoring-failed",
      "harvesting.requested": "harvesting-requested",
      "harvesting.failed": "harvesting-failed",
      "seeding.requested": "seeding-requested",
      "seeding.failed": "seeding-failed",
      "asset-embedding.requested": "asset-embedding-requested",
      "asset-embedding.completed": "asset-embedding-completed",
      "digest.requested": "digest-requested",
      "digest.completed": "digest-completed",
      "landscape.requested": "landscape-requested",
      "landscape.completed": "landscape-completed",
      "ideation.completed": "ideation-completed",
      "seeding-report.requested": "seeding-report-requested",
      "engine.completed": "engine-completed"
    },
    "WorkerSubscriptions": {
      "ingestion.requested": "ingestion",
      "extraction.requested": "extraction",
      "evidence.requested": "evidence",
      "scoring.requested": "scoring",
      "harvesting.requested": "harvesting",
      "seeding.requested": "seeding",
      "seeding-report.requested": "seeding"
    },
    "DrainDeadLetters": true
  },
  "Orchestrator": {
    "ConcurrencyCap": 5,
    "EvidenceSourceOutageThreshold": 0.0,
    "MaxChunksPerExtractionUnit": 25
  },
  "Multipart": {
    "MaxFileSizeMb": 100
  },
  "Retention": {
    "Enabled": true,
    "IntervalHours": 24,
    "FailedRetentionDays": 30,
    "IncompleteStuckHours": 72,
    "DryRun": true,
    "ForceWedgedRunning": false,
    "BatchPageSize": 100,
    "MaxDeletesPerRun": 200
  },
  "Watchdog": {
    "WatchdogEnabled": false,
    "WatchdogIntervalMinutes": 15,
    "StageStallSlaMinutes": 30
  },
  "ModelRouter": {
    "BaseUrl": ""
  },
  "VectorRouter": {
    "Url": ""
  },
  "PatentApis": {
    "UsptoBaseUrl": "https://api.uspto.gov",
    "EpoBaseUrl": "https://ops.epo.org",
    "EpoTokenPath": "/3.2/auth/accesstoken",
    "LensBaseUrl": "https://api.lens.org",
    "TimeoutSeconds": 15
  }
}
