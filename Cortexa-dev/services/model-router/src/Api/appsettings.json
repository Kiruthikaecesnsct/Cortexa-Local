{
  "Foundry": {
    "Endpoint": "https://cortexa-dev-ai-resource.openai.azure.com",
    "Deployment": "gpt-5.5",
    "ApiVersion": "v1",
    "ApiKeySecretName": "model-router-foundry-api-key",
    "TimeoutSeconds": 200,
    "CallTimeoutSeconds": 80,
    "AcquireWaitSeconds": 2,
    "ConcurrencyHighWaterFraction": 0.8,
    "ReasoningEffort": "high",
    "MaxRetries": 3,
    "RetryBaseDelayMs": 300,
    "DeploymentOptions": {
      "gpt-5.5": {
        "TokenFieldKind": "MaxCompletionTokens",
        "SendReasoningEffort": true,
        "SendTemperature": true,
        "MaxInFlight": 24,
        "SupportedReasoningEfforts": [ "none", "low", "medium", "high", "xhigh" ]
      },
      "gpt-5.4": {
        "TokenFieldKind": "MaxCompletionTokens",
        "SendReasoningEffort": true,
        "SendTemperature": true,
        "MaxInFlight": 24,
        "SupportedReasoningEfforts": [ "none", "minimal", "low", "medium", "high", "xhigh" ]
      },
      "grok-4.3": {
        "TokenFieldKind": "MaxTokens",
        "SendReasoningEffort": false,
        "SendTemperature": false,
        "OutputTokenCap": 8192,
        "MaxInFlight": 10
      },
      "DeepSeek-V4-Pro": {
        "TokenFieldKind": "MaxTokens",
        "SendReasoningEffort": false,
        "SendTemperature": false,
        "MaxInFlight": 10
      }
    },
    "TaskOverrides": {
      "patent_research": {
        "ReasoningEffort": "minimal",
        "OutputTokenCap": 1024,
        "CallTimeoutSeconds": 40
      },
      "claim_drafting": {
        "ReasoningEffort": "minimal",
        "OutputTokenCap": 1024,
        "CallTimeoutSeconds": 40
      },
      "extraction": {
        "OutputTokenCap": 32768,
        "CallTimeoutSeconds": 150
      },
      "seeding": {
        "ReasoningEffort": "medium",
        "OutputTokenCap": 16384,
        "CallTimeoutSeconds": 150
      }
    }
  },
  "Anthropic": {
