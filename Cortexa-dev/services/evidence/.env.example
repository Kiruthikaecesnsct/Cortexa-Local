USPTO_BASE=https://api.data.uspto.gov
EPO_BASE=https://ops.epo.org
EPO_TOKEN_PATH=/3.2/auth/accesstoken
PATENT_API_TIMEOUT_SECONDS=15.0
PATENT_API_MAX_RETRIES=3
KEYVAULT_URI=
LOCAL_DEV=false

# Seed corpus loading
CORPUS_FILE_PATH=data/corpus/seed_patents.jsonl
CORPUS_LOAD_BATCH_SIZE=16
CORPUS_LOAD_TIMEOUT_SECONDS=30.0
CORPUS_LOAD_MAX_RETRIES=3

# Local-dev only — set LOCAL_DEV=true and fill these; never commit real values
USPTO_API_KEY=
EPO_CONSUMER_KEY=
EPO_OAUTH_SECRET=

# Cosmos DB
COSMOS_URI=
COSMOS_DATABASE=cortexa-pipeline
EVIDENCE_CONTAINER=evidence_bundles

# Service Bus
SERVICEBUS_NAMESPACE_FQDN=
EVIDENCE_COMPLETED_TOPIC=evidence.completed

# Source-3 deep-research model override; blank/unset falls back to the batch's primary evidence model.
LLM_RESEARCH_MODEL=gpt-5.4
