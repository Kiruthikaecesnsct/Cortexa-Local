    <SolidColorBrush x:Key="Brush.Warning.Surface" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="Brush.Info.Surface" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="Brush.Button.Edge" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
