<UserControl x:Class="Collector.Presentation.Views.GitHubDeviceCodePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Collector.Presentation.Behaviors"
             xmlns:res="clr-namespace:Collector.Presentation.Resources"
             Focusable="False"
             IsTabStop="False">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="DeviceCode.Text" TargetType="TextBox" BasedOn="{StaticResource TextBox.Code}">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Hero}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="DeviceCode.Surface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
            <Setter Property="Padding" Value="{StaticResource Thickness.CardPadding}" />
            <Setter Property="Margin" Value="{StaticResource Thickness.StackGapMedium}" />
        </Style>

        <Style x:Key="DeviceCode.Outcome" TargetType="Border" BasedOn="{StaticResource DeviceCode.Surface}">
            <Setter Property="Background" Value="{DynamicResource Brush.Danger.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Border}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpiredOutcome}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Warning.Surface}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning.Border}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceCode.OutcomeGlyph" TargetType="TextBlock" BasedOn="{StaticResource Text.Glyph.Error}">
            <Setter Property="Text" Value="{x:Static res:Glyphs.Error}" />
            <Setter Property="Margin" Value="{StaticResource Thickness.InlineGapLarge}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpiredOutcome}" Value="True">
                    <Setter Property="Text" Value="{x:Static res:Glyphs.Warning}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceCode.Countdown" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceCode.ClockGlyph" TargetType="TextBlock" BasedOn="{StaticResource Text.Glyph}">
            <Setter Property="Text" Value="{x:Static res:Glyphs.Clock}" />
            <Setter Property="Margin" Value="{StaticResource Thickness.InlineGap}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                    <Setter Property="Text" Value="{x:Static res:Glyphs.Warning}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Width="{StaticResource Size.LiveRegion}"
                   Height="{StaticResource Size.LiveRegion}"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="{Binding Announcement}"
                   Focusable="False"
                   Text="{Binding Announcement}" />

        <Border AutomationProperties.Name="{x:Static res:GitHubAuthStrings.CodePanelTitle}"
                Style="{StaticResource DeviceCode.Surface}"
                Visibility="{Binding IsRequesting, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <ProgressBar Margin="{StaticResource Thickness.StackGap}"
                             AutomationProperties.Name="{x:Static res:GitHubAuthStrings.RequestingCode}"
                             Style="{StaticResource Progress.Thin}" />
                <TextBlock AutomationProperties.LiveSetting="Polite"
                           Style="{StaticResource Text.Caption}"
                           Text="{x:Static res:GitHubAuthStrings.RequestingCode}" />
                <Button Margin="{StaticResource Thickness.ActionTop}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{x:Static res:GitHubAuthStrings.CancelSignInName}"
                        Command="{Binding CancelCommand}"
                        Content="{x:Static res:GitHubAuthStrings.CancelSignIn}"
                        Style="{StaticResource Button.Ghost}" />
            </StackPanel>
        </Border>

        <Border AutomationProperties.Name="{x:Static res:GitHubAuthStrings.CodePanelTitle}"
                Style="{StaticResource DeviceCode.Surface}"
                Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Margin="{StaticResource Thickness.StackGap}"
                           AutomationProperties.HeadingLevel="Level3"
                           Style="{StaticResource Text.Subtitle}"
                           Text="{x:Static res:GitHubAuthStrings.CodePanelTitle}" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{x:Static res:GitHubAuthStrings.CodeStepCopy}" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{x:Static res:GitHubAuthStrings.CodeStepOpen}" />
                <TextBlock Margin="{StaticResource Thickness.StackGap}"
                           Style="{StaticResource Text.Body}"
                           Text="{x:Static res:GitHubAuthStrings.CodeStepApprove}" />

                <TextBox Margin="{StaticResource Thickness.StackGap}"
                         AutomationProperties.HelpText="{x:Static res:GitHubAuthStrings.CodeStepOpen}"
                         AutomationProperties.Name="{Binding UserCodeName}"
                         Style="{StaticResource DeviceCode.Text}"
                         Text="{Binding UserCode, Mode=OneWay}" />

                <WrapPanel Margin="{StaticResource Thickness.StackGap}">
                    <Button x:Name="CopyButton"
                            Margin="{StaticResource Thickness.InlineGapLarge}"
                            AutomationProperties.Name="{x:Static res:GitHubAuthStrings.CopyCodeName}"
                            Command="{Binding CopyCodeCommand}"
                            Style="{StaticResource Button.Secondary}"
                            b:FocusRouter.Key="DeviceCopy">
                        <Grid>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsCopied, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Margin="{StaticResource Thickness.InlineGap}"
                                           Style="{StaticResource Text.Glyph}"
                                           Text="{x:Static res:Glyphs.Copy}" />
                                <AccessText Text="{x:Static res:GitHubAuthStrings.CopyCode}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsCopied, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Margin="{StaticResource Thickness.InlineGap}"
                                           Foreground="{DynamicResource Brush.Success}"
                                           Style="{StaticResource Text.Glyph}"
                                           Text="{x:Static res:Glyphs.CheckMark}" />
                                <TextBlock Text="{x:Static res:GitHubAuthStrings.Copied}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Margin="{StaticResource Thickness.InlineGapLarge}"
                            AutomationProperties.Name="{x:Static res:GitHubAuthStrings.OpenBrowserName}"
                            Command="{Binding OpenBrowserCommand}"
                            Style="{StaticResource Button.Primary}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="{StaticResource Thickness.InlineGap}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Style="{StaticResource Text.Glyph}"
                                       Text="{x:Static res:Glyphs.OpenInNewWindow}" />
                            <AccessText Text="{x:Static res:GitHubAuthStrings.OpenBrowser}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <Button HorizontalAlignment="Left"
                        AutomationProperties.Name="{x:Static res:GitHubAuthStrings.OpenBrowserName}"
                        Command="{Binding OpenBrowserCommand}"
                        Content="{Binding LinkText}"
                        Style="{StaticResource Button.Link}" />

                <Border Margin="{StaticResource Thickness.StackGap}"
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="{Binding Notice, TargetNullValue=''}"
                        Style="{StaticResource InlineNotice.Warning}"
                        Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="{StaticResource Thickness.InlineGapLarge}"
                                   Foreground="{DynamicResource Brush.Warning}"
                                   Style="{StaticResource Text.Glyph}"
                                   Text="{x:Static res:Glyphs.Warning}" />
                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Notice}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ProgressBar Margin="{StaticResource Thickness.StackGap}"
                             AutomationProperties.Name="{x:Static res:GitHubAuthStrings.Waiting}"
                             Style="{StaticResource Progress.Thin}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource Text.Caption}"
                               Text="{x:Static res:GitHubAuthStrings.Waiting}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource DeviceCode.ClockGlyph}" />
                        <TextBlock AutomationProperties.LiveSetting="Off"
                                   AutomationProperties.Name="{Binding RemainingText}"
                                   Style="{StaticResource DeviceCode.Countdown}"
                                   Text="{Binding RemainingText}" />
                    </StackPanel>
                </Grid>

                <Button Margin="{StaticResource Thickness.ActionTop}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{x:Static res:GitHubAuthStrings.CancelSignInName}"
                        Command="{Binding CancelCommand}"
                        Content="{x:Static res:GitHubAuthStrings.CancelSignIn}"
                        Style="{StaticResource Button.Ghost}" />
            </StackPanel>
        </Border>

        <Border AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.Name="{Binding OutcomeName}"
                Style="{StaticResource DeviceCode.Outcome}"
                Visibility="{Binding ShowOutcome, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DeviceCode.OutcomeGlyph}" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Text.Label}"
                               Text="{Binding OutcomeTitle}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Margin="{StaticResource Thickness.StackGap}"
                           Style="{StaticResource Text.Body}"
                           Text="{Binding OutcomeMessage}"
                           TextWrapping="Wrap" />
                <WrapPanel Margin="{StaticResource Thickness.ActionTop}">
                    <Button Margin="{StaticResource Thickness.InlineGapLarge}"
                            AutomationProperties.Name="{Binding RetryLabel}"
                            Command="{Binding RetryCommand}"
                            Content="{Binding RetryLabel}"
                            Style="{StaticResource Button.Primary}"
                            Visibility="{Binding HasRetry, Converter={StaticResource BoolToVisibility}}"
                            b:FocusRouter.Key="DeviceOutcome" />
                    <Button Margin="{StaticResource Thickness.InlineGapLarge}"
                            AutomationProperties.Name="{x:Static res:GitHubAuthStrings.UsePatName}"
                            Command="{Binding UsePatCommand}"
                            Content="{x:Static res:GitHubAuthStrings.UsePat}"
                            Style="{StaticResource Button.Secondary}"
                            b:FocusRouter.Key="DeviceUsePat" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
