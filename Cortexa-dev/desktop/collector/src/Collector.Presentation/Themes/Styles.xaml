    <Style x:Key="FocusVisual.Default">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="{StaticResource Thickness.FocusMargin}"
                            BorderBrush="{DynamicResource Brush.Border.Focus}"
                            BorderThickness="{StaticResource Thickness.FocusRing}"
                            CornerRadius="{StaticResource Radius.Focus}"
                            IsHitTestVisible="False"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FocusVisual.Rail">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="{StaticResource Thickness.NavItemMargin}"
                            BorderBrush="{DynamicResource Brush.Rail.Indicator}"
                            BorderThickness="{StaticResource Thickness.FocusRing}"
                            CornerRadius="{StaticResource Radius.Control}"
                            IsHitTestVisible="False"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

