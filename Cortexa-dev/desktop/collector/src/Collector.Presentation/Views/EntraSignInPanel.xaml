<UserControl x:Class="Collector.Presentation.Views.EntraSignInPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Collector.Presentation.Behaviors"
             xmlns:res="clr-namespace:Collector.Presentation.Resources"
             Focusable="False"
             IsTabStop="False"
             Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="Entra.Outcome" TargetType="Border" BasedOn="{StaticResource DeviceCode.Outcome}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding OutcomeKind}" Value="UserCanceled">
                    <Setter Property="Background" Value="{DynamicResource Brush.Info.Surface}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Info.Border}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Entra.OutcomeGlyph" TargetType="TextBlock" BasedOn="{StaticResource DeviceCode.OutcomeGlyph}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding OutcomeKind}" Value="UserCanceled">
                    <Setter Property="Text" Value="{x:Static res:Glyphs.Info}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Info}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Entra.Connect" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="{StaticResource Thickness.ActionTop}" />
            <Setter Property="Content" Value="{x:Static res:RemoteSourceStrings.ConnectAndFind}" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Width="{StaticResource Size.LiveRegion}"
                   Height="{StaticResource Size.LiveRegion}"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="{Binding Announcement}"
                   Focusable="False"
                   Text="{Binding Announcement}" />

        <StackPanel Visibility="{Binding ShowStartActions, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Margin="{StaticResource Thickness.StackGap}"
                       Style="{StaticResource Text.Helper}"
                       Text="{x:Static res:EntraAuthStrings.SavedNote}" />
            <Button Margin="{StaticResource Thickness.StackGap}"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="{x:Static res:EntraAuthStrings.SignInName}"
                    Command="{Binding StartEntraSignInCommand}"
                    Content="{x:Static res:EntraAuthStrings.SignIn}"
                    Style="{StaticResource Button.Primary}"
                    b:FocusRouter.Key="EntraSignIn" />
            <Button HorizontalAlignment="Left"
                    AutomationProperties.Name="{x:Static res:EntraAuthStrings.CodeInsteadName}"
                    Command="{Binding StartEntraCodeSignInCommand}"
                    Content="{x:Static res:EntraAuthStrings.CodeInstead}"
                    Style="{StaticResource Button.Link}"
                    b:FocusRouter.Key="EntraCodeLink" />
        </StackPanel>

        <Border AutomationProperties.Name="{x:Static res:EntraAuthStrings.SigningIn}"
                Style="{StaticResource DeviceCode.Surface}"
                Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <ProgressBar Margin="{StaticResource Thickness.StackGap}"
                             AutomationProperties.Name="{x:Static res:EntraAuthStrings.SigningIn}"
                             Style="{StaticResource Progress.Thin}" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:EntraAuthStrings.SigningIn}" />
            </StackPanel>
        </Border>

        <Border AutomationProperties.Name="{x:Static res:EntraAuthStrings.CodePanelTitle}"
                Style="{StaticResource DeviceCode.Surface}"
                Visibility="{Binding IsDeviceCode, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Margin="{StaticResource Thickness.StackGap}"
                           AutomationProperties.HeadingLevel="Level3"
                           Style="{StaticResource Text.Subtitle}"
                           Text="{x:Static res:EntraAuthStrings.CodePanelTitle}" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{x:Static res:EntraAuthStrings.CodeStepCopy}" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding CodeStepOpenText}" />
                <TextBlock Margin="{StaticResource Thickness.StackGap}"
                           Style="{StaticResource Text.Body}"
                           Text="{x:Static res:EntraAuthStrings.CodeStepApprove}" />

                <TextBox Margin="{StaticResource Thickness.StackGap}"
                         AutomationProperties.HelpText="{Binding CodeStepOpenText}"
                         AutomationProperties.Name="{Binding UserCodeName}"
                         Style="{StaticResource DeviceCode.Text}"
                         Text="{Binding UserCode, Mode=OneWay}" />

                <WrapPanel Margin="{StaticResource Thickness.StackGap}">
                    <Button Margin="{StaticResource Thickness.InlineGapLarge}"
                            AutomationProperties.Name="{x:Static res:GitHubAuthStrings.CopyCodeName}"
                            Command="{Binding CopyCodeCommand}"
                            Style="{StaticResource Button.Secondary}"
                            b:FocusRouter.Key="EntraCopy">
                        <Grid>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsCopied, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Margin="{StaticResource Thickness.InlineGap}"
                                           Style="{StaticResource Text.Glyph}"
                                           Text="{x:Static res:Glyphs.Copy}" />
                                <AccessText Text="{x:Static res:EntraAuthStrings.CopyCode}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsCopied, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Margin="{StaticResource Thickness.InlineGap}"
                                           Foreground="{DynamicResource Brush.Success}"
                                           Style="{StaticResource Text.Glyph}"
                                           Text="{x:Static res:Glyphs.CheckMark}" />
                                <TextBlock Text="{x:Static res:GitHubAuthStrings.Copied}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Margin="{StaticResource Thickness.InlineGapLarge}"
                            AutomationProperties.Name="{Binding OpenBrowserName}"
                            Command="{Binding OpenBrowserCommand}"
                            Style="{StaticResource Button.Primary}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="{StaticResource Thickness.InlineGap}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Style="{StaticResource Text.Glyph}"
                                       Text="{x:Static res:Glyphs.OpenInNewWindow}" />
                            <AccessText Text="{x:Static res:EntraAuthStrings.OpenBrowser}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <Button HorizontalAlignment="Left"
                        AutomationProperties.Name="{Binding OpenBrowserName}"
                        Command="{Binding OpenBrowserCommand}"
                        Content="{Binding VerificationUrl}"
                        Style="{StaticResource Button.Link}" />

                <Border Margin="{StaticResource Thickness.StackGap}"
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="{Binding Notice, TargetNullValue=''}"
                        Style="{StaticResource InlineNotice.Warning}"
                        Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="{StaticResource Thickness.InlineGapLarge}"
                                   Foreground="{DynamicResource Brush.Warning}"
                                   Style="{StaticResource Text.Glyph}"
                                   Text="{x:Static res:Glyphs.Warning}" />
                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Notice}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ProgressBar Margin="{StaticResource Thickness.StackGap}"
                             AutomationProperties.Name="{x:Static res:EntraAuthStrings.Waiting}"
                             Style="{StaticResource Progress.Thin}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource Text.Caption}"
                               Text="{x:Static res:EntraAuthStrings.Waiting}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource DeviceCode.ClockGlyph}" />
                        <TextBlock AutomationProperties.LiveSetting="Off"
                                   AutomationProperties.Name="{Binding RemainingText}"
                                   Style="{StaticResource DeviceCode.Countdown}"
                                   Text="{Binding RemainingText}" />
                    </StackPanel>
                </Grid>

                <Button Margin="{StaticResource Thickness.ActionTop}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{x:Static res:EntraAuthStrings.CancelSignInName}"
                        Command="{Binding CancelCommand}"
                        Content="{x:Static res:GitHubAuthStrings.CancelSignIn}"
                        Style="{StaticResource Button.Ghost}" />
            </StackPanel>
        </Border>

        <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
            <Border Margin="{StaticResource Thickness.StackGapMedium}"
                    AutomationProperties.Name="{Binding SignedInLabel}"
                    Style="{StaticResource Auth.SignedIn}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="{StaticResource Thickness.InlineGapLarge}"
                                   Foreground="{DynamicResource Brush.Success}"
                                   Style="{StaticResource Text.Glyph}"
                                   Text="{x:Static res:Glyphs.Success}" />
                        <TextBlock Style="{StaticResource Text.Label}"
                                   Text="{Binding SignedInLabel}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Margin="{StaticResource Thickness.StackGap}"
                               Style="{StaticResource Text.Helper}"
                               Text="{x:Static res:GitHubAuthStrings.SignedInSaved}" />
                    <Button HorizontalAlignment="Left"
                            AutomationProperties.Name="{Binding SignOutAutomationName}"
                            Command="{Binding SignOutCommand}"
                            Content="{Binding SignOutText}"
                            Style="{StaticResource Button.Link}"
                            b:FocusRouter.Key="EntraSignOut" />
                </StackPanel>
            </Border>
            <Button AutomationProperties.Name="{x:Static res:RemoteSourceStrings.ConnectAndFindName}"
                    Command="{Binding ConnectCommand}"
                    Style="{StaticResource Entra.Connect}"
                    b:FocusRouter.Key="EntraConnect" />
        </StackPanel>

        <Border AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.Name="{Binding OutcomeName}"
                Style="{StaticResource Entra.Outcome}"
                Visibility="{Binding ShowOutcome, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Entra.OutcomeGlyph}" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Text.Label}"
                               Text="{Binding OutcomeTitle}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Margin="{StaticResource Thickness.StackGap}"
                           Style="{StaticResource Text.Body}"
                           Text="{Binding OutcomeMessage}"
                           TextWrapping="Wrap" />
                <WrapPanel Margin="{StaticResource Thickness.ActionTop}">
                    <Button Margin="{StaticResource Thickness.InlineGapLarge}"
                            AutomationProperties.Name="{Binding RetryLabel}"
                            Command="{Binding RetryCommand}"
                            Content="{Binding RetryLabel}"
                            Style="{StaticResource Button.Primary}"
                            Visibility="{Binding HasRetry, Converter={StaticResource BoolToVisibility}}"
                            b:FocusRouter.Key="EntraOutcome" />
                    <Button Margin="{StaticResource Thickness.InlineGapLarge}"
                            AutomationProperties.Name="{x:Static res:EntraAuthStrings.UsePatName}"
                            Command="{Binding UsePatCommand}"
                            Content="{x:Static res:EntraAuthStrings.UsePat}"
                            Style="{StaticResource Button.Secondary}"
                            b:FocusRouter.Key="EntraUsePat" />
                </WrapPanel>
                <Button Margin="{StaticResource Thickness.StackGap}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{x:Static res:EntraAuthStrings.CodeInsteadName}"
                        Command="{Binding StartEntraCodeSignInCommand}"
                        Content="{x:Static res:EntraAuthStrings.CodeInstead}"
                        Style="{StaticResource Button.Link}"
                        Visibility="{Binding ShowCodeFallback, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
