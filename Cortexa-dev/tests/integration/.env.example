# Base URL of the deployed api-gateway — no trailing slash.
CORTEXA_GATEWAY_BASE_URL=https://cortexa-dev-api-gateway.proudsmoke-86efe866.eastus.azurecontainerapps.io

# Short name of the Azure Key Vault (not the full URI).
CORTEXA_KEY_VAULT_NAME=cortexa-dev-kv

# Name of the Key Vault secret that holds the admin email address.
CORTEXA_ADMIN_EMAIL_SECRET=identity-admin-email

# Name of the Key Vault secret that holds the admin initial password.
CORTEXA_ADMIN_PASSWORD_SECRET=identity-admin-initial-password

# Azure AI model identifier passed to the pipeline. Must match a deployment
# that the model-router in the target environment is configured to accept.
CORTEXA_DEFAULT_AI_MODEL=gpt-4o

# Maximum seconds to wait for a full pipeline run before the test suite gives up.
CORTEXA_PIPELINE_TIMEOUT_S=600

# Seconds between status-poll attempts (linear start, 1.5x backoff, max 60 s).
CORTEXA_POLL_INTERVAL_S=15

# Optional: direct Cosmos DB connection string for evidence_bundles / verdicts
# container validation. Leave unset (or commented out) to skip Cosmos checks.
# Obtain the value from Key Vault secret "cosmos-primary-connection-string".
# CORTEXA_COSMOS_CONNECTION_STRING=AccountEndpoint=https://cortexa-dev-cosmos.documents.azure.com:443/;AccountKey=...
