# Base URL for the Cortexa API gateway.
# Dev: full URL with /api prefix (e.g. http://localhost:5000/api)
# Prod: relative path (/api) — SWA forwards /api/* to the linked backend WITH the /api prefix;
# the gateway uses UsePathBase("/api") to strip it before routing.
VITE_API_BASE_URL=

# Optional: application version shown in the footer.
# Set by CI at build time (e.g. git SHA or semver tag).
VITE_APP_VERSION=

# Microsoft Entra (OIDC) configuration for the Entra sign-in button.
# Tenant ID of your Azure AD tenant.
VITE_ENTRA_TENANT_ID=
# Client ID of the Cortexa SPA app registration.
VITE_ENTRA_CLIENT_ID=
# Redirect URI registered in the Entra app registration (e.g. http://localhost:5173/auth/callback).
# Defaults to window.location.origin at runtime if omitted.
VITE_ENTRA_REDIRECT_URI=
# API scope for the Cortexa access token (e.g. api://<client-id>/access_as_user).
VITE_ENTRA_API_SCOPE=

# Batch upload limits (US033). Defaults apply when unset.
# Maximum number of files allowed in a single batch upload.
VITE_MAX_BATCH_FILES=25
VITE_MAX_SAVED_REPOSITORIES_PER_BATCH=25
# Maximum combined size in bytes for all files in a single batch (default 200 MB).
VITE_MAX_BATCH_SIZE_BYTES=209715200
# Maximum size in bytes for a single file (default 50 MB).
VITE_MAX_FILE_SIZE_BYTES=52428800

# Job progress (US034)
# Polling interval in milliseconds for batch/document status updates.
VITE_JOB_POLL_INTERVAL_MS=2000

# Batch list polling (US034)
# Polling interval in milliseconds for the job history list.
VITE_BATCH_LIST_POLL_INTERVAL_MS=8000

# Batch cleanup (US089)
# Batches older than this many days are included in the "Incomplete" quick-filter.
VITE_CLEANUP_RETENTION_DAYS=7
