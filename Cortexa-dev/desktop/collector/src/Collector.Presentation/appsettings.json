{
  "Gateway": {
    "BaseUrl": "http://localhost:5080"
  },
  "CollectorServer": {
    "BaseUrl": "http://localhost:5091",
    "ReadTimeoutSeconds": 15,
    "ReadRetryDelaysMs": [ 500, 1500 ]
  },
  "Extraction": {
    "MaxParallelSplits": 4
  },
  "History": {
    "PollSeconds": 5,
    "TextEditorPath": "notepad.exe"
  },
  "Cache": {
    "DatabasePath": "%LOCALAPPDATA%/Cortexa/Collector/cache.db"
  },
  "Auth": {
    "RefreshSkewSeconds": 60,
    "MinRefreshDelaySeconds": 5,
    "HttpTimeoutSeconds": 30
  },
  "Ai": {
    "Provider": "Gemini",
    "Claude": {
      "Model": "claude-sonnet-5-5",
      "MaxOutputTokens": 8192,
      "Effort": "medium",
      "Thinking": "between_tools",
      "Concurrency": 4,
      "MaxRetries": 1,
      "TimeoutSeconds": 120
    },
    "Gemini": {
      "Model": "gemini-3.8-flash",
      "MaxOutputTokens": 8192,
      "Thinking": "low",
      "Concurrency": 4,
      "MaxRetries": 1,
      "TimeoutSeconds": 120
    },
    "Bedrock": {
      "SsoStartUrl": "https://example.awsapps.com/start",
      "SsoRegion": "us-east-1",
      "AccountId": "000000000000",
      "SsoRoleName": "CollectorBedrockAccess",
      "Region": "us-east-1",
      "Model": "us.anthropic.claude-sonnet-4-5-20250929-v1:0",
      "MaxOutputTokens": 8192,
      "Concurrency": 4,
      "MaxRetries": 1,
      "TimeoutSeconds": 120
    }
  },
  "RemoteSources": {
    "TimeoutSeconds": 20,
    "MaxPages": 50,
    "CacheRoot": "%LOCALAPPDATA%/Cortexa/Collector/remote",
    "GitHub": {
      "BaseUrl": "https://api.github.com",
      "ApiVersion": "2026-03-10",
      "MinRemaining": 50
    },
    "AzureDevOps": {
      "BaseUrl": "https://dev.azure.com",
      "ApiVersion": "7.1",
      "MinRemaining": 10,
      "MaxRateLimitRetries": 10
    },
    "Cortexa": {
      "GitHubClonesPath": "scan/github/clones",
      "AzureDevOpsClonesPath": "scan/azure-devops/clones",
      "DownloadTimeoutSeconds": 600,
      "ArchiveFolder": "_zips"
    },
    "Fetch": {
      "MaxSelectedFiles": 10000
    },
    "RateLimit": {
      "MaxPauseSeconds": 900,
      "MaxRetries": 3,
      "SecondaryWaitSeconds": 60,
      "MaxConcurrency": 4
    }
  },
  "Secrets": {
    "TargetPrefix": "Cortexa.Collector"
  },
  "UserSettings": {
    "Path": "%LOCALAPPDATA%/Cortexa/Collector/usersettings.json"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%LOCALAPPDATA%/Cortexa/Collector/logs/collector-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
