    <!-- Decorative tiles: icon tile for section headers, empty-state icon, avatar -->
    <Style x:Key="IconTile" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.SubtleBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Width="{StaticResource Size.IconTile}"
                            Height="{StaticResource Size.IconTile}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{StaticResource Thickness.Border}"
                            CornerRadius="{StaticResource Radius.Tile}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Icon}"
                                   FontSize="{StaticResource FontSize.Icon}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconTile.Danger" TargetType="ContentControl" BasedOn="{StaticResource IconTile}">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    </Style>

    <Style x:Key="EmptyIcon" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{StaticResource Thickness.StackGapMedium}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.SubtleBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.EmptyGlyph}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Width="{StaticResource Size.EmptyTile}"
                            Height="{StaticResource Size.EmptyTile}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{StaticResource Thickness.Border}"
                            CornerRadius="{StaticResource Radius.Chip}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Icon}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="EmptyIcon.Small" TargetType="ContentControl" BasedOn="{StaticResource EmptyIcon}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.PlaceholderGlyph}" />
    </Style>
    <Style x:Key="EmptyIcon.Warning" TargetType="ContentControl" BasedOn="{StaticResource EmptyIcon.Small}">
        <Setter Property="Background" Value="{DynamicResource Brush.Warning.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
    </Style>

    <Style x:Key="Avatar" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Width="{StaticResource Size.Avatar}"
                            Height="{StaticResource Size.Avatar}"
                            Background="{DynamicResource Brush.Brand}"
                            CornerRadius="{StaticResource Radius.Chip}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Body}"
                                   FontSize="{StaticResource FontSize.Caption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Brand.OnBrand}"
                                   Text="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BrandMark" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="{StaticResource Size.BrandMark}" />
        <Setter Property="Height" Value="{StaticResource Size.BrandMark}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{DynamicResource Brush.Brand}" CornerRadius="{StaticResource Radius.Tile}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Icon}"
                                   FontSize="{StaticResource FontSize.Icon}"
                                   Foreground="{DynamicResource Brush.Brand.OnBrand}"
                                   Text="{x:Static res:Glyphs.Lightbulb}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Label.Field" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.PageSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.LabelPadding}" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- Buttons -->
    <ControlTemplate x:Key="Button.Template" TargetType="Button">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.Control}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
        </Border>
    </ControlTemplate>

    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.ButtonPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource Button.Template}" />
    </Style>

    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Button.Edge}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Button}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Button.Edge}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Link" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.ControlPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Link}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Icon" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}" />
        <Setter Property="Width" Value="{StaticResource Size.IconHit}" />
        <Setter Property="Height" Value="{StaticResource Size.IconHit}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.IconSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Visual"
                                Width="{StaticResource Size.IconVisual}"
                                Height="{StaticResource Size.IconVisual}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Control}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Visual" Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text fields -->
    <ControlTemplate x:Key="Field.Template" TargetType="Control">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.Control}"
                SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{StaticResource Thickness.None}"
                          VerticalAlignment="Center"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
        </Border>
    </ControlTemplate>

    <Style x:Key="Field.Base" TargetType="Control">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.ControlPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource Field.Template}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Text.Body}" />
            </Trigger>
            <Trigger Property="b:FieldState.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                <Setter Property="BorderThickness" Value="{StaticResource Thickness.FocusRing}" />
                <Setter Property="Padding" Value="{StaticResource Thickness.ControlPaddingFocused}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                <Setter Property="BorderThickness" Value="{StaticResource Thickness.FocusRing}" />
                <Setter Property="Padding" Value="{StaticResource Thickness.ControlPaddingFocused}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TextBox.Field" TargetType="TextBox" BasedOn="{StaticResource Field.Base}">
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <Style x:Key="TextBox.Url" TargetType="TextBox" BasedOn="{StaticResource TextBox.Field}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Mono}" />
    </Style>

    <Style x:Key="PasswordBox.Field" TargetType="PasswordBox" BasedOn="{StaticResource Field.Base}">
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <Style x:Key="FormField" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="{StaticResource Thickness.FieldGap}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel>
                        <Label Content="{TemplateBinding Header}"
                               Target="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                               Style="{StaticResource Label.Field}" />
                        <ContentPresenter />
                        <TextBlock Margin="{StaticResource Thickness.HelperGap}"
                                   Style="{StaticResource Text.Helper}"
                                   Text="{Binding (b:FieldState.Helper), RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{Binding (b:FieldState.Helper), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NotEmptyToVisibility}}" />
                        <Grid Margin="{StaticResource Thickness.HelperGap}"
                              Visibility="{Binding (b:FieldState.Error), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NotEmptyToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Margin="{StaticResource Thickness.InlineGap}"
                                       VerticalAlignment="Top"
                                       Style="{StaticResource Text.Glyph.Error}"
                                       Text="{x:Static res:Glyphs.Error}" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource Text.Error}"
                                       Text="{Binding (b:FieldState.Error), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check box and chips -->
    <Style x:Key="CheckBox.Default" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}" />
        <Setter Property="MinWidth" Value="{StaticResource Size.RowAction}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.RowAction}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                            <Border x:Name="Box"
                                    Width="{StaticResource Size.CheckBox}"
                                    Height="{StaticResource Size.CheckBox}"
                                    Margin="{StaticResource Thickness.CheckBoxInset}"
                                    Background="{DynamicResource Brush.Surface.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Control}"
                                    BorderThickness="{StaticResource Thickness.Border}"
                                    CornerRadius="{StaticResource Radius.CheckBox}">
                                <TextBlock x:Name="Mark"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Font.Icon}"
                                           FontSize="{StaticResource FontSize.IconSmall}"
                                           Foreground="{DynamicResource Brush.Text.OnAccent}"
                                           Text="{x:Static res:Glyphs.CheckMark}"
                                           Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter x:Name="Caption"
                                              Margin="{StaticResource Thickness.LeadingGapSmall}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Caption" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Mark" Property="Text" Value="{x:Static res:Glyphs.Dash}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Text.Muted}" />
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterChip" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.RowAction}" />
        <Setter Property="Margin" Value="{StaticResource Thickness.InlineGap}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.PageSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Pill"
                                Height="{StaticResource Size.ChipVisual}"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Surface.Card}"
                                BorderBrush="{DynamicResource Brush.Border.Button}"
                                BorderThickness="{StaticResource Thickness.Border}"
                                CornerRadius="{StaticResource Radius.Control}"
                                Padding="{StaticResource Thickness.ChipPadding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock x:Name="Mark"
                                           Margin="{StaticResource Thickness.InlineGap}"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Font.Icon}"
                                           FontSize="{StaticResource FontSize.IconSmall}"
                                           Text="{x:Static res:Glyphs.CheckMark}"
                                           Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Pill" Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Link}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                            <Setter TargetName="Pill" Property="BorderThickness" Value="{StaticResource Thickness.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Pill" Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tags -->
    <Style x:Key="Tag.Surface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Tag}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.TagPadding}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Body}" />
    </Style>
    <Style x:Key="Tag.Surface.Warning" TargetType="Border" BasedOn="{StaticResource Tag.Surface}">
        <Setter Property="Background" Value="{DynamicResource Brush.Warning.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning.Border}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
    </Style>
    <Style x:Key="Tag.Surface.Danger" TargetType="Border" BasedOn="{StaticResource Tag.Surface}">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Border}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger.Text}" />
    </Style>
    <Style x:Key="Tag.Surface.Accent" TargetType="Border" BasedOn="{StaticResource Tag.Surface}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.SubtleBorder}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Link}" />
    </Style>
    <Style x:Key="Tag.Surface.Success" TargetType="Border" BasedOn="{StaticResource Tag.Surface}">
        <Setter Property="Background" Value="{DynamicResource Brush.Success.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success.Border}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
    </Style>
    <Style x:Key="Tag.Surface.Info" TargetType="Border" BasedOn="{StaticResource Tag.Surface}">
        <Setter Property="Background" Value="{DynamicResource Brush.Info.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Info.Border}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Info}" />
    </Style>
    <Style x:Key="Tag.State" TargetType="Border" BasedOn="{StaticResource Tag.Surface}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding StateKind}" Value="{x:Static vm:BatchState.InProgress}">
                <Setter Property="Background" Value="{DynamicResource Brush.Info.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Info.Border}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Info}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StateKind}" Value="{x:Static vm:BatchState.Completed}">
                <Setter Property="Background" Value="{DynamicResource Brush.Success.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success.Border}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StateKind}" Value="{x:Static vm:BatchState.Failed}">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Border}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Tag.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.IconSmall}" />
        <Setter Property="Margin" Value="{StaticResource Thickness.TagGlyphGap}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Tag.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Banner.Slot" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="{StaticResource Thickness.StackGapMedium}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                <Setter Property="Margin" Value="{StaticResource Thickness.None}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Surfaces -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.CardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Kpi.Tile" TargetType="Border">
        <Setter Property="MinWidth" Value="{StaticResource Size.KpiMinWidth}" />
        <Setter Property="Margin" Value="{StaticResource Thickness.KpiGap}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.KpiPadding}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Kpi.Tile.Sunken" TargetType="Border" BasedOn="{StaticResource Kpi.Tile}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="Progress.Thin" TargetType="ProgressBar">
        <Setter Property="Height" Value="{StaticResource Size.Progress}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.None}" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Progress}" />
                        <Grid x:Name="PART_Indicator" HorizontalAlignment="Left" ClipToBounds="True">
                            <Border x:Name="Fill"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{StaticResource Radius.Progress}" />
                            <Border x:Name="PART_GlowRect"
                                    Width="{StaticResource Size.ProgressRunner}"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{StaticResource Radius.Progress}"
                                    Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="Fill" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_GlowRect" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource Size.Divider}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
    </Style>

    <!-- Navigation rail -->
    <Style x:Key="Nav.Glyph" TargetType="TextBlock" BasedOn="{StaticResource Text.Glyph}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Rail.Text.Muted}" />
        <Setter Property="Margin" Value="{StaticResource Thickness.InlineGapLarge}" />
    </Style>
    <Style x:Key="Nav.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Rail.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Nav.Lock" TargetType="TextBlock" BasedOn="{StaticResource Text.Glyph}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.IconSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Rail.Text.Disabled}" />
        <Setter Property="Margin" Value="{StaticResource Thickness.LeadingGapSmall}" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>
    <Style x:Key="Nav.Indicator" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource Size.NavIndicator}" />
        <Setter Property="Height" Value="{StaticResource Size.NavIndicatorHeight}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Bar}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Rail.Indicator}" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="NavRail.Item" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rail}" />
        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="ToolTipService.Placement" Value="Right" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding HelpText}" />
        <Setter Property="b:CommandBehaviors.ActivateCommand" Value="{Binding ActivateCommand}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="Root"
                          Height="{StaticResource Size.NavItem}"
                          Margin="{StaticResource Thickness.NavItemMargin}"
                          Background="Transparent"
                          SnapsToDevicePixels="True">
                        <Border x:Name="Highlight" CornerRadius="{StaticResource Radius.Control}" />
                        <Border x:Name="Indicator" Style="{StaticResource Nav.Indicator}" />
                        <StackPanel Margin="{StaticResource Thickness.NavItemPadding}"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBlock x:Name="GlyphText" Style="{StaticResource Nav.Glyph}" Text="{Binding Glyph}" />
                            <TextBlock x:Name="Label"
                                       Style="{StaticResource Nav.Label}"
                                       Text="{Binding Title}"
                                       Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock x:Name="LockGlyph" Style="{StaticResource Nav.Lock}" Text="{x:Static res:Glyphs.Lock}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ShowLock}" Value="True" />
                                <Condition Binding="{Binding ShowLabel}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="LockGlyph" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource Brush.Rail.Hover}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Rail.Text.Selected}" />
                            <Setter TargetName="GlyphText" Property="Foreground" Value="{DynamicResource Brush.Rail.Text}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource Brush.Rail.Selected}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Rail.Text.Selected}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="GlyphText" Property="Foreground" Value="{DynamicResource Brush.Rail.Text.Selected}" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Rail.Text.Disabled}" />
                            <Setter TargetName="GlyphText" Property="Foreground" Value="{DynamicResource Brush.Rail.Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavRail" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.None}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavRail.Item}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List rows -->
    <Style x:Key="Row.Text.Base" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnSelected}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnSelected}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnSelected}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Row.Title" TargetType="TextBlock" BasedOn="{StaticResource Row.Text.Base}" />
    <Style x:Key="Row.Body" TargetType="TextBlock" BasedOn="{StaticResource Row.Text.Base}">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.PageSubtitle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="LineHeight" Value="{StaticResource Size.SummaryLineHeight}" />
        <Setter Property="MaxHeight" Value="{StaticResource Size.SummaryMaxHeight}" />
    </Style>
    <Style x:Key="Row.Caption" TargetType="TextBlock" BasedOn="{StaticResource Row.Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    </Style>
    <Style x:Key="Row.Source" TargetType="TextBlock" BasedOn="{StaticResource Row.Caption}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFileSource}" Value="True">
                <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                <Setter Property="FontSize" Value="{StaticResource FontSize.MonoSmall}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnSelected}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnSelected}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TextBox.Readonly" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.None}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.None}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.MonoSmall}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Focusable="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Disabled" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="List.Row" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding HelpText}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource Thickness.None}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Highlight" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Indicator"
                                Width="{StaticResource Size.NavIndicator}"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.Accent}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="List.Master" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.None}" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource List.Row}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!-- History stage stepper -->
    <Style x:Key="Step.Glyph" TargetType="TextBlock" BasedOn="{StaticResource Text.Glyph}">
        <Setter Property="Text" Value="{x:Static res:Glyphs.CircleRing}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Border.Control}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.Done}">
                <Setter Property="Text" Value="{x:Static res:Glyphs.Success}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.Current}">
                <Setter Property="Text" Value="{x:Static res:Glyphs.RadioBtnOn}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.NotUsed}">
                <Setter Property="Text" Value="{x:Static res:Glyphs.Dash}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.Failed}">
                <Setter Property="Text" Value="{x:Static res:Glyphs.Error}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.Cancelled}">
                <Setter Property="Text" Value="{x:Static res:Glyphs.Close}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Step.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Step.Count" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Step.Connector" TargetType="Border" BasedOn="{StaticResource Divider}">
        <Setter Property="Height" Value="{StaticResource Size.Progress}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Progress}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{StaticResource Thickness.InlineGap}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.Done}">
                <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Metric.Value" TargetType="TextBlock" BasedOn="{StaticResource Row.Text.Base}">
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.BodyLarge}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsNull}" Value="True">
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Metric.Label" TargetType="TextBlock" BasedOn="{StaticResource Row.Caption}">
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style x:Key="Candidate.Expander" TargetType="Expander">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="{StaticResource Thickness.BottomBorder}">
                        <StackPanel>
                            <ToggleButton MinHeight="{StaticResource Size.RowMin}"
                                          Padding="{StaticResource Thickness.ItemPadding}"
                                          AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                                          Cursor="Hand"
                                          FocusVisualStyle="{StaticResource FocusVisual.Default}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          KeyboardNavigation.AcceptsReturn="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Surface"
                                                Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Control}"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Chevron"
                                                           Margin="{StaticResource Thickness.InlineGapLarge}"
                                                           VerticalAlignment="Center"
                                                           FontSize="{StaticResource FontSize.IconSmall}"
                                                           Style="{StaticResource Text.Glyph}"
                                                           Text="{x:Static res:Glyphs.ChevronRight}" />
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                                <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource Brush.Text.OnSelected}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="{x:Static res:Glyphs.ChevronDown}" />
                                                <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header" />
                            </ToggleButton>
                            <ContentPresenter x:Name="Body"
                                              Margin="{StaticResource Thickness.LinkIndent}"
                                              Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit control templates: tooltip, scroll bar, combo box -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Brush.Tooltip.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Tooltip.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.TooltipPadding}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MaxWidth" Value="{StaticResource Size.TooltipMaxWidth}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="{StaticResource Thickness.None}"
                            CornerRadius="{StaticResource Radius.Tag}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar"
                            Margin="{StaticResource Thickness.ScrollThumbInset}"
                            Background="{DynamicResource Brush.ScrollThumb}"
                            CornerRadius="{StaticResource Radius.Scroll}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.ScrollThumb.Hover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.ScrollThumb.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBar.Page" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="{StaticResource Size.ScrollBar}" />
        <Setter Property="MinWidth" Value="{StaticResource Size.ScrollBar}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBar.Page}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="{StaticResource Size.ScrollThumbMin}" Style="{StaticResource ScrollBar.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBar.Page}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="{StaticResource Size.ScrollBar}" />
                <Setter Property="MinHeight" Value="{StaticResource Size.ScrollBar}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollBar.Page}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb MinWidth="{StaticResource Size.ScrollThumbMin}" Style="{StaticResource ScrollBar.Thumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollBar.Page}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.ListItemPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Surface"
                            Background="Transparent"
                            CornerRadius="{StaticResource Radius.Tag}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Link}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ComboBox.Toggle" TargetType="ToggleButton">
        <Border x:Name="Chrome"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.Control}"
                SnapsToDevicePixels="True">
            <TextBlock x:Name="Chevron"
                       Margin="{StaticResource Thickness.ComboChevron}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource Font.Icon}"
                       FontSize="{StaticResource FontSize.IconSmall}"
                       Foreground="{DynamicResource Brush.Text.Body}"
                       Text="{x:Static res:Glyphs.ChevronDown}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="MaxDropDownHeight" Value="{StaticResource Size.ComboPopupMax}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <ToggleButton x:Name="Toggle"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      ClickMode="Press"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Template="{StaticResource ComboBox.Toggle}" />
                        <ContentPresenter x:Name="ContentSite"
                                          Margin="{StaticResource Thickness.ComboContent}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               HorizontalOffset="-8"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Grid MinWidth="{Binding ActualWidth, ElementName=Toggle}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                  Margin="{StaticResource Thickness.PopupRoom}">
                                <Border Background="{DynamicResource Brush.Surface.Card}"
                                        CornerRadius="{StaticResource Radius.Control}"
                                        Effect="{DynamicResource Effect.Elevation.High}" />
                                <Border Background="{DynamicResource Brush.Surface.Card}"
                                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                        BorderThickness="{StaticResource Thickness.Border}"
                                        CornerRadius="{StaticResource Radius.Control}"
                                        Padding="{StaticResource Thickness.PopupPadding}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Brush.Text.Body}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                            <Setter TargetName="Toggle" Property="BorderThickness" Value="{StaticResource Thickness.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Toggle" Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Source collectors: source cards, stepper, step prompt, numbered sections, segmented toggles, cards -->
    <Style x:Key="FocusVisual.Inset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="{StaticResource Thickness.FocusMarginInset}"
                            BorderBrush="{DynamicResource Brush.Border.Focus}"
                            BorderThickness="{StaticResource Thickness.FocusRing}"
                            CornerRadius="{StaticResource Radius.Control}"
                            IsHitTestVisible="False"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SourceCard" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}" />
        <Setter Property="Margin" Value="{StaticResource Thickness.GridCell.Section}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.SourceCardMinHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Card"
                            Padding="{StaticResource Thickness.SourceCardPadding}"
                            Background="{DynamicResource Brush.Surface.Card}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="{StaticResource Thickness.Border}"
                            CornerRadius="{StaticResource Radius.Card}"
                            Effect="{DynamicResource Effect.Elevation.Low}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <StackPanel>
                                <Border Width="{StaticResource Size.IconTile}"
                                        Height="{StaticResource Size.IconTile}"
                                        Margin="{StaticResource Thickness.StackGap}"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource Brush.Accent.Subtle}"
                                        CornerRadius="{StaticResource Radius.Tile}">
                                    <TextBlock HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text.Link}"
                                               Style="{StaticResource Text.Glyph}"
                                               Text="{Binding IconGlyph}" />
                                </Border>
                                <ContentPresenter x:Name="Title"
                                                  Margin="{StaticResource Thickness.HelperGap}"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <TextBlock x:Name="Description"
                                           Margin="{StaticResource Thickness.HelperGap}"
                                           Style="{StaticResource Text.Helper}"
                                           Text="{Binding Description}" />
                            </StackPanel>
                            <Border x:Name="Check"
                                    Width="{StaticResource Size.SelectionCheck}"
                                    Height="{StaticResource Size.SelectionCheck}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Brush.Accent}"
                                    CornerRadius="{StaticResource Radius.Chip}"
                                    Visibility="Collapsed">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Font.Icon}"
                                           FontSize="{StaticResource FontSize.IconSmall}"
                                           Foreground="{DynamicResource Brush.Text.OnAccent}"
                                           Text="{x:Static res:Glyphs.CheckMark}" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Card" Property="BorderThickness" Value="{StaticResource Thickness.FocusRing}" />
                            <Setter TargetName="Card" Property="Padding" Value="{StaticResource Thickness.SourceCardPaddingChecked}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="Title" Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter TargetName="Description" Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings revamp: section navigation, section headers, provider cards, readiness chip, mono combo, model line -->
    <Style x:Key="SettingsSection.Header" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource Thickness.SectionHeader}" />
    </Style>
    <Style x:Key="SettingsSection.Divider" TargetType="Border">
        <Setter Property="Margin" Value="{StaticResource Thickness.FieldGap}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.BottomBorder}" />
    </Style>

    <Style x:Key="SectionNav.Item" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="Root"
                          Height="{StaticResource Size.NavItem}"
                          Margin="{StaticResource Thickness.SectionNavItemMargin}"
                          Background="Transparent"
                          SnapsToDevicePixels="True">
                        <Border x:Name="Highlight" CornerRadius="{StaticResource Radius.Control}" />
                        <Border x:Name="Indicator"
                                Background="{DynamicResource Brush.SectionNav.Indicator}"
                                Style="{StaticResource Nav.Indicator}" />
                        <Grid Margin="{StaticResource Thickness.NavItemPadding}" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource GridLength.SectionNavGlyph}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GlyphText"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       Style="{StaticResource Text.Glyph}"
                                       Text="{Binding Glyph}" />
                            <TextBlock x:Name="Label"
                                       Grid.Column="1"
                                       Margin="{StaticResource Thickness.LeadingGap}"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Body}"
                                       FontSize="{StaticResource FontSize.Body}"
                                       Foreground="{DynamicResource Brush.Text.Body}"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text.OnSelected}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="GlyphText" Property="Foreground" Value="{DynamicResource Brush.SectionNav.Glyph.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="b:FocusRouter.Key" Value="{x:Static vm:SettingsFocusKeys.Sections}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SectionNav" TargetType="ListBox" BasedOn="{StaticResource NavRail}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource SectionNav.Item}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="IconTile.Monogram" TargetType="ContentControl" BasedOn="{StaticResource IconTile}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Width="{StaticResource Size.IconTile}"
                            Height="{StaticResource Size.IconTile}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{StaticResource Thickness.Border}"
                            CornerRadius="{StaticResource Radius.Tile}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="{StaticResource FontSize.Subtitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ReadinessChip" TargetType="Border" BasedOn="{StaticResource Tag.Surface}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Readiness}" Value="{x:Static svc:ProviderReadinessState.Ready}">
                <Setter Property="Background" Value="{DynamicResource Brush.Success.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success.Border}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Readiness}" Value="{x:Static svc:ProviderReadinessState.Missing}">
                <Setter Property="Background" Value="{DynamicResource Brush.Warning.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning.Border}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Readiness}" Value="{x:Static svc:ProviderReadinessState.Unknown}">
                <Setter Property="Background" Value="{DynamicResource Brush.Warning.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning.Border}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ReadinessChip.Glyph" TargetType="TextBlock" BasedOn="{StaticResource Tag.Glyph}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Readiness}" Value="{x:Static svc:ProviderReadinessState.Ready}">
                <Setter Property="Text" Value="{x:Static res:Glyphs.Success}" />
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Readiness}" Value="{x:Static svc:ProviderReadinessState.Missing}">
                <Setter Property="Text" Value="{x:Static res:Glyphs.Warning}" />
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Readiness}" Value="{x:Static svc:ProviderReadinessState.Unknown}">
                <Setter Property="Text" Value="{x:Static res:Glyphs.Warning}" />
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ComboBoxItem.Mono" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Mono}" />
    </Style>

    <Style x:Key="ComboBox.Mono" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Mono}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItem.Mono}" />
    </Style>

    <Style x:Key="ModelLine" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.ModelLinePadding}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.ModelLineMin}" />
        <Setter Property="Margin" Value="{StaticResource Thickness.StackGapMedium}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="ProviderCard" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}" />
        <Setter Property="Margin" Value="{StaticResource Thickness.GridCell.Repo}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.ProviderCardMinHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Card"
                            Padding="{StaticResource Thickness.SourceCardPadding}"
                            Background="{DynamicResource Brush.Surface.Card}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="{StaticResource Thickness.Border}"
                            CornerRadius="{StaticResource Radius.Card}"
                            Effect="{DynamicResource Effect.Elevation.Low}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <StackPanel>
                                <ContentControl Margin="{StaticResource Thickness.StackGap}"
                                                HorizontalAlignment="Left"
                                                Content="{Binding Monogram}"
                                                Style="{StaticResource IconTile.Monogram}" />
                                <TextBlock Margin="{StaticResource Thickness.HelperGap}"
                                           FontFamily="{StaticResource Font.Body}"
                                           FontSize="{StaticResource FontSize.Body}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           Text="{Binding Title}" />
                                <TextBlock Margin="{StaticResource Thickness.HelperGap}"
                                           Style="{StaticResource Text.Helper}"
                                           Text="{Binding Description}" />
                                <Border Margin="{StaticResource Thickness.ActionTop}" Style="{StaticResource ReadinessChip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource ReadinessChip.Glyph}" />
                                        <TextBlock Style="{StaticResource Tag.Label}" Text="{Binding ChipText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Border x:Name="Check"
                                    Width="{StaticResource Size.SelectionCheck}"
                                    Height="{StaticResource Size.SelectionCheck}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Brush.Accent}"
                                    CornerRadius="{StaticResource Radius.Chip}"
                                    Visibility="Collapsed">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Font.Icon}"
                                           FontSize="{StaticResource FontSize.IconSmall}"
                                           Foreground="{DynamicResource Brush.Text.OnAccent}"
                                           Text="{x:Static res:Glyphs.CheckMark}" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Card" Property="BorderThickness" Value="{StaticResource Thickness.FocusRing}" />
                            <Setter TargetName="Card" Property="Padding" Value="{StaticResource Thickness.SourceCardPaddingChecked}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="b:FocusRouter.Key" Value="{x:Static vm:AiModelFocusKeys.CheckedCard}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Stepper.Bar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.StepperPadding}" />
    </Style>

    <Style x:Key="Stepper.Connector" TargetType="Border" BasedOn="{StaticResource Divider}">
        <Setter Property="Height" Value="{StaticResource Size.StepConnector}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Progress}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{StaticResource Thickness.ConnectorGap}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDone}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Stepper.Item" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="MinWidth" Value="{StaticResource Size.StepMinWidth}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Border x:Name="Badge"
                                    Width="{StaticResource Size.StepBadge}"
                                    Height="{StaticResource Size.StepBadge}"
                                    Margin="{StaticResource Thickness.InlineGapLarge}"
                                    Background="{DynamicResource Brush.Surface.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Control}"
                                    BorderThickness="{StaticResource Thickness.Border}"
                                    CornerRadius="{StaticResource Radius.Chip}">
                                <Grid>
                                    <TextBlock x:Name="Number"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource Font.Body}"
                                               FontSize="{StaticResource FontSize.PageSubtitle}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               Text="{Binding Number}" />
                                    <TextBlock x:Name="Mark"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource Font.Icon}"
                                               FontSize="{StaticResource FontSize.IconSmall}"
                                               Foreground="{DynamicResource Brush.Text.OnAccent}"
                                               Text="{x:Static res:Glyphs.CheckMark}"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="Title"
                                       MaxWidth="{StaticResource Size.StepDetailMax}"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Body}"
                                       FontSize="{StaticResource FontSize.PageSubtitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Badge" Property="BorderThickness" Value="{StaticResource Thickness.FocusRing}" />
                            <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Brush.Text.Link}" />
                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Cursor" Value="Arrow" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsUpcoming}" Value="True">
                <Setter Property="Cursor" Value="Arrow" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StepPrompt" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource Thickness.StepPromptPadding}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Info.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Info.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    </Style>
    <Style x:Key="StepPrompt.Bar" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource Size.BannerBar}" />
        <Setter Property="Margin" Value="{StaticResource Thickness.BannerBar}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Bar}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style x:Key="StepPrompt.Overline" TargetType="TextBlock" BasedOn="{StaticResource Text.Overline}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Link}" />
    </Style>

    <Style x:Key="Badge.Number" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource Size.NumberBadge}" />
        <Setter Property="Height" Value="{StaticResource Size.NumberBadge}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.SubtleBorder}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="{StaticResource Thickness.InlineGapLarge}" />
    </Style>
    <Style x:Key="Badge.Number.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Link}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="NumberedSectionCard" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="{StaticResource Thickness.GridCell.Section}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Padding="{StaticResource Thickness.SectionCardPadding}"
                            Background="{DynamicResource Brush.Surface.Card}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="{StaticResource Thickness.Border}"
                            CornerRadius="{StaticResource Radius.Card}">
                        <StackPanel>
                            <Grid Margin="{StaticResource Thickness.StackGapMedium}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Badge.Number}">
                                    <TextBlock Style="{StaticResource Badge.Number.Label}" Text="{TemplateBinding Tag}" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontFamily="{StaticResource Font.Display}"
                                               FontSize="{StaticResource FontSize.Brand}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               Text="{TemplateBinding Header}"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontSize="{StaticResource FontSize.PageSubtitle}"
                                               Style="{StaticResource Text.Helper}"
                                               Text="{Binding (b:FieldState.Helper), RelativeSource={RelativeSource TemplatedParent}}" />
                                </StackPanel>
                            </Grid>
                            <ContentPresenter />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentedToggle.Track" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.SegmentTrack}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="SegmentedToggle" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Inset}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.SegmentHeight}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.SegmentPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.PageSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Margin="{StaticResource Thickness.SegmentHit}" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Segment"
                                MinHeight="{TemplateBinding MinHeight}"
                                Margin="{StaticResource Thickness.SegmentInset}"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="{StaticResource Thickness.Border}"
                                CornerRadius="{StaticResource Radius.Tag}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Segment" Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
                            <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource Brush.Border.Button}" />
                            <Setter TargetName="Segment" Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Segment" Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RepoCard" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}" />
        <Setter Property="Margin" Value="{StaticResource Thickness.GridCell.Repo}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.RepoCardPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Card"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BranchRow" TargetType="Button" BasedOn="{StaticResource RepoCard}">
        <Setter Property="MinHeight" Value="{StaticResource Size.BranchRowMin}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.BranchRowPadding}" />
        <Setter Property="Margin" Value="{StaticResource Thickness.BranchRowGap}" />
    </Style>

    <Style x:Key="Button.Reveal" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}" />
        <Setter Property="Width" Value="{StaticResource Size.IconHit}" />
        <Setter Property="Height" Value="{StaticResource Size.IconHit}" />
        <Setter Property="Margin" Value="{StaticResource Thickness.RevealOverlay}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Icon}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Content" Value="{x:Static res:Glyphs.View}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Visual"
                                Width="{StaticResource Size.IconVisual}"
                                Height="{StaticResource Size.IconVisual}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Control}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Visual" Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content" Value="{x:Static res:Glyphs.Hide}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Link}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TextBox.Field.Trail" TargetType="TextBox" BasedOn="{StaticResource TextBox.Field}">
        <Setter Property="Padding" Value="{StaticResource Thickness.FieldTrail}" />
        <Style.Triggers>
            <Trigger Property="b:FieldState.HasError" Value="True">
                <Setter Property="Padding" Value="{StaticResource Thickness.FieldTrailFocused}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Padding" Value="{StaticResource Thickness.FieldTrailFocused}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PasswordBox.Field.Trail" TargetType="PasswordBox" BasedOn="{StaticResource PasswordBox.Field}">
        <Setter Property="Padding" Value="{StaticResource Thickness.FieldTrail}" />
        <Style.Triggers>
            <Trigger Property="b:FieldState.HasError" Value="True">
                <Setter Property="Padding" Value="{StaticResource Thickness.FieldTrailFocused}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Padding" Value="{StaticResource Thickness.FieldTrailFocused}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
