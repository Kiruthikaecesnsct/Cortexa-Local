ASPNETCORE_URLS=http://localhost:5091
ASPNETCORE_ENVIRONMENT=Development

Cosmos__Endpoint=https://localhost:8081
Cosmos__Key=<cosmos-emulator-key-from-the-emulator-documentation>
Cosmos__ConnectionMode=Gateway
Cosmos__LimitToEndpoint=true
Cosmos__VerdictsContainer=verdicts
Cosmos__EvidenceBundlesContainer=evidence_bundles

Messaging__Provider=RabbitMq
Messaging__Topics__IngestionCompleted=ingestion-completed
Messaging__RabbitMq__HostName=localhost
Messaging__RabbitMq__Port=5672
Messaging__RabbitMq__VirtualHost=/
Messaging__RabbitMq__UserName=collector
Messaging__RabbitMq__Password=
Messaging__RabbitMq__ManagementUrl=http://localhost:15672

Messaging__ServiceBus__ConnectionString=
Messaging__ServiceBus__FullyQualifiedNamespace=

Identity__Issuer=cortexa-identity-dev
Identity__Audience=cortexa-dev
Identity__SigningKey=
Identity__BaseUrl=http://localhost:5081
Identity__InternalKey=
