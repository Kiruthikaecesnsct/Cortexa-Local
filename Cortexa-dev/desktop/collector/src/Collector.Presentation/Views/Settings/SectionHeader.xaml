<UserControl x:Class="Collector.Presentation.Views.SettingsSections.SectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsTabStop="False">
    <StackPanel>
        <Grid Style="{StaticResource SettingsSection.Header}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl Margin="{StaticResource Thickness.InlineGapLarge}"
                            VerticalAlignment="Top"
                            Content="{Binding Glyph, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource IconTile}" />
            <StackPanel Grid.Column="1">
                <TextBlock AutomationProperties.HeadingLevel="Level2"
                           Style="{StaticResource Text.Subtitle}"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock Style="{StaticResource Text.Helper}"
                           Text="{Binding Intro, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>
        </Grid>
        <Border Style="{StaticResource SettingsSection.Divider}" />
    </StackPanel>
</UserControl>
