<UserControl x:Class="Collector.Presentation.Views.ExtractionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Collector.Presentation.Behaviors"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:enums="clr-namespace:Collector.Domain.Enums;assembly=Collector.Domain"
             xmlns:res="clr-namespace:Collector.Presentation.Resources"
             xmlns:views="clr-namespace:Collector.Presentation.Views"
             xmlns:vm="clr-namespace:Collector.Presentation.ViewModels"
             b:FocusRouter.IsHost="True"
             Focusable="False"
             IsTabStop="False">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelActiveWorkCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <views:EnumMatchConverter x:Key="EnumMatch" />

        <Style x:Key="StatusBadge.Surface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}" />
            <Setter Property="Padding" Value="{StaticResource Thickness.ChipPadding}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:DocumentStatus.Extracting}">
                    <Setter Property="Background" Value="{DynamicResource Brush.Info.Surface}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:DocumentStatus.Extracted}">
                    <Setter Property="Background" Value="{DynamicResource Brush.Success.Surface}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:DocumentStatus.Failed}">
                    <Setter Property="Background" Value="{DynamicResource Brush.Danger.Surface}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:DocumentStatus.Excluded}">
                    <Setter Property="Background" Value="{DynamicResource Brush.Warning.Surface}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusBadge.Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.IconSmall}" />
            <Setter Property="Margin" Value="{StaticResource Thickness.InlineGap}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Text" Value="{x:Static res:Glyphs.Clock}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:DocumentStatus.Extracting}">
                    <Setter Property="Text" Value="{x:Static res:Glyphs.Refresh}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:DocumentStatus.Extracted}">
                    <Setter Property="Text" Value="{x:Static res:Glyphs.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:DocumentStatus.Failed}">
                    <Setter Property="Text" Value="{x:Static res:Glyphs.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:DocumentStatus.Excluded}">
                    <Setter Property="Text" Value="{x:Static res:Glyphs.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KindChip.Surface" TargetType="Border" BasedOn="{StaticResource Tag.Surface}" />
        <Style x:Key="KindChip.Glyph" TargetType="TextBlock" BasedOn="{StaticResource Text.Glyph}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.IconSmall}" />
            <Setter Property="Text" Value="{x:Static res:Glyphs.Document}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding UnitKind}" Value="{x:Static enums:UnitKind.Section}">
                    <Setter Property="Text" Value="{x:Static res:Glyphs.BulletedList}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding UnitKind}" Value="{x:Static enums:UnitKind.Module}">
                    <Setter Property="Text" Value="{x:Static res:Glyphs.Code}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <StackPanel>

        <TextBlock Margin="{StaticResource Thickness.StackGap}"
                   Style="{StaticResource Text.Overline}"
                   Text="{x:Static res:ExtractionStrings.SourceLabel}" />
        <Grid Margin="{StaticResource Thickness.StackGapMedium}">
            <ItemsControl Margin="{StaticResource Thickness.GridBleed.Section}"
                          AutomationProperties.Name="{x:Static res:RemoteSourceStrings.SourceGroupName}"
                          Focusable="False"
                          IsEnabled="{Binding Remote.AreControlsEnabled}"
                          IsTabStop="False"
                          ItemsSource="{Binding SourceCards}"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.TabNavigation="Once">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Columns.SourceCards}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SourceCardViewModel}">
                        <RadioButton AutomationProperties.HelpText="{Binding Description}"
                                     AutomationProperties.Name="{Binding Title}"
                                     GroupName="ExtractionSource"
                                     IsChecked="{Binding IsSelected}"
                                     Style="{StaticResource SourceCard}">
                            <AccessText Text="{Binding AccessLabel}" TextWrapping="Wrap" />
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <ContentControl Content="{Binding Remote.Banner}" Style="{StaticResource Banner.Slot}" />

        <views:RemoteSourceView DataContext="{Binding Remote}"
                                Visibility="{Binding IsRemote, Converter={StaticResource BoolToVisibility}}" />

        <Border Style="{StaticResource Card}" Visibility="{Binding ShowLocalEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center">
                <ContentControl Content="{x:Static res:Glyphs.Document}" Style="{StaticResource EmptyIcon}" />
                <TextBlock Margin="{StaticResource Thickness.StackGap}"
                           HorizontalAlignment="Center"
                           AutomationProperties.HeadingLevel="Level2"
                           Style="{StaticResource Text.Subtitle}"
                           Text="{x:Static res:ExtractionStrings.EmptyTitle}" />
                <TextBlock Margin="{StaticResource Thickness.StackGapLarge}"
                           HorizontalAlignment="Center"
                           Style="{StaticResource Text.Body}"
                           Text="{x:Static res:ExtractionStrings.EmptyBody}"
                           TextAlignment="Center" />
                <Button HorizontalAlignment="Center"
                        AutomationProperties.Name="{x:Static res:ExtractionStrings.PickFilesName}"
                        Command="{Binding PickFilesCommand}"
                        Content="{x:Static res:ExtractionStrings.PickFiles}"
                        Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </Border>

        <Border Margin="{StaticResource Thickness.StackGapMedium}"
                AutomationProperties.Name="{x:Static res:ExtractionStrings.IntakeProgressName}"
                BorderBrush="{DynamicResource Brush.Accent.SubtleBorder}"
                DataContext="{Binding Intake}"
                Style="{StaticResource Card}"
                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Margin="{StaticResource Thickness.StackGap}"
                               Style="{StaticResource Text.Label}"
                               Text="{x:Static res:ExtractionStrings.IntakeCardTitle}" />
                    <ProgressBar Margin="{StaticResource Thickness.StackGap}"
                                 AutomationProperties.Name="{x:Static res:ExtractionStrings.IntakeProgressName}"
                                 IsIndeterminate="False"
                                 Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                                 Style="{StaticResource Progress.Thin}"
                                 Value="{Binding ProgressValue, Mode=OneWay}" />
                    <WrapPanel>
                        <TextBlock Margin="{StaticResource Thickness.InlineGapXL}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Style="{StaticResource Text.Body}"
                                   Text="{Binding FetchedText}"
                                   Visibility="{Binding HasFetchedText, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="{StaticResource Thickness.InlineGapXL}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Style="{StaticResource Text.Body}"
                                   Text="{Binding SplitText}"
                                   Visibility="{Binding HasSplitText, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <TextBlock AutomationProperties.LiveSetting="Off"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="{StaticResource FontSize.MonoSmall}"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               Text="{Binding CurrentFile}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               ToolTip="{Binding CurrentFile}"
                               Visibility="{Binding HasCurrentFile, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Margin="{StaticResource Thickness.LeadingGap}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static res:ExtractionStrings.IntakeCancelName}"
                        Command="{Binding CancelCommand}"
                        Content="{x:Static res:ExtractionStrings.Cancel}"
                        Style="{StaticResource Button.Secondary}"
                        b:FocusRouter.Key="IntakeCancel" />
            </Grid>
        </Border>

        <StackPanel Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisibility}}">

            <ContentControl Content="{Binding Knowledge.Banner}" Style="{StaticResource Banner.Slot}" />

            <Border AutomationProperties.Name="{Binding GroupName}"
                    DataContext="{Binding ActiveModel}"
                    Style="{StaticResource ModelLine}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Margin="{StaticResource Thickness.InlineGap}"
                                   Style="{StaticResource Text.Glyph}"
                                   Text="{x:Static res:Glyphs.Lightbulb}" />
                        <TextBlock Margin="{StaticResource Thickness.InlineGap}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Overline}"
                                   Text="{x:Static res:ExtractionStrings.ModelLineLabel}" />
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource Text.Label}"
                                   Text="{Binding ProviderName}" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   Style="{StaticResource Text.Body}"
                                   Text="{x:Static res:ExtractionStrings.ModelLineSeparator}" />
                        <TextBlock MaxWidth="{StaticResource Size.ModelIdMax}"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="{StaticResource FontSize.Mono}"
                                   Foreground="{DynamicResource Brush.Text.Body}"
                                   Text="{Binding Model}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   ToolTip="{Binding Model}" />
                        <Border Style="{StaticResource ReadinessChip}"
                                Visibility="{Binding ShowChip, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ReadinessChip.Glyph}" />
                                <TextBlock Style="{StaticResource Tag.Label}" Text="{Binding ChipText}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button AutomationProperties.Name="{Binding AddKeyName}"
                                Command="{Binding AddKeyCommand}"
                                Content="{Binding AddKeyText}"
                                Style="{StaticResource Button.Link}"
                                Visibility="{Binding ShowAddKey, Converter={StaticResource BoolToVisibility}}" />
                        <Button AutomationProperties.Name="{x:Static res:ExtractionStrings.ChangeInSettingsName}"
                                Command="{Binding ChangeCommand}"
                                Content="{x:Static res:ExtractionStrings.ChangeInSettings}"
                                Style="{StaticResource Button.Link}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="{StaticResource Thickness.StackGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Margin="{StaticResource Thickness.InlineGapLarge}"
                            AutomationProperties.Name="{x:Static res:ExtractionStrings.PickFilesName}"
                            Command="{Binding PickFilesCommand}"
                            Content="{x:Static res:ExtractionStrings.PickFiles}"
                            Style="{StaticResource Button.Secondary}" />
                    <Button AutomationProperties.Name="{x:Static res:ExtractionStrings.ClearAllName}"
                            Command="{Binding ClearAllCommand}"
                            Content="{x:Static res:ExtractionStrings.ClearAll}"
                            Style="{StaticResource Button.Link}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Text.Caption}"
                               Text="{Binding StatusCaption}" />
                    <Button Margin="{StaticResource Thickness.LeadingGap}"
                            AutomationProperties.HelpText="{Binding Knowledge.ExtractHelp, TargetNullValue={x:Static sys:String.Empty}}"
                            AutomationProperties.Name="{x:Static res:ExtractionStrings.ExtractKnowledgeName}"
                            Command="{Binding Knowledge.ExtractKnowledgeCommand}"
                            Content="{x:Static res:ExtractionStrings.ExtractKnowledge}"
                            Style="{StaticResource Button.Primary}"
                            ToolTip="{Binding Knowledge.ExtractHelp}"
                            ToolTipService.ShowOnDisabled="True" />
                </StackPanel>
            </Grid>

            <Border Margin="{StaticResource Thickness.StackGap}"
                    Style="{StaticResource Card}"
                    Visibility="{Binding Knowledge.IsRunning, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Margin="{StaticResource Thickness.StackGap}"
                                   Style="{StaticResource Text.Label}"
                                   Text="{x:Static res:ExtractionStrings.RunTitle}" />
                        <ProgressBar Margin="{StaticResource Thickness.StackGap}"
                                     AutomationProperties.Name="{x:Static res:ExtractionStrings.RunProgressName}"
                                     IsIndeterminate="False"
                                     Maximum="{Binding Knowledge.ProgressMaximum, Mode=OneWay}"
                                     Style="{StaticResource Progress.Thin}"
                                     Value="{Binding Knowledge.CompletedUnits, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Knowledge.ProgressText}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="{StaticResource Thickness.LeadingGap}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Static res:ExtractionStrings.CancelName}"
                            Command="{Binding Knowledge.ExtractKnowledgeCancelCommand}"
                            Content="{x:Static res:ExtractionStrings.Cancel}"
                            Style="{StaticResource Button.Secondary}"
                            b:FocusRouter.Key="Cancel" />
                </Grid>
            </Border>

            <WrapPanel Margin="{StaticResource Thickness.SectionTop}">
                <Border Style="{StaticResource Kpi.Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:ExtractionStrings.StatFiles}" />
                        <TextBlock Style="{StaticResource Text.Kpi}" Text="{Binding FilesCount}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi.Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:ExtractionStrings.StatAnalyzed}" />
                        <TextBlock Style="{StaticResource Text.Kpi}" Text="{Binding AnalyzedCount}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi.Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:ExtractionStrings.StatUnits}" />
                        <TextBlock Style="{StaticResource Text.Kpi}" Text="{Binding TotalUnits}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi.Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:ExtractionStrings.StatTokens}" />
                        <TextBlock Style="{StaticResource Text.Kpi}" Text="{Binding TotalTokens}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi.Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:ExtractionStrings.StatSkipped}" />
                        <TextBlock Style="{StaticResource Text.Kpi}" Text="{Binding SkippedCount}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border Margin="{StaticResource Thickness.SectionTop}"
                    Style="{StaticResource Card}"
                    ToolTip="{x:Static res:ExtractionStrings.EstimateApproximateNote}"
                    ToolTipService.ShowOnDisabled="True">
                <StackPanel>
                    <StackPanel Margin="{StaticResource Thickness.StackGapMedium}" Orientation="Horizontal">
                        <ContentControl Margin="{StaticResource Thickness.InlineGapLarge}" Content="{x:Static res:Glyphs.Info}" Style="{StaticResource IconTile}" />
                        <TextBlock AutomationProperties.HeadingLevel="Level2"
                                   Style="{StaticResource Text.Subtitle}"
                                   Text="{x:Static res:ExtractionStrings.EstimateTitle}" />
                    </StackPanel>
                    <WrapPanel>
                        <Border Style="{StaticResource Kpi.Tile.Sunken}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:ExtractionStrings.EstimatePrompt}" />
                                <TextBlock Style="{StaticResource Text.Kpi}" Text="{Binding PromptTokens}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Kpi.Tile.Sunken}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:ExtractionStrings.EstimateOutput}" />
                                <TextBlock Style="{StaticResource Text.Kpi}" Text="{Binding EstimatedOutputTokens}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Kpi.Tile.Sunken}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:ExtractionStrings.EstimateTotal}" />
                                <TextBlock Style="{StaticResource Text.Kpi}" Text="{Binding TotalEstimatedTokens}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <TextBlock Margin="{StaticResource Thickness.StackGap}"
                               Style="{StaticResource Text.Helper}"
                               Text="{x:Static res:ExtractionStrings.EstimateApproximateNote}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="{StaticResource Thickness.SectionTop}" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Margin="{StaticResource Thickness.StackGapMedium}" Orientation="Horizontal">
                        <ContentControl Margin="{StaticResource Thickness.InlineGapLarge}" Content="{x:Static res:Glyphs.Document}" Style="{StaticResource IconTile}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock AutomationProperties.HeadingLevel="Level2"
                                       Style="{StaticResource Text.Subtitle}"
                                       Text="{x:Static res:ExtractionStrings.DocumentsTitle}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:ExtractionStrings.DocumentsCaption}" />
                        </StackPanel>
                    </StackPanel>
                    <Grid Margin="{StaticResource Thickness.StackGapMedium}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                AutomationProperties.Name="{x:Static res:ExtractionStrings.FilterGroupName}"
                                Style="{StaticResource SegmentedToggle.Track}">
                            <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle"
                                        KeyboardNavigation.TabNavigation="Once"
                                        Orientation="Horizontal">
                                <RadioButton Content="{x:Static res:ExtractionStrings.FilterAll}"
                                             GroupName="DocumentStatusFilter"
                                             IsChecked="{Binding StatusFilter, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static vm:DocumentStatusFilter.All}}"
                                             Style="{StaticResource SegmentedToggle}" />
                                <RadioButton Content="{x:Static res:ExtractionStrings.FilterAnalyzed}"
                                             GroupName="DocumentStatusFilter"
                                             IsChecked="{Binding StatusFilter, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static vm:DocumentStatusFilter.Analyzed}}"
                                             Style="{StaticResource SegmentedToggle}" />
                                <RadioButton Content="{x:Static res:ExtractionStrings.FilterFailed}"
                                             GroupName="DocumentStatusFilter"
                                             IsChecked="{Binding StatusFilter, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static vm:DocumentStatusFilter.Failed}}"
                                             Style="{StaticResource SegmentedToggle}" />
                                <RadioButton Content="{x:Static res:ExtractionStrings.FilterSkipped}"
                                             GroupName="DocumentStatusFilter"
                                             IsChecked="{Binding StatusFilter, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static vm:DocumentStatusFilter.Skipped}}"
                                             Style="{StaticResource SegmentedToggle}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Margin="{StaticResource Thickness.LeadingGap}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"
                                   Style="{StaticResource Text.Caption}"
                                   Text="{Binding DocumentsShowingText}" />
                        <Grid Grid.Column="2" Width="{StaticResource Size.ToolbarSearchWidth}">
                            <TextBox Padding="{StaticResource Thickness.SearchPadding}"
                                     AutomationProperties.Name="{x:Static res:ExtractionStrings.SearchName}"
                                     Style="{StaticResource TextBox.Field}"
                                     Text="{Binding DocumentSearch, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{x:Static res:ExtractionStrings.SearchPlaceholder}"
                                     b:FocusRouter.Key="DocumentSearch" />
                            <TextBlock Margin="{StaticResource Thickness.SearchGlyph}"
                                       HorizontalAlignment="Right"
                                       IsHitTestVisible="False"
                                       Style="{StaticResource Text.Glyph}"
                                       Text="{x:Static res:Glyphs.Search}" />
                        </Grid>
                    </Grid>
                    <Grid>
                        <DataGrid AutomationProperties.Name="{x:Static res:ExtractionStrings.DocumentsGridName}"
                                  AutoGenerateColumns="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  CellStyle="{StaticResource DataGridCell.Default}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeader.Sortable}"
                                  EnableColumnVirtualization="True"
                                  EnableRowVirtualization="True"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  Height="{StaticResource Size.DocumentsTableHeight}"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding DocumentsView}"
                                  KeyboardNavigation.TabNavigation="Once"
                                  RowStyle="{StaticResource DataGridRow.Default}"
                                  SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Sorting="OnDocumentsSorting"
                                  Style="{StaticResource DataGrid.Documents}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.ScrollUnit="Item"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  b:FocusRouter.Key="Documents">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="2*"
                                                        MinWidth="160"
                                                        Header="{x:Static res:ExtractionStrings.ColumnName}"
                                                        SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:DocumentRowViewModel}">
                                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Filename}">
                                                <TextBlock Margin="{StaticResource Thickness.InlineGapLarge}"
                                                           Style="{StaticResource Text.Glyph}"
                                                           Text="{x:Static res:Glyphs.Document}" />
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="{StaticResource FontSize.PageSubtitle}"
                                                           Style="{StaticResource Text.Label}"
                                                           Text="{Binding Filename}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="2*"
                                                        Header="{x:Static res:ExtractionStrings.ColumnFolder}"
                                                        SortMemberPath="Folder">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:DocumentRowViewModel}">
                                            <TextBlock VerticalAlignment="Center"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="{StaticResource FontSize.MonoSmall}"
                                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                                       Text="{Binding Folder}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       ToolTip="{Binding Folder}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="{StaticResource Size.TableNumericColumn}"
                                                        Header="{x:Static res:ExtractionStrings.ColumnUnits}"
                                                        SortMemberPath="Units">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:DocumentRowViewModel}">
                                            <TextBlock HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="{StaticResource FontSize.Mono}"
                                                       Foreground="{DynamicResource Brush.Text.Body}"
                                                       Text="{Binding UnitCount, StringFormat={}{0:N0}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="{StaticResource Size.TableNumericColumn}"
                                                        Header="{x:Static res:ExtractionStrings.ColumnTokens}"
                                                        SortMemberPath="Tokens">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:DocumentRowViewModel}">
                                            <TextBlock HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="{StaticResource FontSize.Mono}"
                                                       Foreground="{DynamicResource Brush.Text.Body}"
                                                       Text="{Binding TokenCount, StringFormat={}{0:N0}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="{StaticResource Size.TableStatusColumn}"
                                                        Header="{x:Static res:ExtractionStrings.ColumnStatus}"
                                                        SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:DocumentRowViewModel}">
                                            <Border HorizontalAlignment="Left"
                                                    AutomationProperties.Name="{Binding StatusLabel}"
                                                    Style="{StaticResource StatusBadge.Surface}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource StatusBadge.Glyph}" />
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontFamily="{StaticResource Font.Body}"
                                                               FontSize="{StaticResource FontSize.Caption}"
                                                               Text="{Binding StatusLabel}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowNoDocumentMatch, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource Text.Helper}"
                                       Text="{x:Static res:ExtractionStrings.NoDocumentMatch}" />
                            <Button HorizontalAlignment="Center"
                                    Command="{Binding ClearDocumentFiltersCommand}"
                                    Content="{x:Static res:ExtractionStrings.ClearFilters}"
                                    Style="{StaticResource Button.Link}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="{StaticResource Thickness.SectionTop}" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Margin="{StaticResource Thickness.StackGapMedium}" Orientation="Horizontal">
                        <ContentControl Margin="{StaticResource Thickness.InlineGapLarge}" Content="{x:Static res:Glyphs.BulletedList}" Style="{StaticResource IconTile}" />
                        <StackPanel>
                            <TextBlock AutomationProperties.HeadingLevel="Level2"
                                       Style="{StaticResource Text.Subtitle}"
                                       Text="{x:Static res:ExtractionStrings.UnitPreviewTitle}" />
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Text="{Binding PreviewHeader}"
                                       Visibility="{Binding ShowPreviewUnits, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Visibility="{Binding ShowPreviewPlaceholder, Converter={StaticResource BoolToVisibility}}">
                        <ContentControl Content="{x:Static res:Glyphs.BulletedList}" Style="{StaticResource EmptyIcon.Small}" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Helper}" Text="{x:Static res:ExtractionStrings.PreviewEmptyBody}" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Visibility="{Binding ShowPreviewEmpty, Converter={StaticResource BoolToVisibility}}">
                        <ContentControl Content="{x:Static res:Glyphs.Warning}" Style="{StaticResource EmptyIcon.Warning}" />
                        <TextBlock HorizontalAlignment="Center"
                                   AutomationProperties.HeadingLevel="Level2"
                                   Style="{StaticResource Text.Label}"
                                   Text="{x:Static res:ExtractionStrings.PreviewEmptyTitle}" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Helper}" Text="{x:Static res:ExtractionStrings.PreviewEmptyBody}" />
                    </StackPanel>

                    <ProgressBar Margin="{StaticResource Thickness.StackGap}"
                                 IsIndeterminate="True"
                                 Style="{StaticResource Progress.Thin}"
                                 Visibility="{Binding IsPreviewLoading, Converter={StaticResource BoolToVisibility}}" />

                    <Grid Visibility="{Binding ShowPreviewUnits, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0"
                                 Margin="{StaticResource Thickness.InlineGapXL}"
                                 AutomationProperties.Name="{Binding SectionListName}"
                                 Height="{StaticResource Size.UnitListHeight}"
                                 ItemsSource="{Binding PreviewUnits}"
                                 SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                                 Style="{StaticResource UnitPreview.List}"
                                 b:FocusRouter.Key="UnitList">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:UnitPreviewItemViewModel}">
                                    <Grid MinHeight="{StaticResource Size.RowAction}" Margin="{StaticResource Thickness.ListItemPadding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="{StaticResource FontSize.MonoSmall}"
                                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                                   Text="{Binding Ordinal}" />
                                        <Border Grid.Column="1"
                                                Margin="{StaticResource Thickness.InlineGapLarge}"
                                                Style="{StaticResource KindChip.Surface}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource KindChip.Glyph}" />
                                                <TextBlock VerticalAlignment="Center"
                                                           FontFamily="{StaticResource Font.Body}"
                                                           FontSize="{StaticResource FontSize.Caption}"
                                                           Text="{Binding KindLabel}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Label}"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   ToolTip="{Binding Title}" />
                                        <TextBlock Grid.Column="3"
                                                   Margin="{StaticResource Thickness.LeadingGap}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="{StaticResource FontSize.MonoSmall}"
                                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                                   Text="{Binding TokenCount, StringFormat={}{0:N0}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Column="1"
                                Height="{StaticResource Size.UnitListHeight}"
                                Background="{DynamicResource Brush.Surface.Sunken}"
                                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                BorderThickness="{StaticResource Thickness.Border}"
                                CornerRadius="{StaticResource Radius.Control}">
                            <Grid>
                                <DockPanel Visibility="{Binding SelectedUnit, Converter={StaticResource NotNullToVisibility}}">
                                    <Border Padding="{StaticResource Thickness.HeaderPadding}"
                                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                            BorderThickness="{StaticResource Thickness.BottomBorder}"
                                            DataContext="{Binding SelectedUnit}"
                                            DockPanel.Dock="Top">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Margin="{StaticResource Thickness.InlineGapLarge}"
                                                    Style="{StaticResource KindChip.Surface}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource KindChip.Glyph}" />
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontFamily="{StaticResource Font.Body}"
                                                               FontSize="{StaticResource FontSize.Caption}"
                                                               Text="{Binding KindLabel}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource Text.Label}"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       ToolTip="{Binding Title}" />
                                            <TextBlock Grid.Column="2"
                                                       Margin="{StaticResource Thickness.LeadingGap}"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource Text.Caption}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N0} {1}">
                                                        <Binding Path="TokenCount" />
                                                        <Binding Source="{x:Static res:ExtractionStrings.TokensSuffix}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <TextBox AutomationProperties.Name="{Binding SectionDetailName}"
                                             IsReadOnly="True"
                                             IsReadOnlyCaretVisible="True"
                                             Style="{StaticResource TextBox.Code}"
                                             Text="{Binding SelectedUnitText, Mode=OneWay}"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" />
                                </DockPanel>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Text.Helper}"
                                           Text="{x:Static res:ExtractionStrings.SelectSectionHint}"
                                           Visibility="{Binding ShowSectionHint, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="{StaticResource Thickness.SectionTop}"
                    Style="{StaticResource Card}"
                    Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <ContentControl Content="{Binding SkipBanner}" Focusable="False" IsTabStop="False" />
                    <ListBox AutomationProperties.Name="{x:Static res:ExtractionStrings.SkipListName}"
                             ItemsSource="{Binding SkipRowsView}"
                             MaxHeight="{StaticResource Size.SkipListMaxHeight}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource SkipList}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.ScrollUnit="Item"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DocumentRowViewModel}">
                                <StackPanel>
                                    <Grid MinHeight="{StaticResource Size.RowMin}" Margin="{StaticResource Thickness.RowPadding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Margin="{StaticResource Thickness.InlineGapLarge}"
                                                AutomationProperties.Name="{Binding StatusLabel}"
                                                Style="{StaticResource StatusBadge.Surface}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource StatusBadge.Glyph}" />
                                                <TextBlock VerticalAlignment="Center"
                                                           FontFamily="{StaticResource Font.Body}"
                                                           FontSize="{StaticResource FontSize.Caption}"
                                                           Text="{Binding StatusLabel}" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Filename}" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding SkipReasonText}" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Width="{StaticResource Size.RowAction}"
                                                Height="{StaticResource Size.RowAction}"
                                                AutomationProperties.Name="{Binding RemoveAutomationName}"
                                                Command="{Binding DataContext.RemoveDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{x:Static res:Glyphs.Close}"
                                                Style="{StaticResource Button.Icon}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

        </StackPanel>
    </StackPanel>
</UserControl>
