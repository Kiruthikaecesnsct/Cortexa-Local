<UserControl x:Class="Collector.Presentation.Views.AiKeyRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Collector.Presentation.Behaviors"
             xmlns:res="clr-namespace:Collector.Presentation.Resources"
             xmlns:vm="clr-namespace:Collector.Presentation.ViewModels"
             b:FocusRouter.IsHost="True"
             Focusable="False"
             IsTabStop="False">
    <UserControl.Resources>
        <Style x:Key="Chip.Surface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}" />
            <Setter Property="Padding" Value="{StaticResource Thickness.ChipPadding}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="{StaticResource Thickness.InlineGap}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Body}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ChipKind}" Value="{x:Static vm:KeyChipKind.Set}">
                    <Setter Property="Background" Value="{DynamicResource Brush.Success.Surface}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ChipKind}" Value="{x:Static vm:KeyChipKind.NoKeyNeeded}">
                    <Setter Property="Background" Value="{DynamicResource Brush.Info.Surface}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ChipKind}" Value="{x:Static vm:KeyChipKind.Unknown}">
                    <Setter Property="Background" Value="{DynamicResource Brush.Warning.Surface}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Chip.Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.IconSmall}" />
            <Setter Property="Margin" Value="{StaticResource Thickness.InlineGap}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ChipKind}" Value="{x:Static vm:KeyChipKind.Set}">
                    <Setter Property="Text" Value="{x:Static res:Glyphs.Success}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ChipKind}" Value="{x:Static vm:KeyChipKind.NoKeyNeeded}">
                    <Setter Property="Text" Value="{x:Static res:Glyphs.Info}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ChipKind}" Value="{x:Static vm:KeyChipKind.Unknown}">
                    <Setter Property="Text" Value="{x:Static res:Glyphs.Warning}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Row.Actions" TargetType="WrapPanel">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsRailCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="Margin" Value="{StaticResource Thickness.HelperGap}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource Divider}"
                Visibility="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource NotZeroToVisibility}}" />
        <Grid MinHeight="{StaticResource Size.RowMin}" Margin="{StaticResource Thickness.RowPadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Name}" />
                <TextBlock Style="{StaticResource Text.Helper}" Text="{Binding Description}" />
                <TextBlock Style="{StaticResource Text.Helper}"
                           Text="{Binding Hint}"
                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource Text.Helper}"
                           Text="{Binding StatusHelper}"
                           Visibility="{Binding ShowStatusHelper, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Margin="{StaticResource Thickness.HelperGap}"
                            Orientation="Horizontal"
                            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="{StaticResource Thickness.InlineGap}"
                               Foreground="{DynamicResource Brush.Success}"
                               Style="{StaticResource Text.Glyph}"
                               Text="{x:Static res:Glyphs.Success}" />
                    <TextBlock Foreground="{DynamicResource Brush.Success}"
                               Style="{StaticResource Text.Caption}"
                               Text="{Binding Message}" />
                </StackPanel>
                <StackPanel Margin="{StaticResource Thickness.HelperGap}"
                            Orientation="Horizontal"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="{StaticResource Thickness.InlineGap}"
                               Style="{StaticResource Text.Glyph.Error}"
                               Text="{x:Static res:Glyphs.Error}" />
                    <TextBlock Style="{StaticResource Text.Error}" Text="{Binding ErrorMessage}" />
                </StackPanel>
            </StackPanel>
            <WrapPanel Style="{StaticResource Row.Actions}">
                <Border AutomationProperties.Name="{Binding ChipAutomationName}" Style="{StaticResource Chip.Surface}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Chip.Glyph}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Body}"
                                   FontSize="{StaticResource FontSize.Caption}"
                                   Text="{Binding ChipText}" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding ShowActions, Converter={StaticResource BoolToVisibility}}">
                    <Button MinHeight="{StaticResource Size.RowAction}"
                            Margin="{StaticResource Thickness.InlineGap}"
                            AutomationProperties.Name="{Binding ActionAutomationName}"
                            Command="{Binding OpenEditorCommand}"
                            Content="{Binding ActionLabel}"
                            Style="{StaticResource Button.Secondary}"
                            b:FocusRouter.Key="Primary" />
                    <Button MinHeight="{StaticResource Size.RowAction}"
                            AutomationProperties.Name="{Binding ClearAutomationName}"
                            Command="{Binding BeginClearCommand}"
                            Content="{x:Static res:SettingsStrings.Clear}"
                            Style="{StaticResource Button.Link}"
                            Visibility="{Binding HasKey, Converter={StaticResource BoolToVisibility}}"
                            b:FocusRouter.Key="Clear" />
                </StackPanel>
            </WrapPanel>
        </Grid>
        <StackPanel Visibility="{Binding IsConfirmingClear, Converter={StaticResource BoolToVisibility}}">
            <StackPanel.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding KeepKeyCommand}" />
            </StackPanel.InputBindings>
            <TextBlock Margin="{StaticResource Thickness.StackGap}"
                       Style="{StaticResource Text.Body}"
                       Text="{Binding ConfirmText}" />
            <StackPanel Margin="{StaticResource Thickness.StackGap}" Orientation="Horizontal">
                <Button MinHeight="{StaticResource Size.RowAction}"
                        Margin="{StaticResource Thickness.InlineGap}"
                        AutomationProperties.Name="{Binding ConfirmAutomationName}"
                        Command="{Binding ConfirmClearCommand}"
                        Content="{Binding ConfirmLabel}"
                        IsEnabled="{Binding IsConfirmEnabled}"
                        Style="{StaticResource Button.Danger}"
                        b:FocusRouter.Key="ConfirmClear" />
                <Button MinHeight="{StaticResource Size.RowAction}"
                        AutomationProperties.Name="{Binding KeepAutomationName}"
                        Command="{Binding KeepKeyCommand}"
                        Content="{Binding KeepLabel}"
                        IsEnabled="{Binding IsConfirmEnabled}"
                        Style="{StaticResource Button.Secondary}"
                        b:FocusRouter.Key="Keep" />
            </StackPanel>
        </StackPanel>
        <ContentControl Content="{Binding Editor}" Focusable="False" IsTabStop="False" />
    </StackPanel>
</UserControl>
