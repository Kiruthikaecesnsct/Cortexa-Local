<UserControl x:Class="Collector.Presentation.Views.CandidateProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Collector.Presentation.Behaviors"
             xmlns:res="clr-namespace:Collector.Presentation.Resources"
             Focusable="False"
             IsTabStop="False"
             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
    <Border Margin="{StaticResource Thickness.StackGap}"
            AutomationProperties.Name="{x:Static res:CandidateStrings.ProgressName}"
            Style="{StaticResource Card}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Margin="{StaticResource Thickness.StackGap}"
                               Style="{StaticResource Text.Label}"
                               Text="{x:Static res:CandidateStrings.ProgressTitle}" />
                    <ProgressBar Margin="{StaticResource Thickness.StackGap}"
                                 AutomationProperties.Name="{Binding StageCaption}"
                                 IsIndeterminate="False"
                                 Maximum="{Binding Maximum, Mode=OneWay}"
                                 Style="{StaticResource Progress.Thin}"
                                 Value="{Binding OverallFraction, Mode=OneWay}" />
                    <TextBlock AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource Text.Caption}"
                               Text="{Binding StageCaption}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Margin="{StaticResource Thickness.LeadingGap}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static res:CandidateStrings.CancelName}"
                        Command="{Binding CancelCommand}"
                        Content="{x:Static res:ExtractionStrings.Cancel}"
                        Style="{StaticResource Button.Secondary}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                        b:FocusRouter.Key="CandidateCancel" />
            </Grid>
            <ContentControl Content="{Binding RunBanner}" Style="{StaticResource Banner.Slot}" />
            <ContentControl Content="{Binding TooLargeBanner}" Style="{StaticResource Banner.Slot}" />
        </StackPanel>
    </Border>
</UserControl>
