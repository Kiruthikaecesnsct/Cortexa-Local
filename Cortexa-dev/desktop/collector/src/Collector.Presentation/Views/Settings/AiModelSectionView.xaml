<UserControl x:Class="Collector.Presentation.Views.SettingsSections.AiModelSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Collector.Presentation.Behaviors"
             xmlns:res="clr-namespace:Collector.Presentation.Resources"
             xmlns:sections="clr-namespace:Collector.Presentation.Views.SettingsSections"
             xmlns:vm="clr-namespace:Collector.Presentation.ViewModels"
             b:FocusRouter.IsHost="True"
             Focusable="False"
             IsTabStop="False">
    <UserControl.Resources>
        <Style x:Key="Banner.Slot.Top" TargetType="ContentControl" BasedOn="{StaticResource Banner.Slot}">
            <Setter Property="Margin" Value="{StaticResource Thickness.ActionTop}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Margin" Value="{StaticResource Thickness.None}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}">
        <StackPanel>
            <sections:SectionHeader Glyph="{x:Static res:Glyphs.Lightbulb}"
                                    Intro="{x:Static res:SettingsStrings.AiModelIntro}"
                                    Title="{x:Static res:SettingsStrings.AiModelTitle}" />

            <TextBlock Margin="{StaticResource Thickness.StackGap}"
                       Style="{StaticResource Text.Overline}"
                       Text="{x:Static res:SettingsStrings.ProviderOverline}" />
            <Grid Margin="{StaticResource Thickness.StackGapMedium}">
                <ItemsControl Margin="{StaticResource Thickness.GridBleed.Repo}"
                              AutomationProperties.Name="{x:Static res:SettingsStrings.ProviderGroupName}"
                              Focusable="False"
                              IsTabStop="False"
                              ItemsSource="{Binding Cards}"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              KeyboardNavigation.TabNavigation="Once">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Columns.ProviderCards}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProviderCardViewModel}">
                            <RadioButton AutomationProperties.HelpText="{Binding Description}"
                                         AutomationProperties.Name="{Binding AutomationName}"
                                         GroupName="AiProvider"
                                         IsChecked="{Binding IsSelected}"
                                         Style="{StaticResource ProviderCard}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <HeaderedContentControl Header="{x:Static res:SettingsStrings.ModelLabel}"
                                    Style="{StaticResource FormField}"
                                    b:FieldState.Error="{Binding ModelsError}"
                                    b:FieldState.Helper="{Binding ModelFieldHelper}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MaxWidth="{StaticResource Size.ModelComboMax}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox MinWidth="{StaticResource Size.ComboMin}"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.HelpText="{Binding ModelHelper}"
                              AutomationProperties.Name="{x:Static res:SettingsStrings.ModelName}"
                              IsEnabled="{Binding HasModels}"
                              ItemsSource="{Binding Models}"
                              SelectedItem="{Binding SelectedModel}"
                              Style="{StaticResource ComboBox.Mono}"
                              b:FocusRouter.Key="Model" />
                    <StackPanel Grid.Column="1"
                                Margin="{StaticResource Thickness.LeadingGap}"
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite"
                                Orientation="Horizontal"
                                Visibility="{Binding HasSaved, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Margin="{StaticResource Thickness.InlineGap}"
                                   Foreground="{DynamicResource Brush.Success}"
                                   Style="{StaticResource Text.Glyph}"
                                   Text="{x:Static res:Glyphs.Success}" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Success}"
                                   Style="{StaticResource Text.Caption}"
                                   Text="{Binding SavedMessage}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </HeaderedContentControl>

            <ContentControl Content="{Binding SaveBanner}" Style="{StaticResource Banner.Slot.Top}" />
            <ContentControl Content="{Binding ReadinessBanner}" Style="{StaticResource Banner.Slot.Top}" />
        </StackPanel>
    </Border>
</UserControl>
