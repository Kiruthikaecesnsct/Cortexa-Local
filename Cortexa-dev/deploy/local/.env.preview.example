# Cortexa local preview - environment template.
#
# Copy this file to .env.preview (gitignored) and fill in the cloud-placed
# values below. Postgres, Cosmos DB, Blob Storage, and Service Bus all run
# locally via emulators/containers and need nothing here beyond ACCEPT_EULA -
# their credentials are the emulators' well-known defaults, wired automatically
# by deploy/local/services.yaml and preview.sh / preview.ps1.
#
# preview.ps1 / preview.sh doctor lists every missing or empty key by name.

# ─────────────────────────────────────────────────────────────────────────
# Required - Service Bus / SQL Server Linux EULA consent
# ─────────────────────────────────────────────────────────────────────────
# Accepting is an explicit choice, never defaulted to "Y" in a committed file.
# Service Bus emulator EULA: https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
# SQL Server Linux EULA:     https://go.microsoft.com/fwlink/?LinkId=746388
ACCEPT_EULA=N

# ─────────────────────────────────────────────────────────────────────────
# Required - cloud-placed dependencies (fail closed if left blank)
# ─────────────────────────────────────────────────────────────────────────

# Gemini API key - model-router's primary LLM provider (no local equivalent
# for an LLM exists). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Qdrant Cloud - vector-router's vector backend (VECTOR_BACKEND=qdrant).
# Create a free cluster at https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Optional - cloud-placed, safe to leave blank
# ─────────────────────────────────────────────────────────────────────────

# Sentry - every service treats an empty DSN as "disabled". Leave blank
# unless you want local errors reported to a real Sentry project.
SENTRY_DSN=

# model-router's secondary LLM providers (Router:Mode=single-gemini by
# default, so these are not on the primary path). Uncomment to test them.
# MODEL_ROUTER_FOUNDRY_API_KEY=
# MODEL_ROUTER_ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Optional overrides - local defaults already baked into
# deploy/docker-compose.yml via ${VAR:-default}. Uncomment only to change
# them; the stack works unedited without touching this section.
# ─────────────────────────────────────────────────────────────────────────
# POSTGRES_USER=cortexa
# POSTGRES_PASSWORD=cortexa-preview-local
# POSTGRES_DB=cortexa
# JWT_SIGNING_KEY=dev-symmetric-key-min-256-bits-long-shared-with-identity-service-for-local-development-only
# INTERNAL_SHARED_SECRET=dev-internal-shared-secret-min-32-characters-long-local-only
# MSSQL_SA_PASSWORD=CortexaPreview!Local2026
