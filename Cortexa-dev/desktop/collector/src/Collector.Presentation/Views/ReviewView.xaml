<UserControl x:Class="Collector.Presentation.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Collector.Presentation.Behaviors"
             xmlns:res="clr-namespace:Collector.Presentation.Resources"
             xmlns:vm="clr-namespace:Collector.Presentation.ViewModels"
             b:FocusRouter.IsHost="True"
             Focusable="False"
             IsTabStop="False">
    <UserControl.Resources>
        <Style x:Key="Row.Text.Base" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnSelected}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnSelected}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Row.Title" TargetType="TextBlock" BasedOn="{StaticResource Row.Text.Base}" />
        <Style x:Key="Row.Body" TargetType="TextBlock" BasedOn="{StaticResource Row.Text.Base}">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="{StaticResource Size.SummaryLineHeight}" />
            <Setter Property="MaxHeight" Value="{StaticResource Size.SummaryMaxHeight}" />
        </Style>
        <Style x:Key="Row.Caption" TargetType="TextBlock" BasedOn="{StaticResource Row.Text.Base}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        </Style>
        <Style x:Key="Row.Source" TargetType="TextBlock" BasedOn="{StaticResource Row.Caption}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFileSource}" Value="True">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnSelected}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnSelected}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextBox.Readonly" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{StaticResource Thickness.None}" />
            <Setter Property="Padding" Value="{StaticResource Thickness.None}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Review.Row" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding HelpText}" />
            <Setter Property="b:CommandBehaviors.SpaceCommand" Value="{Binding ToggleCommand}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="{StaticResource Thickness.None}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Highlight" Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Review.List" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{StaticResource Thickness.None}" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource Review.Row}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="Header.Surface" TargetType="Border">
            <Setter Property="MinHeight" Value="{StaticResource Size.RowAction}" />
            <Setter Property="Padding" Value="{StaticResource Thickness.HeaderPadding}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:DocumentHeaderRowViewModel}">
            <Border Style="{StaticResource Header.Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              Command="{Binding ToggleCommand}"
                              Focusable="False"
                              IsChecked="{Binding CheckState, Mode=OneWay}"
                              IsEnabled="{Binding CanToggle}"
                              IsTabStop="False"
                              IsThreeState="True"
                              Style="{StaticResource CheckBox.Default}" />
                    <TextBlock Grid.Column="1"
                               Margin="{StaticResource Thickness.InlineGap}"
                               Style="{StaticResource Text.Glyph}"
                               Text="{x:Static res:Glyphs.Document}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Row.Title}" Text="{Binding Filename}" />
                        <TextBlock Style="{StaticResource Row.Caption}" Text="{Binding SourcePath}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3"
                               Margin="{StaticResource Thickness.InlineGapLarge}"
                               VerticalAlignment="Center"
                               Style="{StaticResource Row.Caption}"
                               Text="{Binding CountText}" />
                    <Border Grid.Column="4"
                            Style="{StaticResource Tag.Surface.Danger}"
                            Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Tag.Glyph}" Text="{x:Static res:Glyphs.Error}" />
                            <TextBlock Style="{StaticResource Tag.Label}" Text="{x:Static res:ReviewStrings.TagBlocked}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:KnowledgeItemRowViewModel}">
            <Border MinHeight="{StaticResource Size.RowMin}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="{StaticResource Thickness.BottomBorder}"
                    Padding="{StaticResource Thickness.ItemPadding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              VerticalAlignment="Top"
                              Focusable="False"
                              IsChecked="{Binding IsIncluded}"
                              IsEnabled="{Binding CanToggle}"
                              IsTabStop="False"
                              Style="{StaticResource CheckBox.Default}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Margin="{StaticResource Thickness.LabelPadding}" Orientation="Horizontal">
                            <Border Margin="{StaticResource Thickness.InlineGap}" Style="{StaticResource Tag.Surface}">
                                <TextBlock Style="{StaticResource Tag.Label}" Text="{Binding KindLabel}" />
                            </Border>
                            <Border Style="{StaticResource Tag.Surface.Warning}" Visibility="{Binding IsEcho, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Tag.Glyph}" Text="{x:Static res:Glyphs.Warning}" />
                                    <TextBlock Style="{StaticResource Tag.Label}" Text="{x:Static res:ReviewStrings.TagEcho}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Row.Title}" Text="{Binding Title}" />
                        <TextBlock Style="{StaticResource Row.Body}" Text="{Binding Summary}" />
                        <TextBlock Style="{StaticResource Row.Source}" Text="{Binding SourceLine}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid MaxWidth="{StaticResource Size.WorkspaceMaxWidth}" HorizontalAlignment="Left">

        <Border Style="{StaticResource Card}" Visibility="{Binding ShowEmptyCard, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Margin="{StaticResource Thickness.StackGap}"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource Font.Icon}"
                           FontSize="40"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           Text="{x:Static res:Glyphs.Lightbulb}" />
                <TextBlock Margin="{StaticResource Thickness.StackGap}"
                           HorizontalAlignment="Center"
                           AutomationProperties.HeadingLevel="Level2"
                           Style="{StaticResource Text.Subtitle}"
                           Text="{Binding EmptyTitle}" />
                <TextBlock Margin="{StaticResource Thickness.StackGapLarge}"
                           HorizontalAlignment="Center"
                           Style="{StaticResource Text.Body}"
                           Text="{Binding EmptyBody}"
                           TextAlignment="Center" />
                <Button HorizontalAlignment="Center"
                        AutomationProperties.Name="{x:Static res:ReviewStrings.GoToExtract}"
                        Command="{Binding GoToExtractCommand}"
                        Content="{x:Static res:ReviewStrings.GoToExtract}"
                        Style="{StaticResource Button.Secondary}"
                        b:FocusRouter.Key="GoToExtract" />
            </StackPanel>
        </Border>

        <Grid Visibility="{Binding ShowReady, Converter={StaticResource BoolToVisibility}}">
            <Grid.Height>
                <MultiBinding Converter="{StaticResource ViewportFit}">
                    <Binding Path="ViewportHeight" RelativeSource="{RelativeSource AncestorType=ScrollViewer}" />
                    <Binding Path="Content.Padding" RelativeSource="{RelativeSource AncestorType=ScrollViewer}" />
                </MultiBinding>
            </Grid.Height>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <ContentControl Content="{Binding UploadBanner}" Style="{StaticResource Banner.Slot}" />
                <ContentControl Content="{Binding RunBanner}" Style="{StaticResource Banner.Slot}" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="{StaticResource Thickness.StackGap}"
                    Style="{StaticResource Card}"
                    Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <StackPanel Margin="{StaticResource Thickness.StackGap}" Orientation="Horizontal">
                        <TextBlock Margin="{StaticResource Thickness.InlineGapLarge}"
                                   Style="{StaticResource Text.Glyph.Header}"
                                   Text="{x:Static res:Glyphs.Upload}" />
                        <TextBlock AutomationProperties.HeadingLevel="Level2"
                                   Style="{StaticResource Text.Subtitle}"
                                   Text="{x:Static res:ReviewStrings.ResultsTitle}" />
                    </StackPanel>
                    <ItemsControl Focusable="False" IsTabStop="False" ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BatchResultRowViewModel}">
                                <Grid MinHeight="{StaticResource Size.RowAction}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Margin="{StaticResource Thickness.InlineGapLarge}"
                                            Style="{StaticResource Tag.Surface.Success}"
                                            Visibility="{Binding IsUploaded, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Tag.Glyph}" Text="{x:Static res:Glyphs.Success}" />
                                            <TextBlock Style="{StaticResource Tag.Label}" Text="{x:Static res:ReviewStrings.TagUploaded}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="0"
                                            Margin="{StaticResource Thickness.InlineGapLarge}"
                                            Style="{StaticResource Tag.Surface.Danger}"
                                            Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Tag.Glyph}" Text="{x:Static res:Glyphs.Error}" />
                                            <TextBlock Style="{StaticResource Tag.Label}" Text="{x:Static res:ReviewStrings.TagFailed}" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Line}" />
                                        <TextBlock Style="{StaticResource Text.Error}"
                                                   Text="{Binding ErrorText}"
                                                   Visibility="{Binding ErrorText, Converter={StaticResource NotEmptyToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Visibility="{Binding HasBatchId, Converter={StaticResource BoolToVisibility}}">
                                        <TextBox Margin="{StaticResource Thickness.InlineGap}"
                                                 VerticalAlignment="Center"
                                                 AutomationProperties.Name="{Binding IdName}"
                                                 Style="{StaticResource TextBox.Readonly}"
                                                 Text="{Binding BatchId, Mode=OneWay}" />
                                        <Button AutomationProperties.Name="{Binding CopyName}"
                                                Command="{Binding CopyCommand}"
                                                Content="{x:Static res:Glyphs.Copy}"
                                                Style="{StaticResource Button.Icon}"
                                                ToolTip="{Binding CopyName}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Margin="{StaticResource Thickness.SectionTop}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="{x:Static res:ReviewStrings.RetryFailed}"
                            Command="{Binding RetryFailedCommand}"
                            Content="{x:Static res:ReviewStrings.RetryFailed}"
                            Style="{StaticResource Button.Secondary}"
                            Visibility="{Binding ShowRetry, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2"
                       Margin="{StaticResource Thickness.StackGap}"
                       Style="{StaticResource Text.Caption}"
                       Text="{Binding RunCaption}" />

            <Border Grid.Row="3"
                    Margin="{StaticResource Thickness.StackGap}"
                    Padding="{StaticResource Thickness.ControlPadding}"
                    Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl Grid.Column="0"
                                  AutomationProperties.Name="{x:Static res:ReviewStrings.FilterGroupName}"
                                  Focusable="False"
                                  IsTabStop="False"
                                  ItemsSource="{Binding Filters}"
                                  KeyboardNavigation.DirectionalNavigation="Contained"
                                  KeyboardNavigation.TabNavigation="Once">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:KindFilterViewModel}">
                                <RadioButton AutomationProperties.Name="{Binding AutomationName}"
                                             Content="{Binding Label}"
                                             GroupName="KindFilter"
                                             IsChecked="{Binding IsSelected}"
                                             Style="{StaticResource FilterChip}"
                                             b:FocusRouter.Key="Filters" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button AutomationProperties.Name="{x:Static res:ReviewStrings.IncludeAllName}"
                                Command="{Binding IncludeAllCommand}"
                                Content="{x:Static res:ReviewStrings.IncludeAll}"
                                Style="{StaticResource Button.Link}" />
                        <Button AutomationProperties.Name="{x:Static res:ReviewStrings.ExcludeAllName}"
                                Command="{Binding ExcludeAllCommand}"
                                Content="{x:Static res:ReviewStrings.ExcludeAll}"
                                Style="{StaticResource Button.Link}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="{StaticResource Thickness.StackGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="{StaticResource Size.ListMinWidth}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="{StaticResource Thickness.None}" Style="{StaticResource Card}">
                    <ListBox AutomationProperties.Name="{x:Static res:ReviewStrings.ListName}"
                             ItemsSource="{Binding VisibleRows}"
                             SelectedItem="{Binding SelectedRow}"
                             Style="{StaticResource Review.List}" />
                </Border>
                <Border Grid.Column="1" Width="{StaticResource Space.XL}" />
                <Border Grid.Column="2" Width="{StaticResource Size.DetailsPane}" Style="{StaticResource Card}">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowDetailsPlaceholder, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Margin="{StaticResource Thickness.StackGap}"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource Font.Icon}"
                                       FontSize="28"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       Text="{x:Static res:Glyphs.Lightbulb}" />
                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource Text.Helper}"
                                       Text="{x:Static res:ReviewStrings.DetailsPlaceholder}"
                                       TextAlignment="Center" />
                        </StackPanel>
                        <ScrollViewer AutomationProperties.Name="{x:Static res:ReviewStrings.DetailsName}"
                                      Focusable="True"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel DataContext="{Binding SelectedItem}">
                                <TextBlock Margin="{StaticResource Thickness.StackGap}"
                                           Style="{StaticResource Text.Caption}"
                                           Text="{Binding DocumentName}" />
                                <StackPanel Margin="{StaticResource Thickness.StackGap}" Orientation="Horizontal">
                                    <Border Margin="{StaticResource Thickness.InlineGap}" Style="{StaticResource Tag.Surface}">
                                        <TextBlock Style="{StaticResource Tag.Label}" Text="{Binding KindLabel}" />
                                    </Border>
                                    <Border Style="{StaticResource Tag.Surface.Warning}" Visibility="{Binding IsEcho, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Tag.Glyph}" Text="{x:Static res:Glyphs.Warning}" />
                                            <TextBlock Style="{StaticResource Tag.Label}" Text="{x:Static res:ReviewStrings.TagEcho}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="{StaticResource Thickness.StackGap}"
                                           AutomationProperties.HeadingLevel="Level2"
                                           Style="{StaticResource Text.Subtitle}"
                                           Text="{Binding Title}" />
                                <CheckBox Margin="{StaticResource Thickness.StackGap}"
                                          Content="{x:Static res:ReviewStrings.IncludeInUpload}"
                                          IsChecked="{Binding IsIncluded}"
                                          IsEnabled="{Binding CanToggle}"
                                          Style="{StaticResource CheckBox.Default}" />
                                <Border Margin="{StaticResource Thickness.StackGap}"
                                        Padding="{StaticResource Thickness.ControlPadding}"
                                        Background="{DynamicResource Brush.Warning.Surface}"
                                        BorderBrush="{DynamicResource Brush.Warning}"
                                        BorderThickness="{StaticResource Thickness.Border}"
                                        CornerRadius="{StaticResource Radius.Control}"
                                        Visibility="{Binding IsEcho, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="{StaticResource Thickness.InlineGap}"
                                                   VerticalAlignment="Top"
                                                   Foreground="{DynamicResource Brush.Warning}"
                                                   Style="{StaticResource Text.Glyph}"
                                                   Text="{x:Static res:Glyphs.Warning}" />
                                        <StackPanel MaxWidth="240">
                                            <TextBlock Style="{StaticResource Text.Label}" Text="{x:Static res:ReviewStrings.EchoTitle}" />
                                            <TextBlock Style="{StaticResource Text.Body}"
                                                       Text="{Binding EchoReasonText}"
                                                       Visibility="{Binding EchoReasonText, Converter={StaticResource NotEmptyToVisibility}}" />
                                            <TextBlock Style="{StaticResource Text.Helper}" Text="{x:Static res:ReviewStrings.EchoHelp}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Text.Label}" Text="{x:Static res:ReviewStrings.LabelSummary}" />
                                <TextBlock Margin="{StaticResource Thickness.StackGap}" Style="{StaticResource Text.Body}" Text="{Binding Summary}" />
                                <StackPanel Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="{x:Static res:ReviewStrings.LabelDetails}" />
                                    <TextBlock Margin="{StaticResource Thickness.StackGap}" Style="{StaticResource Text.Body}" Text="{Binding Details}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Text.Label}" Text="{x:Static res:ReviewStrings.LabelSource}" />
                                <TextBlock Margin="{StaticResource Thickness.StackGap}"
                                           Style="{StaticResource Text.Body}"
                                           Text="{Binding SourceLine}" />
                                <StackPanel Visibility="{Binding HasExcerpt, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="{x:Static res:ReviewStrings.LabelExcerpt}" />
                                    <Border Margin="{StaticResource Thickness.HelperGap}"
                                            Padding="{StaticResource Thickness.ControlPadding}"
                                            Background="{DynamicResource Brush.Surface.Sunken}"
                                            CornerRadius="{StaticResource Radius.Control}">
                                        <TextBox AutomationProperties.Name="{x:Static res:ReviewStrings.LabelExcerpt}"
                                                 Style="{StaticResource TextBox.Readonly}"
                                                 Text="{Binding Excerpt, Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="5"
                    Padding="{StaticResource Thickness.FooterPadding}"
                    Style="{StaticResource Card}">
                <StackPanel>
                    <ProgressBar Margin="{StaticResource Thickness.StackGap}"
                                 AutomationProperties.Name="{Binding UploadProgressText}"
                                 Style="{StaticResource Progress.Thin}"
                                 Visibility="{Binding ShowUploadProgress, Converter={StaticResource BoolToVisibility}}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource Text.Label}"
                                       Text="{Binding CountLine}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasBlocked, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Margin="{StaticResource Thickness.InlineGap}"
                                           VerticalAlignment="Top"
                                           Style="{StaticResource Text.Glyph.Error}"
                                           Text="{x:Static res:Glyphs.Error}" />
                                <TextBlock Style="{StaticResource Text.Error}" Text="{Binding BlockedLine}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Text="{x:Static res:ReviewStrings.NothingIncluded}"
                                       Visibility="{Binding ShowNothingIncluded, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource Text.Helper}"
                                       Text="{x:Static res:ReviewStrings.SelectionLocked}"
                                       Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Text="{Binding UploadProgressText}"
                                       Visibility="{Binding ShowUploadProgress, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                MinWidth="{StaticResource Size.ActionMinWidth}"
                                Margin="{StaticResource Thickness.InlineGapLarge}"
                                AutomationProperties.Name="{Binding UploadLabel}"
                                Command="{Binding UploadCommand}"
                                Content="{Binding UploadLabel}"
                                Style="{StaticResource Button.Primary}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
