{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cosmos": {
    "Database": "cortexa-pipeline",
    "DocumentsContainer": "documents",
    "ChunksContainer": "chunks",
    "ProvenanceMapsContainer": "provenance_maps",
    "BatchesContainer": "batches",
    "ConfigContainer": "config",
    "ConnectionMode": "Direct",
    "LimitToEndpoint": false,
    "MaxConcurrentWrites": 8
  },
  "Messaging": {
    "Provider": "RabbitMq",
    "Topics": {
      "IngestionCompleted": "ingestion-completed"
    },
    "RabbitMq": {
      "ClientName": "cortexa-collector-server"
    }
  },
  "Upload": {
    "Engine": "dual",
    "MaxRequestBytes": 10485760,
    "MaxDocuments": 50,
    "MaxItemsPerDocument": 500,
    "MaxBatchNameLength": 200,
    "MaxTitleLength": 300,
    "MaxSummaryLength": 2000,
    "MaxDetailsLength": 8000,
    "MaxIdempotencyKeyLength": 128,
    "ModelDefaults": {
      "ExtractionModel": "gpt-5.5",
      "PrimaryEvidenceModel": "gpt-5.4",
      "ScoringModel": "gpt-5.5",
      "SeedingModel": "gpt-5.5",
      "SeedingMode": "legacy"
    }
  },
  "Identity": {
    "Issuer": "cortexa-identity-dev",
    "Audience": "cortexa-dev",
    "BaseUrl": "http://localhost:5081",
    "InternalKeyHeaderName": "X-Internal-Key",
    "StatusCacheSeconds": 5,
    "ClockSkewSeconds": 30,
    "StatusTimeoutSeconds": 5
  }
}
