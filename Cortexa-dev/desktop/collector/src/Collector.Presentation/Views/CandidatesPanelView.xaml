<UserControl x:Class="Collector.Presentation.Views.CandidatesPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Collector.Presentation.Behaviors"
             xmlns:res="clr-namespace:Collector.Presentation.Resources"
             xmlns:vm="clr-namespace:Collector.Presentation.ViewModels"
             Focusable="False"
             IsTabStop="False"
             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
    <UserControl.Resources>
        <Style x:Key="Candidate.Section" TargetType="StackPanel">
            <Setter Property="Margin" Value="{StaticResource Thickness.StackGap}" />
        </Style>

        <DataTemplate DataType="{x:Type vm:CandidateItemViewModel}">
            <Border MinHeight="{StaticResource Size.RowMin}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="{StaticResource Thickness.BottomBorder}"
                    Padding="{StaticResource Thickness.ItemPadding}">
                <StackPanel>
                    <Border Margin="{StaticResource Thickness.LabelPadding}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource Tag.Surface.Warning}"
                            Visibility="{Binding IsUnverified, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Tag.Glyph}" Text="{x:Static res:Glyphs.Warning}" />
                            <TextBlock Style="{StaticResource Tag.Label}" Text="{x:Static res:CandidateStrings.TagUnverified}" />
                        </StackPanel>
                    </Border>
                    <TextBlock AutomationProperties.HeadingLevel="Level3"
                               Style="{StaticResource Row.Title}"
                               Text="{Binding Title}" />
                    <TextBlock Margin="{StaticResource Thickness.StackGap}"
                               Style="{StaticResource Row.Body}"
                               Text="{Binding Summary}" />
                    <StackPanel Style="{StaticResource Candidate.Section}">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{x:Static res:CandidateStrings.LabelWhy}" />
                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding PatentabilityRationale}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Candidate.Section}">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{x:Static res:CandidateStrings.LabelSource}" />
                        <TextBlock Style="{StaticResource Row.Source}" Text="{Binding SourceFile}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Candidate.Section}"
                                Visibility="{Binding HasExcerpt, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{x:Static res:CandidateStrings.LabelExcerpt}" />
                        <Border Margin="{StaticResource Thickness.HelperGap}"
                                Padding="{StaticResource Thickness.ControlPadding}"
                                Background="{DynamicResource Brush.Surface.Sunken}"
                                CornerRadius="{StaticResource Radius.Control}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body}"
                                           Text="{Binding Quote}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasQuote, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Text="{Binding RangeText}"
                                           Visibility="{Binding HasRange, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="{StaticResource Thickness.HelperGap}"
                                   Style="{StaticResource Text.Helper}"
                                   Text="{x:Static res:CandidateStrings.UnverifiedHelp}"
                                   Visibility="{Binding IsUnverified, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Margin="{StaticResource Thickness.SectionTop}" Style="{StaticResource Card}">
        <StackPanel>
            <StackPanel Margin="{StaticResource Thickness.StackGapMedium}" Orientation="Horizontal">
                <ContentControl Margin="{StaticResource Thickness.InlineGapLarge}"
                                Content="{x:Static res:Glyphs.Lightbulb}"
                                Style="{StaticResource IconTile}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock AutomationProperties.HeadingLevel="Level2"
                               Style="{StaticResource Text.Subtitle}"
                               Text="{x:Static res:CandidateStrings.PanelTitle}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding CountText}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:CandidateStrings.PanelCaption}" />
                </StackPanel>
            </StackPanel>
            <ContentControl Content="{Binding RunBanner}" Style="{StaticResource Banner.Slot}" />
            <ContentControl Content="{Binding TooLargeBanner}" Style="{StaticResource Banner.Slot}" />
            <StackPanel HorizontalAlignment="Center" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
                <ContentControl Content="{x:Static res:Glyphs.Lightbulb}" Style="{StaticResource EmptyIcon.Small}" />
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource Text.Helper}"
                           Text="{x:Static res:CandidateStrings.EmptyText}"
                           TextAlignment="Center" />
            </StackPanel>
            <ListBox AutomationProperties.Name="{x:Static res:CandidateStrings.PanelTitle}"
                     ItemsSource="{Binding Items}"
                     Style="{StaticResource List.Master}"
                     Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}"
                     b:FocusRouter.Key="CandidateList" />
        </StackPanel>
    </Border>
</UserControl>
