{
  "Gateway": {
    "BaseUrl": "http://localhost:5080"
  },
  "Extraction": {
    "MaxParallelSplits": 4
  },
  "History": {
    "PollSeconds": 5,
    "TextEditorPath": "notepad.exe"
  },
  "Cache": {
    "DatabasePath": "%LOCALAPPDATA%/Cortexa/Collector/cache.db"
  },
  "Auth": {
    "RefreshSkewSeconds": 60,
    "MinRefreshDelaySeconds": 5,
    "HttpTimeoutSeconds": 30
  },
  "Ai": {
    "Provider": "Gemini",
    "Claude": {
      "Model": "claude-sonnet-5-5",
      "MaxOutputTokens": 8192,
      "Effort": "medium",
      "Thinking": "between_tools",
      "Concurrency": 4,
      "MaxRetries": 1,
      "TimeoutSeconds": 120
    },
    "Gemini": {
      "Model": "gemini-3.6-flash",
      "MaxInputTokens": 1000000,
      "MaxOutputTokens": 8192,
      "Thinking": "low",
      "Concurrency": 4,
      "MaxRetries": 1,
      "TimeoutSeconds": 120,
      "FallbackModels": [ "gemini-3.1-flash-lite", "gemini-flash-latest", "gemini-3.5-flash-lite", "gemini-flash-lite-latest" ],
      "MaxQuotaRetryDelaySeconds": 60
    },
    "Bedrock": {
      "SsoStartUrl": "https://example.awsapps.com/start",
      "SsoRegion": "us-east-1",
      "AccountId": "000000000000",
      "SsoRoleName": "CollectorBedrockAccess",
      "Region": "us-east-1",
      "Model": "us.anthropic.claude-sonnet-4-5-20250929-v1:0",
      "MaxOutputTokens": 8192,
      "Concurrency": 4,
      "MaxRetries": 1,
      "TimeoutSeconds": 120
    },
    "Groq": {
      "Model": "openai/gpt-oss-120b",
      "BaseUrl": "https://api.groq.com/openai/v1",
      "MaxOutputTokens": 8192,
      "Concurrency": 4,
      "MaxRetries": 1,
      "TimeoutSeconds": 120
    }
  },
  "RemoteSources": {
    "TimeoutSeconds": 20,
    "MaxPages": 50,
    "CacheRoot": "%LOCALAPPDATA%/Cortexa/Collector/remote",
    "GitHub": {
      "BaseUrl": "https://api.github.com",
      "ApiVersion": "2026-03-10",
      "MinRemaining": 50,
      "AuthBaseUrl": "https://github.com",
      "OAuthClientId": "Ov23li0IjSQGcgD0ShYG",
      "OAuthScopes": "repo read:org",
      "AppClientId": "Iv23liHhGiXkoNmQ6UOt",
      "TokenRefreshSkewSeconds": 300
    },
    "AzureDevOps": {
      "BaseUrl": "https://dev.azure.com",
      "ApiVersion": "7.1",
      "MinRemaining": 10,
      "MaxRateLimitRetries": 10,
      "EntraClientId": "e7db318d-ab9b-4647-8e0a-44e1e3b4debc",
      "EntraAuthority": "https://login.microsoftonline.com/ce6b40b4-42e6-488c-8f56-ffb603c43c66",
      "EntraRedirectUri": "http://localhost",
      "EntraScope": "499b84ac-1321-427f-aa17-267ca6975798/.default"
    },
    "Cortexa": {
      "GitHubClonesPath": "scan/github/clones",
      "AzureDevOpsClonesPath": "scan/azure-devops/clones",
      "DownloadTimeoutSeconds": 600,
      "ArchiveFolder": "_zips"
    },
    "Fetch": {
      "MaxSelectedFiles": 10000
    },
    "RateLimit": {
      "MaxPauseSeconds": 900,
      "MaxRetries": 3,
      "SecondaryWaitSeconds": 60,
      "MaxConcurrency": 4
    }
  },
  "Secrets": {
    "TargetPrefix": "Cortexa.Collector"
  },
  "UserSettings": {
    "Path": "%LOCALAPPDATA%/Cortexa/Collector/usersettings.json"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%LOCALAPPDATA%/Cortexa/Collector/logs/collector-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
