{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "NamePrefix": "",
    "InternalDomain": ""
  },
  "KeyVault": {
    "Uri": "",
    "JwtSigningKeySecretName": "jwt-signing-key"
  },
  "Cors": {
    "AllowedOrigins": ["*"]
  },
  "Jwt": {
    "Issuer": "cortexa-identity-dev",
    "Audience": "cortexa-dev"
  },
  "UserStatus": {
    "IdentityInternalBaseUrl": "",
    "InternalKeyHeaderName": "X-Internal-Key",
    "InternalKeySecretName": "internal-api-key",
    "CacheTtlSeconds": 5,
    "RequestTimeoutSeconds": 3
  },
  "ReverseProxy": {
    "Routes": {
      "auth-health": {
        "ClusterId": "identity",
        "Order": -1,
        "Match": {
          "Path": "/auth/health"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ],
        "Metadata": {
          "AllowAnonymous": "true"
        }
      },
      "ingestion-health": {
        "ClusterId": "ingestion",
        "Order": -1,
        "Match": {
          "Path": "/ingestion/health"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ],
        "Metadata": {
          "AllowAnonymous": "true"
        }
      },
      "extraction-health": {
        "ClusterId": "extraction",
        "Order": -1,
        "Match": {
          "Path": "/extraction/health"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ],
        "Metadata": {
          "AllowAnonymous": "true"
        }
      },
      "evidence-health": {
        "ClusterId": "evidence",
        "Order": -1,
        "Match": {
          "Path": "/evidence/health"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ],
        "Metadata": {
          "AllowAnonymous": "true"
        }
      },
      "scoring-health": {
        "ClusterId": "scoring",
        "Order": -1,
        "Match": {
          "Path": "/scoring/health"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ],
        "Metadata": {
          "AllowAnonymous": "true"
        }
      },
      "harvesting-health": {
        "ClusterId": "harvesting",
        "Order": -1,
        "Match": {
          "Path": "/harvesting/health"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ],
        "Metadata": {
          "AllowAnonymous": "true"
        }
      },
      "seeding-health": {
        "ClusterId": "seeding",
        "Order": -1,
        "Match": {
          "Path": "/seeding/health"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ],
        "Metadata": {
          "AllowAnonymous": "true"
        }
      },
      "orchestrator-health": {
        "ClusterId": "job-orchestrator",
        "Order": -1,
        "Match": {
          "Path": "/orchestrator/health"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ],
        "Metadata": {
          "AllowAnonymous": "true"
        }
      },
      "model-health": {
        "ClusterId": "model-router",
        "Order": -1,
        "Match": {
          "Path": "/model/health"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ],
        "Metadata": {
          "AllowAnonymous": "true"
        }
      },
      "vector-health": {
        "ClusterId": "vector-router",
        "Order": -1,
        "Match": {
          "Path": "/vector/health"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ],
        "Metadata": {
          "AllowAnonymous": "true"
        }
      },
      "auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Metadata": {
          "AllowAnonymous": "true"
        }
      },
      "ingestion": {
        "ClusterId": "ingestion",
        "Match": {
          "Path": "/ingestion/{**catch-all}"
        },
        "Metadata": {
          "RequiredPermission": "documents:write"
        }
      },
      "extraction": {
        "ClusterId": "extraction",
        "Match": {
          "Path": "/extraction/{**catch-all}"
        },
        "Metadata": {
          "RequiredPermission": "documents:read"
        }
      },
      "evidence": {
        "ClusterId": "evidence",
        "Match": {
          "Path": "/evidence/{**catch-all}"
        },
        "Metadata": {
          "RequiredPermission": "documents:read"
        }
      },
      "scoring": {
        "ClusterId": "scoring",
        "Match": {
          "Path": "/scoring/{**catch-all}"
        },
        "Metadata": {
          "RequiredPermission": "reports:read"
        }
      },
      "harvesting": {
        "ClusterId": "harvesting",
        "Match": {
          "Path": "/harvesting/{**catch-all}"
        },
        "Metadata": {
          "RequiredPermission": "reports:read"
        }
      },
      "seeding": {
        "ClusterId": "seeding",
        "Match": {
          "Path": "/seeding/{**catch-all}"
        },
        "Metadata": {
          "RequiredPermission": "reports:read"
        }
      },
      "orchestrator": {
        "ClusterId": "job-orchestrator",
        "Match": {
          "Path": "/orchestrator/{**catch-all}"
        },
        "Metadata": {
          "RequiredPermission": "jobs:read"
        }
      },
      "documents": {
        "ClusterId": "job-orchestrator",
        "Match": {
          "Path": "/documents/{**catch-all}"
        },
        "Metadata": {
          "RequiredPermission": "reports:read"
        }
      },
      "batches": {
        "ClusterId": "job-orchestrator",
        "Match": {
          "Path": "/batches/{**catch-all}"
        },
        "Metadata": {
          "RequiredPermission": "jobs:submit"
        }
      },
      "config-get": {
        "ClusterId": "job-orchestrator",
        "Match": {
          "Path": "/config",
          "Methods": ["GET"]
        },
        "Metadata": {
          "RequireAuthenticatedOnly": "true"
        }
      },
      "config-put": {
        "ClusterId": "job-orchestrator",
        "Match": {
          "Path": "/config",
          "Methods": ["PUT"]
        },
        "Metadata": {
          "RequiredPermission": "admin:config:write"
        }
      },
      "patent-config-get": {
        "ClusterId": "job-orchestrator",
        "Match": {
          "Path": "/patent-config",
          "Methods": ["GET"]
        },
        "Metadata": {
          "RequiredPermission": "admin:config:write"
        }
      },
      "patent-config-put": {
        "ClusterId": "job-orchestrator",
        "Match": {
          "Path": "/patent-config",
          "Methods": ["PUT"]
        },
        "Metadata": {
          "RequiredPermission": "admin:config:write"
        }
      },
      "patent-config-secrets": {
        "ClusterId": "job-orchestrator",
        "Match": {
          "Path": "/patent-config/secrets/{**catch-all}",
          "Methods": ["POST"]
        },
        "Metadata": {
          "RequiredPermission": "admin:config:write"
        }
      },
      "model": {
        "ClusterId": "model-router",
        "Match": {
          "Path": "/model/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/model"
          }
        ],
        "Metadata": {
          "RequiredPermission": "jobs:read"
        }
      },
      "vector": {
        "ClusterId": "vector-router",
        "Match": {
          "Path": "/vector/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/vector"
          }
        ],
        "Metadata": {
          "RequiredPermission": "documents:read"
        }
      },
      "admin": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/admin/{**catch-all}"
        },
        "Metadata": {
          "RequiredPermission": "admin:users:read"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": ""
          }
        }
      },
      "ingestion": {
        "Destinations": {
          "d1": {
            "Address": ""
          }
        }
      },
      "extraction": {
        "Destinations": {
          "d1": {
            "Address": ""
          }
        }
      },
      "evidence": {
        "Destinations": {
          "d1": {
            "Address": ""
          }
        }
      },
      "scoring": {
        "Destinations": {
          "d1": {
            "Address": ""
          }
        }
      },
      "harvesting": {
        "Destinations": {
          "d1": {
            "Address": ""
          }
        }
      },
      "seeding": {
        "Destinations": {
          "d1": {
            "Address": ""
          }
        }
      },
      "job-orchestrator": {
        "Destinations": {
          "d1": {
            "Address": ""
          }
        }
      },
      "model-router": {
        "Destinations": {
          "d1": {
            "Address": ""
          }
        }
      },
      "vector-router": {
        "Destinations": {
          "d1": {
            "Address": ""
          }
        }
      }
    }
  }
}
