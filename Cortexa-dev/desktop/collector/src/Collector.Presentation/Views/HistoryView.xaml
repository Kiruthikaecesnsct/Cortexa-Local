<UserControl x:Class="Collector.Presentation.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Collector.Presentation.Behaviors"
             xmlns:res="clr-namespace:Collector.Presentation.Resources"
             xmlns:vm="clr-namespace:Collector.Presentation.ViewModels"
             b:FocusRouter.IsHost="True"
             Focusable="False"
             IsTabStop="False">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!-- One summary tile: big number over a caption. -->
        <Style x:Key="History.StatNumber" TargetType="TextBlock" BasedOn="{StaticResource Text.Kpi}" />

        <!-- A candidate inside a document card. -->
        <DataTemplate DataType="{x:Type vm:HistoryCandidateLine}">
            <Border Margin="0,0,0,10"
                    Padding="16"
                    Background="{DynamicResource Brush.Surface.Sunken}"
                    CornerRadius="{StaticResource Radius.Tile}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28"
                            Height="28"
                            Margin="0,0,14,0"
                            VerticalAlignment="Top"
                            Background="{DynamicResource Brush.Accent.Subtle}"
                            BorderBrush="{DynamicResource Brush.Accent.SubtleBorder}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   Text="{Binding Number}" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource Text.Body}"
                                   Text="{Binding Summary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0"
                                   Style="{StaticResource Text.Overline}"
                                   Text="{x:Static res:HistoryStrings.WhyPatentable}" />
                        <TextBlock Margin="0,2,0,0"
                                   Style="{StaticResource Text.Body}"
                                   Text="{Binding Rationale}"
                                   TextWrapping="Wrap" />
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasQuote, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Text.Overline}" Text="{x:Static res:HistoryStrings.SourceExcerpt}" />
                            <Border Margin="0,4,0,0"
                                    Padding="12,8"
                                    Background="{DynamicResource Brush.Surface.Card}"
                                    BorderBrush="{DynamicResource Brush.Accent}"
                                    BorderThickness="3,0,0,0">
                                <TextBlock FontStyle="Italic"
                                           Style="{StaticResource Text.Caption}"
                                           Text="{Binding Quote}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A processed document. -->
        <DataTemplate DataType="{x:Type vm:HistoryDocumentRowViewModel}">
            <Border Margin="0,0,0,16" Padding="24" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Margin="0,0,16,0"
                                        VerticalAlignment="Top"
                                        Content="{x:Static res:Glyphs.Document}"
                                        Style="{StaticResource IconTile}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock AutomationProperties.HeadingLevel="Level2"
                                       Style="{StaticResource Text.Subtitle}"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}" />
                            <TextBlock Margin="0,2,0,0"
                                       Style="{StaticResource Text.Caption}"
                                       Text="{Binding ProcessedText}" />
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Top">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Tag.Surface.Success}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Danger.Surface}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Border}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0"
                                           Style="{StaticResource Tag.Glyph}"
                                           Text="{Binding StatusGlyph}" />
                                <TextBlock Style="{StaticResource Tag.Label}" Text="{Binding StatusText}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <WrapPanel Margin="0,16,0,0">
                        <Border Margin="0,0,8,8" Style="{StaticResource Tag.Surface}">
                            <TextBlock Style="{StaticResource Tag.Label}" Text="{Binding SourceTypeText}" />
                        </Border>
                        <Border Margin="0,0,8,8" Style="{StaticResource Tag.Surface}">
                            <TextBlock Style="{StaticResource Tag.Label}" Text="{Binding SizeText}" />
                        </Border>
                        <Border Margin="0,0,8,8" Style="{StaticResource Tag.Surface.Info}">
                            <TextBlock Style="{StaticResource Tag.Label}" Text="{Binding CandidateCountText}" />
                        </Border>
                    </WrapPanel>

                    <Border Padding="12,8"
                            Background="{DynamicResource Brush.Surface.Sunken}"
                            CornerRadius="{StaticResource Radius.Control}">
                        <TextBlock FontFamily="{StaticResource Font.Mono}"
                                   FontSize="{StaticResource FontSize.MonoSmall}"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   Text="{Binding SourceText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SourceText}" />
                    </Border>

                    <Border Margin="0,16,0,0"
                            Padding="16"
                            Background="{DynamicResource Brush.Danger.Surface}"
                            BorderBrush="{DynamicResource Brush.Danger.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Tile}"
                            Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush.Danger}"
                                           Style="{StaticResource Text.Overline}"
                                           Text="{x:Static res:HistoryStrings.WhyFailed}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource Brush.Danger.Text}"
                                           Style="{StaticResource Text.Body}"
                                           Text="{Binding FailureText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    MinWidth="{StaticResource Size.ActionMinWidth}"
                                    MinHeight="{StaticResource Size.RowAction}"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding RetryName}"
                                    Command="{Binding RetryCommand}"
                                    Content="{Binding RetryLabel}"
                                    Style="{StaticResource Button.Primary}" />
                        </Grid>
                    </Border>

                    <StackPanel Margin="0,20,0,0" Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Font.Icon}"
                                           Foreground="{DynamicResource Brush.Accent}"
                                           Text="{x:Static res:Glyphs.Lightbulb}" />
                                <TextBlock AutomationProperties.HeadingLevel="Level3"
                                           Style="{StaticResource Text.Label}"
                                           Text="{x:Static res:HistoryStrings.CandidatesHeading}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    AutomationProperties.Name="{Binding ToggleName}"
                                    Command="{Binding ToggleCandidatesCommand}"
                                    Style="{StaticResource Button.Ghost}"
                                    ToolTip="{Binding ToggleName}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding ToggleName}" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="{StaticResource Font.Icon}"
                                               Text="{Binding ToggleGlyph}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ItemsControl Focusable="False"
                                      IsTabStop="False"
                                      ItemsSource="{Binding Candidates}"
                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16" Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel VerticalAlignment="Center">
                <Border Margin="0,0,12,0" Style="{StaticResource Kpi.Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource History.StatNumber}" Text="{Binding TotalCount}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:HistoryStrings.StatDocuments}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,0" Style="{StaticResource Kpi.Tile}">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource Brush.Success}"
                                   Style="{StaticResource History.StatNumber}"
                                   Text="{Binding SucceededCount}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:HistoryStrings.StatProcessed}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,0" Style="{StaticResource Kpi.Tile}">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource Brush.Danger}"
                                   Style="{StaticResource History.StatNumber}"
                                   Text="{Binding FailedCount}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:HistoryStrings.StatFailed}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,0" Style="{StaticResource Kpi.Tile}">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource Brush.Accent}"
                                   Style="{StaticResource History.StatNumber}"
                                   Text="{Binding CandidateTotal}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:HistoryStrings.StatCandidates}" />
                    </StackPanel>
                </Border>
            </WrapPanel>
            <Button Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static res:HistoryStrings.Refresh}"
                    b:FocusRouter.Key="Refresh"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource Button.Secondary}"
                    ToolTip="{x:Static res:HistoryStrings.RefreshTip}">
                <TextBlock VerticalAlignment="Center" Text="{x:Static res:HistoryStrings.RefreshLabel}" />
            </Button>
        </Grid>

        <ContentControl Grid.Row="1" Content="{Binding Banner}" Style="{StaticResource Banner.Slot}" />

        <StackPanel Grid.Row="2">
            <ProgressBar Margin="0,0,0,12"
                         AutomationProperties.Name="{x:Static res:HistoryStrings.Loading}"
                         IsIndeterminate="{Binding IsLoading}"
                         Style="{StaticResource Progress.Thin}"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock AutomationProperties.LiveSetting="Polite"
                       Style="{StaticResource Text.Caption}"
                       Text="{Binding StageAnnouncement}" />
        </StackPanel>

        <Grid Grid.Row="3">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
                <ContentControl Content="{x:Static res:Glyphs.History}" Style="{StaticResource EmptyIcon}" />
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource Text.Subtitle}"
                           Text="{x:Static res:HistoryStrings.DocumentsEmptyTitle}" />
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource Text.Body}"
                           Text="{x:Static res:HistoryStrings.DocumentsEmptyBody}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding GoToReviewCommand}"
                        Content="{x:Static res:HistoryStrings.GoToReview}"
                        Style="{StaticResource Button.Secondary}" />
            </StackPanel>
            <ScrollViewer Focusable="False"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl AutomationProperties.Name="{x:Static res:HistoryStrings.DocumentsName}"
                              Focusable="False"
                              IsTabStop="False"
                              ItemsSource="{Binding Documents}" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
