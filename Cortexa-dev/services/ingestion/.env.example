SERVICE_NAME=ingestion
PORT=8000

# Key Vault
KEYVAULT_URI=
# Set LOCAL_DEV=true only in local development; required when KEYVAULT_URI is empty.
LOCAL_DEV=false
GITHUB_TOKEN_SECRET_NAME=github-pat
AZDO_PAT_SECRET_NAME=azdo-pat

# Clone limits
CLONE_MAX_REPO_BYTES=524288000
CLONE_TIMEOUT_SECONDS=120
CLONE_MAX_CONCURRENCY=4
CLONE_WORKDIR=/tmp/cortexa-clones
CLONE_USE_SSH=false

# Chunking
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
CHUNK_ENCODING=cl100k_base

# Cosmos DB
COSMOS_URI=
COSMOS_DATABASE=cortexa-pipeline
DOCUMENTS_CONTAINER=documents
CHUNKS_CONTAINER=chunks
PROVENANCE_CONTAINER=provenance_maps

# Blob storage
BLOB_ACCOUNT_URL=
BLOB_RAW_CONTAINER=raw-files
RAW_FILE_MAX_BYTES=104857600

# Service Bus
SERVICEBUS_NAMESPACE_FQDN=
INGESTION_COMPLETED_TOPIC=ingestion.completed
INGESTION_REQUESTED_TOPIC=ingestion.requested
INGESTION_SUBSCRIPTION=ingestion
SERVICEBUS_SESSIONS_ENABLED=true
CONSUMER_MAX_ATTEMPTS=5

# Cloned-repository storage (S3-compatible; MinIO locally). Leave S3_ENDPOINT_URL empty to disable.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_CLONE_BUCKET=cortexa
CLONE_LIST_LIMIT=100
